{
  "_comment": "package.json — Astro 7 SSG con contenido Markdown/MDX validado en build. @astrojs/mdx debe permanecer alineado con la versión instalada de Astro y registrado en astro.config.mjs. CSS canónico = vanilla + tokens :root (C1).",
  "name": "equiposcontraincendio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-demo.mjs && node scripts/check-content-references.mjs && astro check && astro build",
    "postbuild": "node scripts/audit-meta.mjs && node scripts/audit-schema.mjs && node scripts/audit-csp.mjs && node scripts/audit-links.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier eslint.config.js playwright.config.ts prettier.config.js e2e --write",
    "format:all": "prettier . --write",
    "format:check": "prettier eslint.config.js playwright.config.ts prettier.config.js e2e --check",
    "images:variants": "node scripts/make-variants.mjs",
    "check:variants": "node scripts/check-variants.mjs",
    "check:references": "node scripts/check-content-references.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "audit:meta": "node scripts/audit-meta.mjs",
    "audit:schema": "node scripts/audit-schema.mjs",
    "audit:csp": "node scripts/audit-csp.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "astro": "astro",
    "check:demo": "node scripts/check-demo.mjs",
    "check:parity": "node scripts/text-parity.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.73.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
