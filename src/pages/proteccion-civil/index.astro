---
// ============================================================================
// /proteccion-civil/ — Hub de trámites por entidad (L2).
// ----------------------------------------------------------------------------
// HOMOLOGADA con /productos y /servicios: Hero → SectionMenu → SectionHeading +
// tarjetas CategoryCard → SectionMenu de cierre.
//
// Data-driven desde la colección `tramites`, donde `sources` y `verifiedAt` son
// obligatorios. Arranca por entidad (CDMX y Estado de México); las
// demarcaciones se suman por lotes conforme se verifique cada fuente.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import { getCollection } from 'astro:content'
import { waUrl, WA_MESSAGES, sectionMenuItems } from '@config/site'

const tramites = (await getCollection('tramites', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
)
const fmt = (d: Date) =>
  d.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })

const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Tengo una visita encima',
  href: waUrl(WA_MESSAGES.urgente),
  sub: 'Atención el mismo día',
  external: true,
}

const cierreItems = [
  { label: 'Herramientas', href: '/herramientas/', sub: 'Clasifica tu riesgo' },
  { label: 'Formatos descargables', href: '/plantillas/', sub: 'Bitácora, acta y censo' },
  { label: 'Gestión documental', href: '/servicios/gestion-documental/', sub: 'Expediente ordenado' },
  { label: 'Cobertura', href: '/cobertura/', sub: 'CDMX y Estado de México' },
]
const cierreCta = {
  label: 'Pedir diagnóstico',
  href: waUrl('Hola, tengo un requerimiento de Protección Civil y necesito poner mi inmueble en regla.'),
  sub: 'Respuesta inmediata',
  external: true,
}

const schemaData = {
  list: {
    name: 'Trámites de Protección Civil por entidad',
    description:
      'Qué exige Protección Civil en la Ciudad de México y en el Estado de México: autoridad, a quién aplica, requisitos y fundamento, con la fuente oficial de cada dato.',
    path: '/proteccion-civil/',
    items: tramites.map((t) => ({
      name: t.data.title,
      path: `/proteccion-civil/${t.id}/`,
      ...(t.data.image ? { image: t.data.image } : {}),
      description: t.data.description,
    })),
  },
}
---

<PageLayout
  title="Protección Civil: qué exige en CDMX y Edoméx"
  description="Qué pide Protección Civil a una empresa en la Ciudad de México y en el Estado de México: autoridad, a quién aplica, requisitos, plazos y fundamento, con la fuente oficial de cada dato."
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Protección Civil' }]}
  guia={false}
>
  <Hero
    badge="Guía de trámite · con fuente oficial"
    title="Qué te exige Protección Civil,"
    accent="según dónde estés"
    subtitle="La pregunta con la que empieza casi todo cliente es la misma: «me pidieron el programa de protección civil, ¿y ahora qué?»."
    descRight={[
      'Reunimos, por entidad, quién recibe el trámite, a quién aplica, qué se entrega y en qué se fundamenta — citando siempre de dónde salió el dato y en qué fecha lo verificamos.',
      'Publicamos sólo lo confirmado en la fuente oficial. Lo que no, aparece marcado como pendiente con el enlace para consultarlo directo. No damos por hecho un requisito.',
    ]}
    ctas={[
      { text: 'Clasificar mi riesgo', href: '/herramientas/riesgo-de-incendio/', variant: 'outline' },
      { text: 'Hablar por WhatsApp', href: waUrl(WA_MESSAGES.urgente), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Por entidad"
        title="Ciudad de México y"
        titleAccent="Estado de México"
        desc="Las dos entidades donde damos servicio."
        body={[
          'Cada ficha resume el trámite estatal y enlaza a la cédula oficial. Empezamos por las dos entidades que atendemos; las demarcaciones se suman conforme podamos verificar la fuente de cada una.',
          'Si tu inmueble ya tiene el requerimiento encima, lo urgente no es el papel: es que el inmueble aguante la revisión.',
        ]}
      />

      <div class="grid">
        {tramites.map((t, i) => (
          <CategoryCard
            label={t.data.label}
            href={`/proteccion-civil/${t.id}/`}
            image={t.data.image}
            imageAlt={t.data.imageAlt}
            badge={`Verificado el ${fmt(t.data.verifiedAt)}`}
            blurb={t.data.description}
            ctaLabel="Requisitos del trámite"
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <SectionMenu items={cierreItems} cta={cierreCta} ariaLabel="Sigue explorando el sitio" />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); margin-top: var(--sp-6); }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
