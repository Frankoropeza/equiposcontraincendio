---
// ============================================================================
// /proteccion-civil/ — Hub de trámites por entidad (L2).
// ----------------------------------------------------------------------------
// AL PATRÓN L2 (2026-09-10), igual que el resto de secciones:
//   Hero → SectionMenu → directorio por giro → fichas por entidad → módulos
//   CategoryFeature → RiskGuide → NormsTable → ProcessSteps → CompanyAbout →
//   RelatedLinks → FAQ + Contacto
// El SectionMenu de cierre lo sustituye RelatedLinks, como en las demás L2.
//
// Data-driven desde la colección `tramites`, donde `sources` y `verifiedAt` son
// obligatorios. Arranca por entidad (CDMX y Estado de México); las
// demarcaciones se suman por lotes conforme se verifique cada fuente.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import CategoryFeature from '@components/CategoryFeature.astro'
import RiskGuide from '@components/RiskGuide.astro'
import NormsTable from '@components/NormsTable.astro'
import ProcessSteps from '@components/ProcessSteps.astro'
import CompanyAbout from '@components/CompanyAbout.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import GiroDirectory from '@components/GiroDirectory.astro'
import { getCollection } from 'astro:content'
import { CONTACT, waUrl, sectionMenuItems } from '@config/site'
import {
  pcFeatures,
  pcComparativa,
  pcNormRows,
  pcSteps,
  pcCompany,
  pcRelated,
  pcFaqs,
  pcRequerimientoMsg,
} from '@data/proteccion-civil'
import { cierreProteccionCivil, faltanParaCuatro } from '@data/cierre'

const tramites = (await getCollection('tramites', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
)
const giros = await getCollection('giros', ({ data }) => !data.draft)
const fmt = (d: Date) =>
  d.toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })

const menuSecciones = [{ label: 'Por giro', href: '#por-giro', sub: 'Requisitos por negocio' }, ...sectionMenuItems()]
const menuCta = {
  label: 'Tengo un requerimiento',
  href: waUrl(pcRequerimientoMsg),
  sub: 'Qué atender primero',
  external: true,
}


const schemaData = {
  list: {
    name: 'Trámites de Protección Civil por entidad',
    description:
      'Qué exige Protección Civil en la Ciudad de México y en el Estado de México: autoridad, a quién aplica, requisitos y fundamento, con la fuente oficial de cada dato.',
    path: '/proteccion-civil/',
    items: tramites.map((t) => ({
      name: t.data.title,
      path: `/proteccion-civil/${t.id}/`,
      ...(t.data.image ? { image: t.data.image } : {}),
      description: t.data.description,
    })),
  },
  faqs: pcFaqs,
}
---

<PageLayout
  title="Trámite y permiso de Protección Civil en CDMX y Edomex"
  description="Cómo tramitar el permiso de Protección Civil de tu negocio en CDMX y Edomex: Programa Interno, visto bueno y dictamen, con fuente oficial y requisitos por giro."
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Protección Civil' }]}
  guia={false}
>
  <Hero
    badge="Guía de trámite · con fuente oficial"
    title="Trámite de Protección Civil"
    accent={"en\u00a0CDMX\u00a0y\u00a0Edomex"}
    subtitle="Qué exige Protección Civil a tu negocio en la Ciudad de México y el Estado de México, por entidad y por giro, con la fuente oficial de cada requisito."
    descRight={[
      'Reunimos, por entidad, cómo tramitar el permiso de Protección Civil de tu negocio: quién recibe el trámite, a quién aplica, qué se entrega y en qué se fundamenta — citando siempre de dónde salió el dato y en qué fecha lo verificamos.',
      'Publicamos solo lo confirmado en la fuente oficial. Lo que no, aparece marcado como pendiente con el enlace para consultarlo directo. No damos por hecho un requisito.',
    ]}
    ctas={[
      { text: 'Clasificar mi riesgo', href: '/herramientas/riesgo-de-incendio/', variant: 'outline' },
      { text: 'Revisar mi requerimiento', href: waUrl(pcRequerimientoMsg), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />


  <GiroDirectory {giros} />

  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Por entidad"
        title="Requisitos de Protección Civil por entidad:"
        titleAccent="Ciudad de México y Estado de México"
        desc="Las dos entidades donde damos servicio."
        body={[
          'Cada ficha resume el trámite estatal y enlaza a la cédula oficial. Empezamos por las dos entidades que atendemos; las demarcaciones se suman conforme podamos verificar la fuente de cada una.',
          'Si el requerimiento ya llegó, la prioridad es que el inmueble cumpla en la visita de inspección; el expediente se integra en paralelo.',
        ]}
      />

      <div class="card-grid">
        {tramites.map((t, i) => (
          <CategoryCard
            label={t.data.label}
            href={`/proteccion-civil/${t.id}/`}
            image={t.data.image}
            imageAlt={t.data.imageAlt}
            badge={`Verificado el ${fmt(t.data.verifiedAt)}`}
            blurb={t.data.cardDescription ?? t.data.description}
            ctaLabel="Requisitos del trámite"
            index={i}
          />
        ))}
        {cierreProteccionCivil.slice(0, faltanParaCuatro(tramites.length)).map((ficha, i) => (
          <CategoryCard
            label={ficha.title}
            href={ficha.whatsapp ? waUrl(ficha.href) : ficha.href}
            image={ficha.image}
            imageAlt={ficha.imageAlt}
            badge={ficha.badge}
            blurb={ficha.description}
            ctaLabel={ficha.ctaLabel}
            index={tramites.length + i}
            external={ficha.whatsapp}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Módulos por entidad (CategoryFeature) ─── */}
  {pcFeatures.map(({ id, ctaSecondaryMsg, ...feature }) => (
    <CategoryFeature
      {...feature}
      anchorId={id}
      ctaSecondaryLabel="Cotizar por WhatsApp"
      ctaSecondaryHref={waUrl(ctaSecondaryMsg)}
      ctaSecondaryExternal
    />
  ))}

  {/* ─── Comparativa entidad por entidad ─── */}
  <RiskGuide
    eyebrow="Lado a lado"
    title="Permiso de Protección Civil: la misma obligación,"
    titleAccent="dos trámites distintos"
    desc="Quién lo recibe, a quién aplica, cómo se presenta y qué obtienes."
    body={[
      'Un inmueble idéntico se tramita distinto según la entidad: en la Ciudad de México todo pasa por una plataforma digital y por un responsable registrado; en el Estado de México el trámite es presencial y tiene plazo publicado.',
      'Donde la fuente oficial no publica el dato, la celda lo dice. Preferimos ese hueco a rellenarlo con una suposición razonable que después te cueste tiempo.',
    ]}
    rows={pcComparativa}
    columns={['', 'Ciudad de México', 'Estado de México', 'A tener en cuenta']}
    note="Datos tomados de la cédula oficial de cada trámite y de los portales de la autoridad, verificados el 9 de septiembre de 2026. Cada ficha enlaza a su fuente; los requisitos municipales o de alcaldía se revisan caso por caso."
    ctaLabel="Clasificar mi riesgo"
    ctaHref="/herramientas/riesgo-de-incendio/"
  />

  {/* ─── En qué se apoya cada cosa ─── */}
  <NormsTable
    eyebrow="Fundamento"
    title="Fundamento en materia de Protección Civil:"
    titleAccent="qué obliga y dónde está escrito"
    desc="La norma federal es una; el instrumento local, otro."
    body={[
      'Una confusión frecuente y costosa: cumplir la NOM-002 no es tener el programa en regla, y tener el programa no exime de la NOM. Son obligaciones distintas, con autoridades distintas.',
      'Aquí está qué establece cada ordenamiento y a cuál de las dos entidades aplica.',
    ]}
    rows={pcNormRows}
    columns={['Norma u ordenamiento', 'Qué establece', 'Dónde aplica']}
    note="El padrón de responsables oficiales de protección civil de la CDMX es público: sirve para comprobar que quien firma tu programa está realmente registrado, igual que la etiqueta sirve para comprobar el servicio de un extintor."
  />

  {/* ─── Qué hacer cuando llega el requerimiento (fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Ya te lo pidieron"
    title="Empieza por el inmueble,"
    titleAccent="no por la carpeta de Protección Civil"
    desc="Un programa bien redactado no salva a un inmueble que no cumple."
    body={[
      'El orden importa: el programa describe el inmueble, así que si los extintores están vencidos o las rutas bloqueadas, el documento solo deja por escrito lo que está mal.',
      'Estos son los pasos que seguimos con cualquier cliente que recibe un requerimiento de la autoridad.',
    ]}
    steps={pcSteps}
  />

  {/* ─── Qué hacemos y qué no ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Sobre esta sección"
        title="Publicamos lo confirmado"
        titleAccent="y marcamos lo demás"
        desc="Con la fuente enlazada y la fecha en que se verificó."
        body={[
          'Estos trámites cambian y un dato correcto envejece sin avisar. Por eso cada ficha lleva su fecha y su enlace: para que puedas comprobarlo tú mismo.',
          'Si ya recibiste un requerimiento, envíanos el documento y revisamos qué corresponde atender primero.',
        ]}
      />
      <CompanyAbout
        que={pcCompany.que}
        como={pcCompany.como}
        cta={{ label: 'Tengo un requerimiento', href: waUrl(pcRequerimientoMsg), external: true }}
      />
    </div>
  </section>

  {/* ─── Interlinking a las otras secciones ─── */}
  <RelatedLinks
    title="Sigue por aquí"
    desc="Lo que hace falta para llegar al trámite con el inmueble listo."
    links={pcRelated}
    limit={4}
  />

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={pcFaqs} waNumber={CONTACT.whatsapp} />
</PageLayout>

<style>
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }

  .section {
    padding: var(--sp-8) 0;
  }

  .section--surface {
    background: var(--c-surface);
  }

  @media (min-width: 768px) {
    .section {
      padding: var(--sp-10) 0;
    }
  }
</style>
