---
// ============================================================================
// /proteccion-civil/<entidad>/ — Ficha de trámite homologada al patrón L2/L3.
// ----------------------------------------------------------------------------
// Los requisitos, fundamentos, pendientes y fuentes salen de la colección
// `tramites`; la plantilla solo ordena los datos y conserva sus enlaces.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import TrustBar from '@components/TrustBar.astro'
import SectionHeading from '@components/SectionHeading.astro'
import DataTable from '@components/DataTable.astro'
import QuoteCard from '@components/QuoteCard.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import { getCollection, render } from 'astro:content'
import { CONTACT, sectionMenuItems, telUrl, waUrl } from '@config/site'
import { pcPillars } from '@data/proteccion-civil'
import { relDesc } from '@data/related-desc'

export async function getStaticPaths() {
  const tramites = await getCollection('tramites', ({ data }) => !data.draft)
  const servicios = await getCollection('servicios', ({ data }) => !data.draft)

  return tramites.map((entry) => {
    const comerciales = (entry.data.relatedServices ?? [])
      .map((r) => servicios.find((s) => s.id === r.id))
      .filter(Boolean)
      .map((s) => ({ label: s!.data.title, href: `/servicios/${s!.id}/`, desc: relDesc('servicios', s!.id) }))
    const otras = tramites
      .filter((t) => t.id !== entry.id)
      .map((t) => ({ label: t.data.title, href: `/proteccion-civil/${t.id}/`, desc: relDesc('tramites', t.id) }))

    return { params: { slug: entry.id }, props: { entry, comerciales, otras } }
  })
}

const { entry, comerciales, otras } = Astro.props
const { Content } = await render(entry)
const d = entry.data
const fmt = (date: Date) => date.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
const ficha = [
  ['Autoridad', d.autoridad],
  ['Trámite oficial', d.tramiteOficial],
  ['A quién aplica', d.quienAplica],
  ['Modalidad', d.modalidad],
  ['Tiempo de respuesta', d.plazo],
  ['Costo', d.costo],
  ['Resultado', d.resultado],
  ['Vigencia', d.vigencia],
].filter(([, value]) => Boolean(value)) as [string, string][]
const bloqueIds = [
  ...(d.requisitos && d.requisitos.length > 0 ? ['requisitos'] : []),
  ...(d.fundamento && d.fundamento.length > 0 ? ['fundamento'] : []),
  'contenido',
  ...(d.pending && d.pending.length > 0 ? ['pendientes'] : []),
  'fuentes',
]
const usaSurface = (id: string) => bloqueIds.indexOf(id) % 2 === 0
const waHref = waUrl(`Hola, tengo un requerimiento de Protección Civil en ${d.entidad} y necesito poner mi inmueble en regla.`)

---

<PageLayout
  title={d.seoTitle ?? d.title}
  description={d.seoDescription ?? d.description}
  image={d.image}
  pageType="page"
  schemaData={{ ...(d.faqs?.length ? { faqs: d.faqs } : {}) }}
  breadcrumbs={[{ label: 'Protección Civil', href: '/proteccion-civil/' }, { label: d.label }]}
  guia={false}
>
  <Hero
    badge={`Protección Civil · ${d.entidad}`}
    title={d.title}
    subtitle={d.description}
    descRight={[
      'Cada dato viene de la fuente oficial y lleva su fecha de verificación.',
      'Lo que no pudimos confirmar lo marcamos como pendiente, con el enlace para que lo consultes directo.',
    ]}
    ctas={[
      { text: 'Clasificar mi riesgo', href: '/herramientas/riesgo-de-incendio/', variant: 'outline' },
      { text: 'Hablar por WhatsApp', href: waHref, variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu
    items={sectionMenuItems()}
    cta={{ label: 'Preparar el inmueble', href: waHref, sub: 'Equipo y expediente', external: true }}
  />
  <TrustBar items={pcPillars} />

  <DataTable
    eyebrow="Datos del trámite"
    title="Datos del"
    titleAccent="trámite"
    desc={`Verificado el ${fmt(d.verifiedAt)} en la fuente oficial. Los trámites cambian: confirma en el enlace antes de iniciar.`}
    columns={['Dato', 'Detalle']}
    rows={ficha}
  />

  {d.requisitos && d.requisitos.length > 0 && (
    <section class:list={['section', usaSurface('requisitos') && 'section--surface']}>
      <div class="container">
        <SectionHeading layout="duo" eyebrow="Requisitos" title="Lo que debes" titleAccent="reunir" desc="Lo que pide la autoridad para ingresar el trámite." />
        <div class="info-grid">
          {d.requisitos.map((item, index) => (
            <article class="info-card"><span class="info-card__num">{String(index + 1).padStart(2, '0')}</span><p>{item}</p></article>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.fundamento && d.fundamento.length > 0 && (
    <section class:list={['section', usaSurface('fundamento') && 'section--surface']}>
      <div class="container">
        <SectionHeading layout="duo" eyebrow="Fundamento jurídico" title="La base del" titleAccent="trámite" desc="Las leyes y reglamentos en los que se apoya." />
        <div class="info-grid">
          {d.fundamento.map((item, index) => (
            <article class="info-card"><span class="info-card__num">{String(index + 1).padStart(2, '0')}</span><p>{item}</p></article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class:list={['section', usaSurface('contenido') && 'section--surface']}>
    <div class="container">
      <div class="guide-grid">
        <article class="prose"><Content /></article>
        <QuoteCard
          title={`Tu inmueble en regla · ${d.entidad}`}
          waLink={waHref}
          telHref={telUrl()}
          eyebrow="Lo que sí hacemos"
          items={['Equipo contra incendio en regla', 'Mantenimiento con etiqueta y collarín', 'Capacitación con DC-3']}
          showPrice={false}
          ctaLabel="Preparar por WhatsApp"
        />
      </div>
    </div>
  </section>

  {d.pending && d.pending.length > 0 && (
    <section class:list={['section', usaSurface('pendientes') && 'section--surface']}>
      <div class="container">
        <SectionHeading layout="duo" eyebrow="Pendientes" title="Lo que todavía" titleAccent="no publicamos" desc="Si un dato no está confirmado, no lo adivinamos." />
        <ul class="pending-list">{d.pending.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>
  )}

  <section class:list={['section', usaSurface('fuentes') && 'section--surface']}>
    <div class="container">
      <SectionHeading layout="duo" eyebrow="Fuentes oficiales" title="Consulta la fuente" titleAccent="antes de iniciar" desc="Los trámites pueden cambiar; revisa siempre la información oficial." />
      <ul class="sources-list">
        {d.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}
      </ul>
    </div>
  </section>

  <RelatedLinks title="Lo que sí hacemos nosotros" links={[...comerciales, ...otras]} limit={4} />

  {d.faqs && d.faqs.length > 0 && (
    <FAQWithContact
      items={d.faqs}
      waNumber={CONTACT.whatsapp}
      eyebrow="Preguntas frecuentes"
      title="Preguntas frecuentes"
      titleAccent="sobre este trámite"
    />
  )}
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .info-grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-4); }
  @media (min-width: 768px) { .info-grid { grid-template-columns: repeat(2, 1fr); } }
  .info-card { display: flex; gap: var(--sp-4); padding: var(--sp-5); background: var(--c-white); border: 1px solid var(--c-border); border-radius: var(--radius-lg); }
  .info-card__num { flex: none; color: var(--c-primary); font-family: var(--font-heading); font-weight: var(--weight-black); }
  .info-card p { margin: 0; color: var(--c-ink-2); line-height: var(--leading-relaxed); }
  .guide-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-8); align-items: start; }
  .guide-grid .prose { max-width: 68ch; }
  @media (min-width: 900px) { .guide-grid { grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem); } }
  .pending-list, .sources-list { display: grid; gap: var(--sp-3); margin: 0; padding-left: 1.25rem; color: var(--c-ink-2); line-height: var(--leading-relaxed); }
  .sources-list a { color: var(--c-primary); }
</style>
