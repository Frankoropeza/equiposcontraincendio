---
// ============================================================================
// /plantillas/<slug>/ — Ficha de un formato descargable homologada al patrón L4.
// ----------------------------------------------------------------------------
// El contenido técnico proviene de la colección `plantillas`; esta página solo
// compone Hero, navegación, descarga, proceso, cuerpo, enlaces y FAQ.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import SectionHeading from '@components/SectionHeading.astro'
import ProcessSteps from '@components/ProcessSteps.astro'
import QuoteCard from '@components/QuoteCard.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import CategoryCard from '@components/CategoryCard.astro'
import { getCollection, render } from 'astro:content'
import { CONTACT, sectionMenuItems, telUrl, waUrl } from '@config/site'
import { cierrePlantillas, faltanParaCuatro } from '@data/cierre'
import { relDesc } from '@data/related-desc'

export async function getStaticPaths() {
  const plantillas = await getCollection('plantillas', ({ data }) => !data.draft)
  const servicios = await getCollection('servicios', ({ data }) => !data.draft)
  const articulos = await getCollection('articulos', ({ data }) => !data.draft)

  return plantillas.map((entry) => {
    const otras = plantillas
      .filter((p) => p.id !== entry.id)
      .map((p) => ({ label: p.data.label, href: `/plantillas/${p.id}/`, desc: relDesc('plantillas', p.id) }))
    const comerciales = [
      ...(entry.data.relatedServices ?? [])
        .map((r) => servicios.find((s) => s.id === r.id))
        .filter(Boolean)
        .map((s) => ({ label: s!.data.title, href: `/servicios/${s!.id}/`, desc: relDesc('servicios', s!.id) })),
      ...(entry.data.relatedPosts ?? [])
        .map((r) => articulos.find((a) => a.id === r.id))
        .filter(Boolean)
        .map((a) => ({ label: a!.data.title, href: `/blog/${a!.id}/`, desc: relDesc('articulos', a!.id) })),
    ]

    return { params: { slug: entry.id }, props: { entry, otras, comerciales } }
  })
}

const { entry, otras, comerciales } = Astro.props
const { Content } = await render(entry)
const d = entry.data
const cierreArchivos = cierrePlantillas.slice(0, faltanParaCuatro(d.files.length))
const waHref = waUrl(`Hola, descargué el formato "${d.label}" y quiero que me apoyen con mi inmueble.`)
const steps = (d.steps ?? []).map((step, index) => {
  const match = step.match(/^([^:]+):\s*(.*)$/)
  return {
    num: String(index + 1).padStart(2, '0'),
    title: match?.[1] ?? step,
    desc: match?.[2] || 'Completa este paso y continúa con el siguiente.',
  }
})
const relatedPlantilla = Array.from(new Map([
  ...otras,
  ...comerciales,
  { label: 'Productos', href: '/productos/', desc: 'Equipo contra incendio para tu inmueble.' },
  { label: 'Contacto', href: '/contacto/', desc: 'Cotiza equipo y servicios.' },
].map((item) => [item.href, item])).values()).slice(0, 4)

---

<PageLayout
  title={d.seoTitle ?? d.title}
  description={d.seoDescription ?? d.description}
  image={d.image}
  pageType="page"
  schemaData={{ ...(d.faqs?.length ? { faqs: d.faqs } : {}) }}
  breadcrumbs={[{ label: 'Formatos descargables', href: '/plantillas/' }, { label: d.label }]}
>
  <Hero
    badge={d.files.map((file) => file.ext).join(' · ')}
    title={d.label}
    subtitle={d.description}
    descRight={[
      'Descárgalo gratis, sin registro, en formato editable y en PDF para imprimir.',
      'Si prefieres delegarlo, podemos apoyarte con la gestión documental de tu inmueble.',
    ]}
    ctas={[
      { text: `Descargar ${d.files[0].ext}`, href: d.files[0].href, variant: 'outline' },
      { text: 'Gestión del expediente', href: waHref, variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu
    items={sectionMenuItems()}
    cta={{ label: 'Gestión documental', href: waHref, sub: 'Integramos tu expediente', external: true }}
  />

  <section class="section section--surface" id="descarga">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Descarga"
        title="Descarga el"
        titleAccent="formato"
        desc="Elige el archivo que se adapte a tu forma de trabajo."
      />
      <div class="card-grid">
        {d.files.map((file) => (
          <a class="download-card" href={file.href} download>
            <span class="download-card__ext">{file.ext}</span>
            <span class="download-card__label">Descargar archivo</span>
            <span class="download-card__size">{file.size}</span>
          </a>
        ))}
        {cierreArchivos.map((ficha, i) => (
          <CategoryCard
            label={ficha.title}
            href={ficha.whatsapp ? waUrl(ficha.href) : ficha.href}
            image={ficha.image}
            imageAlt={ficha.imageAlt}
            badge={ficha.badge}
            blurb={ficha.description}
            ctaLabel={ficha.ctaLabel}
            index={d.files.length + i}
            external={ficha.whatsapp}
          />
        ))}
      </div>
    </div>
  </section>

  {steps.length > 0 && (
    <ProcessSteps
      eyebrow="Cómo se llena"
      title="Del archivo"
      titleAccent="al expediente"
      desc="Sigue los pasos en el orden del formato y conserva la evidencia junto al resto de tu documentación."
      steps={steps}
    />
  )}

  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Contenido del formato"
        title="Lo que debes"
        titleAccent="tener presente"
        desc="Para qué sirve, qué no sustituye y cómo conservarlo."
      />
      <div class="guide-grid">
        <article class="prose"><Content /></article>
        <QuoteCard
          title={d.label}
          waLink={waHref}
          telHref={telUrl()}
          eyebrow="¿Prefieres delegarlo?"
          items={['Bitácora al día', 'Etiqueta y collarín en regla', 'Expediente listo para la visita']}
          showPrice={false}
          ctaLabel="Gestión documental por WhatsApp"
        />
      </div>
    </div>
  </section>

  <RelatedLinks
    title="Sigue por aquí"
    desc="Otras plantillas y enlaces comerciales relacionados."
    links={relatedPlantilla}
    limit={4}
  />

  {d.faqs && d.faqs.length > 0 && (
    <FAQWithContact
      items={d.faqs}
      waNumber={CONTACT.whatsapp}
      eyebrow="Preguntas frecuentes"
      title="Preguntas frecuentes"
      titleAccent="sobre este formato"
    />
  )}
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .download-card { display: flex; flex-direction: column; gap: var(--sp-2); padding: var(--sp-6); border: 1px solid var(--c-border); border-radius: var(--radius-lg); background: var(--c-white); color: var(--c-ink); text-decoration: none; }
  .download-card:hover { border-color: var(--c-primary); box-shadow: var(--shadow-sm); }
  .download-card__ext { font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: var(--weight-black); color: var(--c-primary); }
  .download-card__label { font-weight: var(--weight-semibold); }
  .download-card__size { color: var(--c-muted); font-size: var(--text-sm); }
  .guide-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-8); align-items: start; }
  .guide-grid .prose { max-width: 68ch; }
  @media (min-width: 900px) { .guide-grid { grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem); } }
</style>
