---
// ============================================================================
// /blog/categoria/<slug>/ y /blog/categoria/<slug>/pagina/<n>/
// ----------------------------------------------------------------------------
// Archivo de categoría del blog, paginado. El copy, el title, la meta y el
// destino comercial salen de BLOG_CATEGORIES (src/config/site.ts): antes esta
// página improvisaba el texto a partir del slug y le explicaba SEO al visitante.
//
// POR QUÉ UN SOLO ARCHIVO CON REST PARAM: `[...categoria]` admite varios
// segmentos, así que la misma ruta genera el archivo (`extintores`) y sus
// páginas (`extintores/pagina/2`). Un directorio `[categoria]/pagina/[page]`
// chocaría con este rest param.
//
// La página 1 nunca vive en /pagina/1/ (sería un duplicado del archivo).
// Las páginas N>=2 van noindex,follow; la página 1 permanece indexable.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import BlogArchive from '@components/BlogArchive.astro'
import SectionMenu from '@components/SectionMenu.astro'
import { getCollection } from 'astro:content'
import { waUrl, WA_MESSAGES, blogCategory, BLOG_PAGE_SIZE } from '@config/site'

export async function getStaticPaths() {
  const posts = (await getCollection('articulos', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  )
  const cats = [...new Set(posts.map((p) => p.data.category))]

  return cats.flatMap((categoria) => {
    const all = posts.filter((p) => p.data.category === categoria)
    const total = Math.max(1, Math.ceil(all.length / BLOG_PAGE_SIZE))

    return Array.from({ length: total }, (_, i) => {
      const page = i + 1
      return {
        // Página 1 → 'extintores'. Página N → 'extintores/pagina/N'.
        params: { categoria: page === 1 ? categoria : `${categoria}/pagina/${page}` },
        props: {
          categoria,
          page,
          total,
          posts: all.slice((page - 1) * BLOG_PAGE_SIZE, page * BLOG_PAGE_SIZE),
        },
      }
    })
  })
}

const { categoria, page, total, posts } = Astro.props

// Copy de la categoría. El respaldo sólo actúa si alguien publica un slug sin
// entrada en BLOG_CATEGORIES; tests/blog-taxonomy.test.mjs impide que ocurra.
const cat = blogCategory(categoria)
const label = cat?.label ?? categoria
const intro = cat?.intro ?? `Artículos del blog en la categoría ${label}.`
const body: string[] = [...(cat?.body ?? [])]
const cta = cat?.cta

const base = `/blog/categoria/${categoria}/`
const path = page === 1 ? base : `${base}pagina/${page}/`
const prevUrl = page === 2 ? base : `${base}pagina/${page - 1}/`
const nextUrl = page < total ? `${base}pagina/${page + 1}/` : null

const pageSuffix = page > 1 ? ` — página ${page}` : ''

const schemaData = {
  list: {
    name: `${label}${pageSuffix}`,
    description: cat?.seoDescription ?? intro,
    path,
    items: posts.map((a) => ({
      name: a.data.title,
      path: `/blog/${a.id}/`,
      image: a.data.heroImage,
      description: a.data.description,
    })),
  },
}

const cierreItems = [
  { label: 'Todo el blog', href: '/blog/', sub: 'Todos los artículos' },
  { label: 'Servicios', href: '/servicios/', sub: 'Instalación y mantenimiento' },
  { label: 'Contacto', href: '/contacto/', sub: 'Teléfono, WhatsApp y oficinas' },
  { label: 'Inicio', href: '/', sub: 'Volver al inicio' },
]
const cierreCta = { label: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.blog), sub: 'Te decimos qué necesitas', external: true }
---

<PageLayout
  title={`${cat?.seoTitle ?? `${label} — blog`}${pageSuffix}`}
  description={cat?.seoDescription ?? intro}
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[
    { label: 'Blog', href: '/blog/' },
    ...(page > 1 ? [{ label, href: base }, { label: `Página ${page}` }] : [{ label }]),
  ]}
  noindex={page > 1}
  follow={true}
>
  {page > 1 && <link slot="head" rel="prev" href={prevUrl} />}
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}

  <Hero
    badge="Blog"
    title={`${label}:`}
    accent={"guías\u00a0para\u00a0empresas"}
    subtitle={intro}
    descRight={body}
    ctas={[
      ...(cta ? [{ text: cta.label, href: cta.href, variant: 'outline' as const }] : []),
      { text: 'Consultar por WhatsApp', href: waUrl(WA_MESSAGES.blog), variant: 'primary' as const, whatsapp: true },
    ]}
  />

  <BlogArchive
    posts={posts}
    current={page}
    total={total}
    base={base}
    currentCategory={categoria}
    eyebrow={page > 1 ? `Página ${page} de ${total}` : 'Archivo de categoría'}
    title={`Artículos sobre ${label.toLowerCase()}`}
    desc={`Guías sobre ${label.toLowerCase()}, de la más reciente a la más antigua.`}
  />

  <SectionMenu items={cierreItems} cta={cierreCta} ariaLabel="Sigue explorando el blog" />
</PageLayout>
