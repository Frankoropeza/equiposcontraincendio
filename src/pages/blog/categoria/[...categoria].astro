---
// ============================================================================
// /blog/categoria/<categoria> — Archivo de categoría del blog.
// ----------------------------------------------------------------------------
// Una página por categoría USADA por los artículos (no por todo el enum), con
// el copy, el title y la meta de BLOG_CATEGORIES (src/config/site.ts).
//
// ESTRATEGIA EDITORIAL 2026-09-09: antes esta página improvisaba el texto a
// partir del slug y le explicaba SEO al visitante («las páginas de categoría…
// generan una URL de archivo que el buscador puede posicionar»). Ahora cada
// categoría trae su propia entradilla, su meta y su DESTINO COMERCIAL, que es
// lo que hace del archivo una página con función y no un duplicado del índice.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import SectionMenu from '@components/SectionMenu.astro'
import { getCollection } from 'astro:content'
import { waUrl, WA_MESSAGES, blogCategory } from '@config/site'

export async function getStaticPaths() {
  const posts = (await getCollection('articulos', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  )
  const cats = [...new Set(posts.map((p) => p.data.category))]
  return cats.map((categoria) => ({
    params: { categoria },
    props: { categoria, posts: posts.filter((p) => p.data.category === categoria) },
  }))
}

const { categoria, posts } = Astro.props

// Copy de la categoría. El respaldo sólo actúa si alguien publica un slug sin
// entrada en BLOG_CATEGORIES; tests/blog-taxonomy.test.mjs impide que ocurra.
const cat = blogCategory(categoria)
const label = cat?.label ?? categoria
const intro = cat?.intro ?? `Artículos del blog en la categoría ${label}.`
const body: string[] = [...(cat?.body ?? [])]
const cta = cat?.cta

const cierreItems = [
  { label: 'Todo el blog', href: '/blog/', sub: 'Ver todos los artículos' },
  { label: 'Servicios', href: '/servicios/', sub: 'Lo que ofrecemos' },
  { label: 'Contacto', href: '/contacto/', sub: 'Hablemos de tu proyecto' },
  { label: 'Inicio', href: '/', sub: 'Volver a la home' },
]
const cierreCta = { label: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.blog), sub: 'Respuesta inmediata', external: true }
---

<PageLayout
  title={cat?.seoTitle ?? `${label} — blog`}
  description={cat?.seoDescription ?? intro}
  pageType="category"
  breadcrumbs={[{ label: 'Blog', href: '/blog/' }, { label }]}
  guia={false}
>
  <Hero
    badge="Blog"
    title={label.split(' ')[0]}
    accent={label.split(' ').slice(1).join(' ') || 'del blog'}
    subtitle={intro}
    descRight={body}
    ctas={[
      ...(cta ? [{ text: cta.label, href: cta.href, variant: 'outline' as const }] : []),
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.blog), variant: 'primary' as const, whatsapp: true },
    ]}
  />

  <section class="section">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Archivo de categoría"
        title={`Artículos sobre ${label.toLowerCase()}`}
        desc={`${posts.length} ${posts.length === 1 ? 'artículo' : 'artículos'} en esta categoría.`}
        body={body}
      />
      <div class="grid">
        {posts.map((a, i) => (
          <CategoryCard
            label={a.data.title}
            href={`/blog/${a.id}/`}
            image={a.data.heroImage}
            imageAlt={a.data.title}
            badge={label}
            blurb={a.data.description}
            ctaLabel="Leer artículo"
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <SectionMenu items={cierreItems} cta={cierreCta} ariaLabel="Sigue explorando el blog" />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); margin-top: var(--sp-6); }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
