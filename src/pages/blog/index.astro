---
// ============================================================================
// /blog/ — Landing del Blog (página 1 del archivo).
// ----------------------------------------------------------------------------
// L2 homologada: Hero → SectionMenu → listado con barra lateral → paginación.
// El listado, la barra y la paginación viven en BlogArchive (pieza compartida
// con /blog/pagina/N/ y con los archivos de categoría).
//
// SEO: pageType="category" + schemaData.list → CollectionPage + ItemList con los
// artículos de ESTA página. Antes era pageType="page", así que el índice del
// blog no declaraba qué listaba.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import BlogArchive from '@components/BlogArchive.astro'
import { getCollection } from 'astro:content'
import { waUrl, WA_MESSAGES, BLOG_PAGE_SIZE, sectionMenuItems } from '@config/site'

const articulos = (await getCollection('articulos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const total = Math.max(1, Math.ceil(articulos.length / BLOG_PAGE_SIZE))
const posts = articulos.slice(0, BLOG_PAGE_SIZE)

// Menú de secciones: subtítulos desde SECTION_MENU_SUB (site.ts), no un mapa
// local — así todas las páginas describen las secciones igual.
const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.blog),
  sub: 'Te decimos qué necesitas',
  external: true,
}

const schemaData = {
  list: {
    name: 'Blog de equipo contra incendio',
    description:
      'Guías de prevención y protección contra incendios para empresas: extintores, mantenimiento, sistemas contra incendio y normatividad mexicana.',
    path: '/blog/',
    items: posts.map((a) => ({
      name: a.data.title,
      path: `/blog/${a.id}/`,
      image: a.data.heroImage,
      description: a.data.description,
    })),
  },
}
---

<PageLayout
  title="Prevención de incendios en empresas: guías y normas"
  description="Guías de prevención y protección contra incendios para empresas en México: extintores, mantenimiento, sistemas contra incendio y lo que exige la NOM-002-STPS-2010."
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Blog' }]}
  guia={false}
>
  {/* ─── Hero (componente compartido, copy de cara al cliente) ─── */}
  <Hero
    badge="Guías y normatividad"
    title="Guías de prevención"
    accent={"y\u00a0protección contra\u00a0incendios"}
    subtitle="Medidas de prevención de incendios para tu empresa: cómo elegir, instalar y mantener tu equipo contra incendio y qué pide la normatividad mexicana, explicado claro y sin tecnicismos de más."
    descRight={[
      'Aquí publicamos guías sobre equipo contra incendio: cómo elegir un extintor según la clase de fuego, qué exige la NOM-154-SCFI para el mantenimiento y la recarga, y cómo mantener tu inmueble protegido y en regla.',
      'Contenido pensado para que tomes mejores decisiones de protección, con información confiable y aplicada a tu caso. ¿Tienes una duda puntual? Escríbenos por WhatsApp.',
    ]}
    ctas={[
      { text: 'Equipos contra incendios', href: '/productos/', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.blog), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  <BlogArchive
    posts={posts}
    current={1}
    total={total}
    base="/blog/"
    eyebrow="Últimos artículos"
    title="Seguridad contra incendios:"
    titleAccent="guías y normatividad"
    desc="Lo esencial sobre extintores, mantenimiento y cumplimiento, explicado claro."
    body={[
      'Reunimos guías prácticas de prevención y protección contra incendios: qué equipo necesitas según tu grado de riesgo, cada cuándo darle servicio, cómo organizar la brigada y los simulacros, y qué pide la NOM-002-STPS-2010 para pasar una inspección de Protección Civil o de la STPS.',
      'Cada artículo va al grano y, cuando aplica, te conecta con el producto o servicio que resuelve tu caso.',
    ]}
  />
</PageLayout>
