---
// /blog/ — Landing del Blog (lista de artículos). L2 HOMOLOGADA con el sistema
// del index: Hero → SectionMenu → tarjetas → CTABanner. Copy de cara al cliente.
// El grid sale de la colección `articulos` (.mdx), ordenada por fecha.
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import { getCollection } from 'astro:content'
import { NAV, waUrl, WA_MESSAGES } from '@config/site'

const articulos = (await getCollection('articulos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

// Etiqueta legible para el badge de categoría de cada artículo.
const CAT_LABEL: Record<string, string> = {
  guias: 'Guía',
  novedades: 'Novedad',
  general: 'Artículo',
}

// ── Menú de secciones bajo el hero (data-driven desde NAV; excluye Contacto) ──
const menuSub: Record<string, string> = {
  Productos: 'Catálogo de equipo',
  Servicios: 'Instalación y mantenimiento',
  Cobertura: 'Zonas que atendemos',
  Blog: 'Guías y normatividad',
}
const menuSecciones = NAV.filter((n) => n.label !== 'Contacto').map((n) => ({
  label: n.label,
  href: n.href,
  sub: menuSub[n.label] ?? 'Ver sección',
}))
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.blog),
  sub: 'Respuesta inmediata',
  external: true,
}
---

<PageLayout
  title="Blog — guías de seguridad contra incendio"
  description="Guías prácticas sobre equipo contra incendio: cómo elegir un extintor, qué pide la NOM-154 para el mantenimiento y la recarga, y cómo mantener tu inmueble en regla."
  pageType="page"
  breadcrumbs={[{ label: 'Blog' }]}
  guia={false}
>
  {/* ─── Hero (componente compartido, copy de cara al cliente) ─── */}
  <Hero
    badge="Guías y normatividad"
    title="Guías de"
    accent="seguridad contra incendio"
    subtitle="Artículos prácticos para elegir, instalar y mantener tu equipo contra incendio, y entender qué pide la normatividad mexicana — explicado claro, sin tecnicismos de más."
    descRight={[
      'Aquí publicamos guías sobre equipo contra incendio: cómo elegir un extintor según la clase de fuego, qué exige la NOM-154-SCFI para el mantenimiento y la recarga, y cómo mantener tu inmueble protegido y en regla.',
      'Contenido pensado para que tomes mejores decisiones de protección, con información confiable y aplicada a tu caso. ¿Tienes una duda puntual? Escríbenos por WhatsApp.',
    ]}
    ctas={[
      { text: 'Ver catálogo', href: '/productos', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.blog), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Lista de artículos ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Últimos artículos"
        title="Guías y"
        titleAccent="normatividad"
        desc="Lo esencial sobre extintores, mantenimiento y cumplimiento, explicado claro."
        body={[
          'Reunimos guías prácticas sobre protección contra incendio: qué equipo necesitas según tu riesgo, cada cuándo darle servicio y qué pide la norma para pasar una inspección.',
          'Cada artículo va al grano y, cuando aplica, te conecta con el producto o servicio que resuelve tu caso.',
        ]}
      />

      <div class="grid">
        {articulos.map((a, i) => (
          <CategoryCard
            label={a.data.title}
            href={`/blog/${a.id}`}
            image={a.data.heroImage}
            imageAlt={a.data.title}
            badge={CAT_LABEL[a.data.category] ?? 'Artículo'}
            blurb={a.data.description}
            ctaLabel="Leer artículo"
            index={i}
          />
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); margin-top: var(--sp-6); }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
