---
// ============================================================================
// index.astro — HOME de equiposcontraincendio.com
// Sitio de cliente (sin modo guía). Datos 100% desde SSoT (src/config/site.ts)
// y Content Collections. WhatsApp SIEMPRE vía waUrl() (regla D4).
// Contenido HONESTO: sin reseñas/clientes/años fabricados (regla del sistema).
// ============================================================================
import PageLayout from "@layouts/PageLayout.astro";
import Hero from "@components/Hero.astro";
import SectionMenu from "@components/SectionMenu.astro";
import SectionHeading from "@components/SectionHeading.astro";
import CategoryCard from "@components/CategoryCard.astro";
import ServiceCard from "@components/ServiceCard.astro";
import TrustBar from "@components/TrustBar.astro";
import RiskGuide from "@components/RiskGuide.astro";
import NormsTable from "@components/NormsTable.astro";
import ProcessSteps from "@components/ProcessSteps.astro";
import CompanyAbout from "@components/CompanyAbout.astro";
import FAQAccordion from "@components/FAQAccordion.astro";
import CTABanner from "@components/CTABanner.astro";
import { KEYWORDS, NAV, SHOWCASE, WA_MESSAGES, waUrl } from "@config/site";

const waLink = waUrl();

// ── Menú de secciones bajo el hero (data-driven desde NAV; excluye Contacto) ──
const menuSub: Record<string, string> = {
  Productos: "Catálogo de equipo",
  Servicios: "Instalación y mantenimiento",
  Cobertura: "Zonas que atendemos",
  Blog: "Guías y normatividad",
};
const menuSecciones = NAV.filter((n) => n.label !== "Contacto").map((n) => ({
  label: n.label,
  href: n.href,
  sub: menuSub[n.label] ?? "Ver sección",
}));
const menuCta = {
  label: "Cotizar por WhatsApp",
  href: waUrl(WA_MESSAGES.cotizar),
  sub: "Respuesta inmediata",
  external: true,
};

// ── Barra de confianza (pilares honestos: compromisos reales, sin métricas) ──
const pillars = [
  { icon: "shield", title: "Conforme a norma", desc: "Equipo y servicio alineados a la NOM-154-SCFI, la NOM-002-STPS y la NOM-003-SEGOB." },
  { icon: "doc", title: "Listo para Protección Civil", desc: "Te entregamos ficha técnica y constancias de servicio para tu expediente ante PC y STPS." },
  { icon: "chat", title: "Asesoría honesta", desc: "Te recomendamos el equipo que pide tu riesgo real, sin venderte de más." },
  { icon: "pin", title: "CDMX y Estado de México", desc: "Atención y entrega en la Ciudad de México, el Estado de México y la zona metropolitana." },
];

// ── Servicios destacados (fichas en /servicios/<id>) ──
const servicios = [
  {
    title: "Instalación de sistemas",
    description: "Proyecto e instalación de detección, hidrantes, extintores y señalización, dimensionados al riesgo de tu inmueble.",
    href: "/servicios/instalacion",
    image: "/images/servicios/instalacion-sistemas-contra-incendio.svg",
    imageAlt: "Instalación de sistemas contra incendio",
    badge: "Proyecto a la medida",
  },
  {
    title: "Mantenimiento y recarga",
    description: "Mantenimiento y recarga de extintores conforme a la NOM-154-SCFI-2005, con etiqueta y collarín de servicio vigentes.",
    href: "/servicios/mantenimiento",
    image: "/images/servicios/mantenimiento-recarga-extintores.svg",
    imageAlt: "Mantenimiento y recarga de extintores",
    badge: "Conforme a norma",
  },
  {
    title: "Inspección y dictamen",
    description: "Revisión, pruebas y reporte del estado de tu equipo contra incendio: faltantes, vencimientos y recomendaciones.",
    href: "/servicios/inspeccion",
    image: "/images/servicios/inspeccion-dictamen-contra-incendio.svg",
    imageAlt: "Inspección y dictamen de equipo contra incendio",
    badge: "Reporte claro",
  },
];

// ── Guía de selección por nivel de riesgo (clasificación NOM-002-STPS) ──
const riskRows = [
  {
    nivel: "Ordinario",
    ejemplos: "Oficinas, escuelas, consultorios, comercios pequeños",
    minimo: "Extintores PQS ABC, detección de humo, señalización NOM-003",
    complementos: "Botiquín, lámparas de emergencia, capacitación de uso",
  },
  {
    nivel: "Moderado",
    ejemplos: "Restaurantes, talleres, hoteles, comercios medianos",
    minimo: "Agente por clase de fuego, gabinetes con manguera, extintor clase K en cocina",
    complementos: "Sistema de detección, EPP de brigada, constancias DC-3",
  },
  {
    nivel: "Alto",
    ejemplos: "Bodegas, naves industriales, gasolineras, laboratorios",
    minimo: "Red hidráulica, rociadores, extintores móviles, tablero de detección",
    complementos: "Monitores, agente limpio en áreas críticas, brigadas y simulacros",
  },
];

// ── Respaldo normativo (NOM obligatorias + NFPA como referencia técnica) ──
const normRows = [
  { norma: "NOM-002-STPS-2010", alcance: "Prevención y protección contra incendios en centros de trabajo", aplica: "Toda empresa con trabajadores" },
  { norma: "NOM-154-SCFI-2005", alcance: "Mantenimiento, recarga y prueba hidrostática de extintores", aplica: "Extintores y su servicio" },
  { norma: "NOM-003-SEGOB-2011", alcance: "Señales y avisos para protección civil: colores, formas y símbolos", aplica: "Inmuebles con afluencia de personas" },
  { norma: "NOM-026-STPS-2008", alcance: "Colores y señales de seguridad; identificación de fluidos en tubería", aplica: "Centros de trabajo" },
  { norma: "NFPA 72 (ref.)", alcance: "Detección y alarma de incendio", aplica: "Sistemas de detectores y alarma" },
  { norma: "NFPA 13 (ref.)", alcance: "Rociadores automáticos", aplica: "Supresión automática en edificios" },
  { norma: "NFPA 20 (ref.)", alcance: "Bombas estacionarias contra incendio", aplica: "Redes hidráulicas con bomba" },
  { norma: "NFPA 1970 (ref.)", alcance: "Equipo de protección para combate de incendios", aplica: "Trajes y equipo de brigada" },
];

// ── Proceso de trabajo (pasos reales, sin tiempos garantizados que no se cumplan) ──
const steps = [
  { num: "01", title: "Asesoría y diagnóstico", desc: "Nos cuentas tu giro, tamaño y lo que pide la inspección; identificamos el riesgo y lo que necesitas." },
  { num: "02", title: "Cotización clara", desc: "Propuesta con producto, cantidad y precio. Si el presupuesto es acotado, proponemos por fases." },
  { num: "03", title: "Suministro e instalación", desc: "Entregamos el equipo y, cuando aplica, lo instalamos: detección, hidrantes, extintores y señalización." },
  { num: "04", title: "Documentación", desc: "Ficha técnica, constancias de servicio y, si lo necesitas, constancias DC-3 para tu expediente." },
  { num: "05", title: "Mantenimiento y avisos", desc: "Te recordamos la revisión anual, la recarga y la prueba hidrostática (cada 5 años) para que no caduque tu protección." },
];

// ── Sobre el negocio (qué / cómo) — sin cifras inventadas (regla del sistema) ──
const empresa = {
  que: {
    title: "Qué hacemos",
    body: [
      "Equipamos inmuebles contra incendio de principio a fin: extintores, detección y alarma, hidrantes y mangueras, y señalización de emergencia. Vendemos, instalamos y damos mantenimiento, siempre según el riesgo real del lugar y no según un catálogo genérico.",
      "Atendemos a empresas, comercios, escuelas, restaurantes e inmuebles que necesitan estar protegidos y cumplir con la normatividad aplicable.",
    ],
  },
  como: {
    title: "Cómo trabajamos",
    pillars: [
      { title: "Asesoría real", desc: "Te recomendamos el equipo correcto en lenguaje claro, sin venderte de más." },
      { title: "Conforme a norma", desc: "Trabajamos alineados a la NOM-002-STPS-2010 y la NOM-154-SCFI-2005." },
      { title: "Respuesta por WhatsApp", desc: "Cotizas y resuelves dudas directo por WhatsApp, con atención personal." },
    ],
  },
};

// ── FAQ del negocio (alimenta el acordeón visible y el FAQPage del schema) ──
const faqs = [
  {
    question: "¿Qué extintor necesito para mi negocio?",
    answer:
      "Depende de lo que pueda quemarse. Para la mayoría de oficinas y comercios, un extintor PQS ABC es la opción versátil; las cocinas requieren además un extintor clase K, y los cuartos eléctricos uno de CO₂. Escríbenos y te asesoramos según tu riesgo.",
  },
  {
    question: "¿Cada cuándo se da mantenimiento o recarga a un extintor?",
    answer:
      "El servicio de mantenimiento y recarga se realiza conforme a la NOM-154-SCFI-2005 (de forma anual como práctica habitual). Además, en centros de trabajo la NOM-002-STPS-2010 pide una revisión mensual a cargo del personal.",
  },
  {
    question: "¿Cada cuándo se hace la prueba hidrostática de un extintor?",
    answer:
      "En México la prueba hidrostática se realiza cada 5 años para extintores de agua, CO₂ y PQS, conforme a la NOM-154-SCFI-2005 (o antes si el cilindro se golpea o pierde su contraseña). Ojo con el dato de “12 años”: ese es de la NFPA 10 de Estados Unidos, no es norma mexicana.",
  },
  {
    question: "¿Solo venden equipo o también instalan?",
    answer:
      "Ambas cosas. Vendemos el equipo y también lo instalamos, damos mantenimiento, recargamos extintores y hacemos inspección y dictamen del sistema completo.",
  },
  {
    question: "¿Me entregan la documentación para Protección Civil y STPS?",
    answer:
      "Sí. Cada equipo se entrega con su ficha técnica y, en los servicios, con la constancia correspondiente. Si lo necesitas, también gestionamos constancias DC-3 de capacitación — listo para integrar a tu expediente ante Protección Civil y STPS.",
  },
  {
    question: "¿En qué zonas dan servicio?",
    answer:
      "Atendemos la Ciudad de México, el Estado de México y la zona metropolitana. Cuéntanos dónde estás y te confirmamos cobertura y tiempos.",
  },
  {
    question: "¿Cómo cotizo?",
    answer:
      "Por WhatsApp es lo más rápido: nos dices qué necesitas y te respondemos con opciones, disponibilidad y el proceso de cotización y facturación.",
  },
];
---

<PageLayout
  keywords={KEYWORDS}
  pageType="home"
  guia={false}
  schemaData={{ faqs }}
>
  <Hero
    badge="Equipo contra incendio · CDMX y Estado de México"
    title="Equipo contra incendio,"
    accent="con respaldo de norma"
    subtitle="Venta, instalación, mantenimiento y recarga de extintores, detección, hidrantes y señalización — para empresas, comercios e inmuebles que necesitan cumplir y estar protegidos."
    descRight={[
      "Somos tu proveedor de equipo contra incendio: extintores, detección y alarma, hidrantes y mangueras, y señalización de emergencia. Vendemos, instalamos y damos mantenimiento — todo dimensionado al riesgo real de tu inmueble, no a un catálogo genérico.",
      "Trabajamos conforme a la normatividad mexicana —NOM-002-STPS-2010 y NOM-154-SCFI-2005— y te entregamos la documentación lista para tu expediente de Protección Civil. Cotiza por WhatsApp y recibe una recomendación honesta.",
    ]}
    ctas={[
      { text: "Ver catálogo", href: "/productos", variant: "outline" },
      { text: "Cotizar por WhatsApp", href: waUrl(WA_MESSAGES.cotizar), variant: "primary", whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Barra de confianza (pilares honestos) ─── */}
  <TrustBar items={pillars} />

  {/* ─── Catálogo: vitrina de categorías (SHOWCASE) ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Catálogo"
        title="Equipo para cada"
        titleAccent="riesgo"
        desc="Seis familias que cubren la protección de la mayoría de los inmuebles, con la norma que respalda cada una."
        body={[
          "Cada inmueble tiene un riesgo distinto, así que el equipo correcto también lo es. Aquí están las familias con las que protegemos oficinas, comercios, cocinas, escuelas e industria.",
          "Si no sabes por dónde empezar, escríbenos: revisamos tu caso y te decimos exactamente qué necesitas, sin venderte de más.",
        ]}
      />
      <div class="showcase">
        {SHOWCASE.map((c, i) => (
          <CategoryCard
            label={c.label}
            href={c.href}
            image={c.image}
            imageAlt={c.imageAlt}
            badge={c.badge}
            blurb={c.blurb}
            subcategories={c.subcategories}
            ctaLabel={c.ctaLabel}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Guía de selección por nivel de riesgo (NOM-002) ─── */}
  <RiskGuide
    eyebrow="Guía de selección"
    title="Qué equipo necesitas"
    titleAccent="según tu riesgo"
    desc="Una recomendación base por nivel de riesgo, conforme a la NOM-002-STPS-2010."
    body={[
      "El equipo correcto parte de identificar el nivel de riesgo de tu inmueble y lo que puede quemarse. A mayor exposición, mayor densidad de equipo y sistemas más completos.",
      "Esta tabla resume el punto de partida para cada nivel; el diagnóstico afina cantidad, agente y ubicación según tu instalación.",
    ]}
    rows={riskRows}
    note="Cifras orientativas. La NOM-002-STPS pide al menos un extintor por cada 300 m² (riesgo ordinario) o 200 m² (riesgo alto), a no más de 1.5 m de altura. La cantidad exacta, el agente y la ubicación se definen con un diagnóstico según la distribución de tu inmueble."
    ctaLabel="Pide tu diagnóstico por WhatsApp"
    ctaHref={waUrl("Hola, quiero asesoría para saber qué equipo contra incendio necesito según mi riesgo.")}
  />

  {/* ─── Servicios destacados ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Servicios"
        title="No solo vendemos:"
        titleAccent="instalamos y mantenemos"
        desc="Acompañamos tu protección contra incendio durante toda su vida útil."
        body={[
          "Un equipo contra incendio sirve si está bien elegido, bien instalado y vigente. Por eso ofrecemos el ciclo completo: instalación, mantenimiento, recarga e inspección.",
          "Todo con servicio conforme a norma y un reporte claro de lo que se hizo.",
        ]}
      />
      <div class="svcs">
        {servicios.map((s) => (
          <ServiceCard
            title={s.title}
            description={s.description}
            href={s.href}
            image={s.image}
            imageAlt={s.imageAlt}
            badge={s.badge}
            ctaLabel="Ver servicio"
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Respaldo normativo (vende cumplimiento) ─── */}
  <NormsTable
    eyebrow="Respaldo normativo"
    title="Equipo que cumple,"
    titleAccent="documentación que respalda"
    desc="No vendemos solo equipo: vendemos que pases la inspección."
    body={[
      "En una inspección, la autoridad no solo verifica que tengas el equipo: revisa que esté certificado, vigente y documentado. Por eso cada entrega llega con su soporte.",
      "Te ayudamos a mapear qué normas aplican a tu giro y a dejar el expediente en regla.",
    ]}
    rows={normRows}
    note="Cada entrega incluye ficha técnica y la documentación de servicio para integrar a tu expediente ante Protección Civil y STPS. Las normas NFPA son referencia técnica internacional y, en su caso, requisito de tu aseguradora — no ley federal. Te ayudamos a verificar qué aplica según el giro y tamaño de tu empresa."
  />

  {/* ─── Cómo trabajamos (proceso, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Cómo trabajamos"
    title="De la duda a estar"
    titleAccent="protegido y en regla"
    desc="Un solo proveedor para cotizar, recibir, instalar y mantener."
    body={[
      "Cada paso lo atiende quien sí sabe: desde el primer WhatsApp hasta la documentación en mano. Sin peloteo entre tres proveedores para un mismo expediente.",
      "Y no termina en la entrega: te acompañamos con el mantenimiento para que tu protección siga vigente.",
    ]}
    steps={steps}
  />

  {/* ─── Sobre el negocio (qué / cómo) ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Quiénes somos"
        title="Protección bien hecha,"
        titleAccent="explicada con claridad"
        desc="Equipo correcto, conforme a norma y con asesoría honesta."
        body={[
          "Trabajamos para que tu inmueble esté realmente protegido y en regla, no solo para venderte un equipo. La diferencia está en la asesoría: te decimos qué necesitas y por qué.",
          "Cotiza por WhatsApp y habla directo con quien resuelve.",
        ]}
      />
      <CompanyAbout
        que={empresa.que}
        como={empresa.como}
        cta={{ label: "Hablar por WhatsApp", href: waLink, external: true }}
      />
    </div>
  </section>

  {/* ─── FAQ ─── */}
  <section class="section">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Preguntas frecuentes"
        title="Dudas comunes sobre"
        titleAccent="equipo contra incendio"
        desc="Lo que más nos preguntan antes de cotizar."
        body={[
          "Reunimos las preguntas más frecuentes sobre extintores, mantenimiento, instalación, normatividad y cobertura.",
          "¿Tu duda no está aquí? Escríbenos por WhatsApp y te respondemos.",
        ]}
      />
      <FAQAccordion items={faqs} />
    </div>
  </section>

  {/* ─── Cierre / CTA ─── */}
  <CTABanner
    heading="¿Necesitas equipar o poner al día tu inmueble?"
    desc="Cuéntanos qué necesitas y te respondemos con opciones, disponibilidad y tiempos. Asesoría sin compromiso."
    btns={[
      { label: "Cotizar por WhatsApp", href: waUrl(WA_MESSAGES.cotizar), icon: "wa", primary: true, external: true },
      { label: "Ver catálogo", href: "/productos", icon: "catalog" },
    ]}
    badge="Respuesta rápida · Atención personalizada"
    variant="red"
  />
</PageLayout>

<style>
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  .showcase { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); }
  .svcs { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); margin-top: var(--sp-6); }
  @media (min-width: 640px) { .showcase { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 768px) { .svcs { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) {
    .section { padding: var(--sp-10) 0; }
    .showcase { grid-template-columns: repeat(3, 1fr); }
  }
</style>
