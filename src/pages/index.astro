---
// ============================================================================
// index.astro — HOME de equiposcontraincendio.com
// Sitio de cliente (sin modo guía). Datos 100% desde SSoT (src/config/site.ts)
// y Content Collections. WhatsApp SIEMPRE vía waUrl() (regla D4).
// Contenido HONESTO: sin reseñas/clientes/años fabricados (regla del sistema).
// ============================================================================
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Hero from "@components/Hero.astro";
import SectionMenu from "@components/SectionMenu.astro";
import SectionHeading from "@components/SectionHeading.astro";
import CategoryCard from "@components/CategoryCard.astro";
import ServiceCard from "@components/ServiceCard.astro";
import RiskGuide from "@components/RiskGuide.astro";
import NormsTable from "@components/NormsTable.astro";
import ProcessSteps from "@components/ProcessSteps.astro";
import CompanyAbout from "@components/CompanyAbout.astro";
import Testimonios from "@components/Testimonios.astro";
import RelatedLinks from "@components/RelatedLinks.astro";
import FAQWithContact from "@components/FAQWithContact.astro";
import { KEYWORDS, SECTION_MENU, SECTION_MENU_SUB, SHOWCASE, SERVICE_ANCHOR, WA_MESSAGES, waUrl, CONTACT } from "@config/site";
import { testimonios } from "@data/testimonios";
import {
  homeCompany,
  homeFaqs,
  homeHero,
  homeMenuSub,
  homeNormRows,
  homeRiskRows,
  homeSteps,
} from "@data/home";

const waLink = waUrl();

// ── Menú de secciones bajo el hero (data-driven desde SECTION_MENU de site.ts) ──
const menuSecciones = SECTION_MENU.map((n) => ({
  label: n.label,
  href: n.href,
  sub: homeMenuSub[n.label] ?? SECTION_MENU_SUB[n.label] ?? "Ir a la sección",
}));
const menuCta = {
  label: "Cotizar por WhatsApp",
  href: waUrl(WA_MESSAGES.cotizar),
  sub: "Te decimos qué necesitas",
  external: true,
};

// ── Servicios destacados — LEÍDOS DE LA COLECCIÓN ──────────────────────────
// AUDITORÍA 2026-09-09 · P2-5: aquí vivía un array literal con los 8 servicios
// (anti-patrón D3: entidad repetible hardcodeada en un .astro). La home y
// /servicios podían divergir sin que nada fallara, y de hecho lo hacían: cinco
// de esos ocho no tenían página propia. Ahora ambas leen la misma colección.
const servicios = (await getCollection("servicios", ({ data }) => !data.draft))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((s) => ({
    title: s.data.cardTitle ?? s.data.title,
    description: s.data.cardDescription ?? s.data.description,
    href: `/servicios/${s.id}/`,
    image: s.data.image,
    imageAlt: s.data.title,
    badge: s.data.badge,
    anchor: SERVICE_ANCHOR[s.id] ?? s.data.title,
  }));

---

<PageLayout
  keywords={KEYWORDS}
  pageType="home"
  schemaData={{ faqs: homeFaqs }}
>
  {/* F3.1 (2026-09-16): se retiró el preload de SHOWCASE[0]. Apuntaba a la
      variante de 1200 px mientras el <img> elige 640 px por srcset (doble
      descarga) y esa tarjeta no es el LCP: el LCP es el texto del hero. */}

  <Hero
    {...homeHero}
    ctas={[
      { text: "Equipos contra incendios", href: "/productos/", variant: "outline" },
      { text: "Cotizar por WhatsApp", href: waUrl(WA_MESSAGES.cotizar), variant: "primary", whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Catálogo: vitrina de categorías (SHOWCASE) ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Catálogo"
        title="Venta de equipo contra incendio:"
        titleAccent="extintores, hidrantes y mangueras"
        desc="Ocho familias de equipo que cubren la protección de la mayoría de los inmuebles, con la norma que respalda cada una."
        body={[
          "Cada inmueble tiene un riesgo distinto, así que el equipo correcto también lo es. Con estas familias equipamos oficinas, comercios, cocinas y escuelas, y también la seguridad industrial de una nave o una planta industrial.",
          "Si no sabes por dónde empezar, escríbenos: revisamos tu caso y te decimos exactamente qué necesitas, sin venderte de más.",
        ]}
      />
      <div class="card-grid">
        {SHOWCASE.map((c, i) => (
          <CategoryCard
            label={c.label}
            href={c.href}
            image={c.image}
            imageAlt={c.imageAlt}
            badge={c.badge}
            blurb={c.blurb}
            subcategories={c.subcategories}
            ctaLabel={c.ctaLabel}
            index={99}
            priority={i === 0}
          />
        ))}
      </div>
    </div>
  </section>

  {/* AUDITORÍA 2026-11-19: aquí se repetían las ocho familias del SHOWCASE como
      secciones H2 (homeCategoryFeatures), justo debajo de la rejilla de tarjetas
      que ya las lista. Contenido duplicado dentro de la misma página. Se
      eliminaron: el detalle de cada familia (features, marcas, imágenes) vive en
      /productos/ (productosCategoryFeatures) y en su página L3, así que no se
      perdió copy. La rejilla de tarjetas es ahora la única entrada al catálogo. */}


  {/* ─── Guía de selección por nivel de riesgo (NOM-002) ─── */}
  <RiskGuide
    eyebrow="Guía de selección"
    title="Cómo se clasifican los equipos"
    titleAccent="contra incendios"
    desc="Una recomendación base por nivel de riesgo, conforme a la NOM-002-STPS-2010."
    body={[
      "El equipo correcto parte de identificar el tipo de riesgo de tu inmueble y lo que puede quemarse. A mayor exposición, como en un inmueble de alto riesgo, hay que subir la densidad de equipo y diseñar un sistema contra incendios más completo.",
      "Esta tabla resume el punto de partida para cada nivel; el diagnóstico afina cantidad, agente y ubicación según tu instalación.",
    ]}
    rows={homeRiskRows}
    note="Cifras orientativas. La NOM-002-STPS pide al menos un extintor por cada 300 m² (riesgo ordinario) o 200 m² (riesgo alto), a no más de 1.5 m de altura. La cantidad exacta, el agente y la ubicación se definen con un diagnóstico según la distribución de tu inmueble."
    ctaLabel="Pide tu diagnóstico por WhatsApp"
    ctaHref={waUrl("Hola, quiero asesoría para saber qué equipo contra incendio necesito según mi riesgo.")}
  />

  {/* ─── Sistemas, detección y equipo de brigada (SEO 2026-11-20) ─── */}
  {/* La home no mencionaba los sistemas fijos, los detectores de humo, las
      alarmas ni el equipo de bombero, que el sitio sí vende y sí tienen su
      página. En vez de duplicar aquí el copy de cada categoría, este bloque
      lo nombra en prosa y enlaza a la categoría que corresponde. */}
  <RelatedLinks
    eyebrow="Protección integral"
    title="Sistemas contra incendio: detectores de humo y alarmas"
    desc="La protección integral de un inmueble combina lo que detecta, lo que avisa y lo que extingue."
    body={[
      "Un extintor resuelve un conato; un sistema contra incendio protege el inmueble completo. Los sistemas de detección —detectores de humo y de calor— y los sistemas de alarma avisan del incendio en su etapa inicial, la red de hidrantes y mangueras da caudal cuando el fuego crece, y los rociadores actúan solos. Lo diseñamos según el riesgo: una oficina no necesita lo mismo que una planta industrial.",
      "Y a quien responde también hay que equiparlo: cascos, trajes de bombero, guantes y botas son lo que permite a la brigada acercarse sin exponerse de más.",
    ]}
    links={[
      { label: "Detección y alarmas", href: "/productos/deteccion-alarmas/", desc: "Detectores de humo y de gas, paneles y sirenas." },
      { label: "Hidrantes y mangueras", href: "/productos/hidrantes-mangueras/", desc: "Gabinetes, mangueras, válvulas y tomas siamesas." },
      { label: "Rociadores y supresión", href: "/productos/rociadores-contra-incendio/", desc: "Sistemas fijos que actúan sin intervención." },
      { label: "Equipo de bombero", href: "/productos/equipo-bombero/", desc: "Casco, chaquetón, guantes y botas de brigada." },
    ]}
  />

  {/* ─── Servicios destacados ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Servicios"
        title="Venta de equipos contra incendios:"
        titleAccent="servicio de instalación y mantenimiento"
        desc="Acompañamos tu protección contra incendio durante toda su vida útil."
        body={[
          "Un equipo contra incendio sirve si está bien elegido, bien instalado y vigente. Por eso ofrecemos el ciclo completo: instalación, mantenimiento preventivo, recarga e inspección.",
          "Todo con servicio conforme a norma y un reporte claro de lo que se hizo.",
        ]}
      />
      <div class="card-grid">
        {servicios.map((s) => (
          <ServiceCard
            title={s.title}
            description={s.description}
            href={s.href}
            image={s.image}
            imageAlt={s.imageAlt}
            badge={s.badge}
            ctaLabel={s.anchor}
          />
        ))}
        {/* Tarjeta de cierre: la colección tiene 7 servicios y el grid es de 4
            columnas, así que la segunda fila quedaba con un hueco. En vez de
            dejarlo vacío, la octava celda es la salida para quien no sabe qué
            servicio pedir — que es el caso más común de este negocio. */}
        <ServiceCard
          title="¿No sabes qué servicio necesitas?"
          description="Cuéntanos giro y superficie y te decimos qué equipo y servicio pide la norma."
          href={waUrl("Hola, no sé qué servicio necesito. ¿Me ayudan a saber qué me pide la norma para mi inmueble?")}
          image="/images/servicios/inspeccion-tablero-alarma-gabinete-manguera.avif"
          imageAlt="Técnico revisando el tablero de alarma y el gabinete de un inmueble"
          badge="Asesoría sin costo"
          ctaLabel="Diagnóstico por WhatsApp"
          whatsapp
        />
      </div>
    </div>
  </section>

  {/* ─── Respaldo normativo (vende cumplimiento) ─── */}
  <NormsTable
    eyebrow="Respaldo normativo"
    title="Equipo certificado NOM y NFPA,"
    titleAccent="documentación para tu expediente"
    desc="No vendemos solo equipo: vendemos que pases la inspección."
    body={[
      "En una inspección, la autoridad no solo verifica que tengas el equipo: revisa que sea equipo contra incendios certificado, vigente y documentado conforme a las Normas Oficiales Mexicanas. Por eso cada entrega llega con su soporte.",
      "Te ayudamos a mapear qué normas aplican a tu giro y a dejar el expediente en regla, con la ficha técnica y la certificación del equipo cuando el fabricante la emite.",
    ]}
    rows={homeNormRows}
    note="Cada entrega incluye ficha técnica y la documentación de servicio para integrar a tu expediente ante Protección Civil y STPS. Las normas NFPA son referencia técnica internacional y, en su caso, requisito de tu aseguradora — no ley federal. Te ayudamos a verificar qué aplica según el giro y tamaño de tu empresa."
  />

  {/* ─── Cómo trabajamos (proceso, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Cómo trabajamos"
    title="De la duda a la seguridad"
    titleAccent="contra incendios"
    desc="Un solo proveedor para cotizar, recibir, instalar y mantener."
    body={[
      "Cada paso lo atiende quien sí sabe: desde el primer WhatsApp hasta la documentación en mano. Sin peloteo entre tres proveedores para un mismo expediente.",
      "Y no termina en la entrega: te acompañamos con el mantenimiento para que tu protección siga vigente.",
    ]}
    steps={homeSteps}
  />

  {/* ─── Sobre el negocio (qué / cómo) ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Quiénes somos"
        title="Una empresa de protección contra incendios,"
        titleAccent="explicada con claridad"
        desc="Equipo correcto, conforme a norma y con asesoría honesta."
        body={[
          "Trabajamos para que tu inmueble esté realmente protegido y en regla, no solo para venderte un equipo. La diferencia está en la asesoría: te decimos qué necesitas y por qué.",
          "Cotiza por WhatsApp y habla directo con quien resuelve.",
        ]}
      />
      <CompanyAbout
        que={homeCompany.que}
        como={homeCompany.como}
        cta={{ label: "Hablar por WhatsApp", href: waLink, external: true }}
      />
    </div>
  </section>

  {/* ─── FAQ + Contacto ─── */}
  {/* ─── Reseñas de clientes (textos reales, con autorización) ─── */}
  <Testimonios items={testimonios} />

  <FAQWithContact items={homeFaqs} waNumber={CONTACT.whatsapp} />

</PageLayout>

<style>
  /* .container/.section/.section--surface: utilidades globales de tokens.css (F3.3). */

  .section {
    padding: var(--sp-8) 0;
  }

  @media (min-width: 1024px) {
    .section {
      padding: var(--sp-10) 0;
    }
  }
</style>
