---
// ============================================================================
// index.astro — HOME de equiposcontraincendio.com
// Sitio de cliente (sin modo guía). Datos 100% desde SSoT (src/config/site.ts)
// y Content Collections. WhatsApp SIEMPRE vía waUrl() (regla D4).
// Contenido HONESTO: sin reseñas/clientes/años fabricados (regla del sistema).
// ============================================================================
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Hero from "@components/Hero.astro";
import SectionMenu from "@components/SectionMenu.astro";
import SectionHeading from "@components/SectionHeading.astro";
import CategoryCard from "@components/CategoryCard.astro";
import ServiceCard from "@components/ServiceCard.astro";
import RiskGuide from "@components/RiskGuide.astro";
import NormsTable from "@components/NormsTable.astro";
import ProcessSteps from "@components/ProcessSteps.astro";
import CompanyAbout from "@components/CompanyAbout.astro";
import FAQWithContact from "@components/FAQWithContact.astro";
import CategoryFeature from "@components/CategoryFeature.astro";
import { KEYWORDS, SECTION_MENU, SECTION_MENU_SUB, SHOWCASE, SERVICE_ANCHOR, WA_MESSAGES, waUrl, CONTACT } from "@config/site";
import {
  homeCategoryFeatures,
  homeCompany,
  homeFaqs,
  homeMenuSub,
  homeNormRows,
  homeRiskRows,
  homeSteps,
} from "@data/home";

const waLink = waUrl();

// ── Menú de secciones bajo el hero (data-driven desde SECTION_MENU de site.ts) ──
const menuSecciones = SECTION_MENU.map((n) => ({
  label: n.label,
  href: n.href,
  sub: homeMenuSub[n.label] ?? SECTION_MENU_SUB[n.label] ?? "Ir a la sección",
}));
const menuCta = {
  label: "Cotizar por WhatsApp",
  href: waUrl(WA_MESSAGES.cotizar),
  sub: "Respuesta inmediata",
  external: true,
};

// ── Servicios destacados — LEÍDOS DE LA COLECCIÓN ──────────────────────────
// AUDITORÍA 2026-09-09 · P2-5: aquí vivía un array literal con los 8 servicios
// (anti-patrón D3: entidad repetible hardcodeada en un .astro). La home y
// /servicios podían divergir sin que nada fallara, y de hecho lo hacían: cinco
// de esos ocho no tenían página propia. Ahora ambas leen la misma colección.
const servicios = (await getCollection("servicios", ({ data }) => !data.draft))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((s) => ({
    title: s.data.title,
    description: s.data.description,
    href: `/servicios/${s.id}/`,
    image: s.data.image,
    imageAlt: s.data.title,
    badge: s.data.badge,
    anchor: SERVICE_ANCHOR[s.id] ?? s.data.title,
  }));

---

<PageLayout
  keywords={KEYWORDS}
  pageType="home"
  guia={false}
  schemaData={{ faqs: homeFaqs }}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={SHOWCASE[0].image} type="image/avif" fetchpriority="high" />
  </Fragment>

  <Hero
    badge="Venta e instalación · CDMX y Estado de México"
    title="Equipo contra incendio en"
    accent="CDMX y Estado de México"
    subtitle="Venta de equipos contra incendios, instalación y mantenimiento: extintores, detección, hidrantes y señalización — con respaldo de norma, para empresas que necesitan estar protegidas y en regla."
    descRight={[
      "En CONINC somos tu proveedor de equipos contra incendios desde hace más de 35 años: extintores portátiles, detección y alarmas contra incendios, hidrantes y mangueras contra incendio, señalización y herrajes. Vendemos, instalamos y damos mantenimiento — todo dimensionado al riesgo real de tu inmueble, no a un catálogo genérico.",
      "Trabajamos conforme a la normatividad mexicana —NOM-002-STPS-2010 y NOM-154-SCFI-2005— con equipo certificado y la documentación lista para tu expediente de Protección Civil. Cotiza por WhatsApp y recibe una recomendación honesta.",
    ]}
    ctas={[
      { text: "Equipos contra incendios", href: "/productos/", variant: "outline" },
      { text: "Cotizar por WhatsApp", href: waUrl(WA_MESSAGES.cotizar), variant: "primary", whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Catálogo: vitrina de categorías (SHOWCASE) ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Catálogo"
        title="Venta de equipos"
        titleAccent="contra incendios"
        desc="Ocho familias de equipo que cubren la protección de la mayoría de los inmuebles, con la norma que respalda cada una."
        body={[
          "Cada inmueble tiene un riesgo distinto, así que el equipo correcto también lo es. Aquí están las familias con las que protegemos oficinas, comercios, cocinas, escuelas e industria.",
          "Si no sabes por dónde empezar, escríbenos: revisamos tu caso y te decimos exactamente qué necesitas, sin venderte de más.",
        ]}
      />
      <div class="card-grid">
        {SHOWCASE.map((c, i) => (
          <CategoryCard
            label={c.label}
            href={c.href}
            image={c.image}
            imageAlt={c.imageAlt}
            badge={c.badge}
            blurb={c.blurb}
            subcategories={c.subcategories}
            ctaLabel={c.ctaLabel}
            index={99}
            priority={i === 0}
          />
        ))}
      </div>
    </div>
  </section>

  {homeCategoryFeatures.map(({ ctaSecondaryMsg, ...feature }, i) => (
    <CategoryFeature
      {...feature}
      anchorId={SHOWCASE[i]?.slug}
      ctaSecondaryLabel={ctaSecondaryMsg ? "Cotizar por WhatsApp" : undefined}
      ctaSecondaryHref={ctaSecondaryMsg ? waUrl(ctaSecondaryMsg) : undefined}
      ctaSecondaryExternal
    />
  ))}





  {/* ─── Guía de selección por nivel de riesgo (NOM-002) ─── */}
  <RiskGuide
    eyebrow="Guía de selección"
    title="Cómo se clasifican los equipos"
    titleAccent="contra incendios"
    desc="Una recomendación base por nivel de riesgo, conforme a la NOM-002-STPS-2010."
    body={[
      "El equipo correcto parte de identificar el tipo de riesgo de tu inmueble y lo que puede quemarse. A mayor exposición, como en un inmueble de alto riesgo, mayor densidad de equipo y sistemas más completos.",
      "Esta tabla resume el punto de partida para cada nivel; el diagnóstico afina cantidad, agente y ubicación según tu instalación.",
    ]}
    rows={homeRiskRows}
    note="Cifras orientativas. La NOM-002-STPS pide al menos un extintor por cada 300 m² (riesgo ordinario) o 200 m² (riesgo alto), a no más de 1.5 m de altura. La cantidad exacta, el agente y la ubicación se definen con un diagnóstico según la distribución de tu inmueble."
    ctaLabel="Pide tu diagnóstico por WhatsApp"
    ctaHref={waUrl("Hola, quiero asesoría para saber qué equipo contra incendio necesito según mi riesgo.")}
  />

  {/* ─── Servicios destacados ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Servicios"
        title="Venta de equipos contra incendios,"
        titleAccent="instalación y mantenimiento"
        desc="Acompañamos tu protección contra incendio durante toda su vida útil."
        body={[
          "Un equipo contra incendio sirve si está bien elegido, bien instalado y vigente. Por eso ofrecemos el ciclo completo: instalación, mantenimiento, recarga e inspección.",
          "Todo con servicio conforme a norma y un reporte claro de lo que se hizo.",
        ]}
      />
      <div class="card-grid">
        {servicios.map((s) => (
          <ServiceCard
            title={s.title}
            description={s.description}
            href={s.href}
            image={s.image}
            imageAlt={s.imageAlt}
            badge={s.badge}
            ctaLabel={s.anchor}
          />
        ))}
        {/* Tarjeta de cierre: la colección tiene 7 servicios y el grid es de 4
            columnas, así que la segunda fila quedaba con un hueco. En vez de
            dejarlo vacío, la octava celda es la salida para quien no sabe qué
            servicio pedir — que es el caso más común de este negocio. */}
        <ServiceCard
          title="¿No sabes qué servicio necesitas?"
          description="Cuéntanos el giro y la superficie de tu inmueble y te decimos qué equipo y qué servicio te pide la norma, sin venderte de más."
          href={waUrl("Hola, no sé qué servicio necesito. ¿Me ayudan a saber qué me pide la norma para mi inmueble?")}
          image="/images/servicios/inspeccion-tablero-alarma-gabinete-manguera.avif"
          imageAlt="Técnico revisando el tablero de alarma y el gabinete de un inmueble"
          badge="Asesoría sin costo"
          ctaLabel="Diagnóstico por WhatsApp"
          whatsapp
        />
      </div>
    </div>
  </section>

  {/* ─── Respaldo normativo (vende cumplimiento) ─── */}
  <NormsTable
    eyebrow="Respaldo normativo"
    title="Equipo certificado y documentación"
    titleAccent="para tu expediente"
    desc="No vendemos solo equipo: vendemos que pases la inspección."
    body={[
      "En una inspección, la autoridad no solo verifica que tengas el equipo: revisa que sea equipo contra incendios certificado, vigente y documentado conforme a las Normas Oficiales Mexicanas. Por eso cada entrega llega con su soporte.",
      "Te ayudamos a mapear qué normas aplican a tu giro y a dejar el expediente en regla.",
    ]}
    rows={homeNormRows}
    note="Cada entrega incluye ficha técnica y la documentación de servicio para integrar a tu expediente ante Protección Civil y STPS. Las normas NFPA son referencia técnica internacional y, en su caso, requisito de tu aseguradora — no ley federal. Te ayudamos a verificar qué aplica según el giro y tamaño de tu empresa."
  />

  {/* ─── Cómo trabajamos (proceso, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Cómo trabajamos"
    title="De la duda a la seguridad"
    titleAccent="contra incendios"
    desc="Un solo proveedor para cotizar, recibir, instalar y mantener."
    body={[
      "Cada paso lo atiende quien sí sabe: desde el primer WhatsApp hasta la documentación en mano. Sin peloteo entre tres proveedores para un mismo expediente.",
      "Y no termina en la entrega: te acompañamos con el mantenimiento para que tu protección siga vigente.",
    ]}
    steps={homeSteps}
  />

  {/* ─── Sobre el negocio (qué / cómo) ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Quiénes somos"
        title="Protección bien hecha,"
        titleAccent="explicada con claridad"
        desc="Equipo correcto, conforme a norma y con asesoría honesta."
        body={[
          "Trabajamos para que tu inmueble esté realmente protegido y en regla, no solo para venderte un equipo. La diferencia está en la asesoría: te decimos qué necesitas y por qué.",
          "Cotiza por WhatsApp y habla directo con quien resuelve.",
        ]}
      />
      <CompanyAbout
        que={homeCompany.que}
        como={homeCompany.como}
        cta={{ label: "Hablar por WhatsApp", href: waLink, external: true }}
      />
    </div>
  </section>

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={homeFaqs} waNumber={CONTACT.whatsapp} />

</PageLayout>

<style>
  /* NO borrar por "duplicada": los estilos de Astro son SCOPED. Esta regla se
  repite en cada página porque cada una tiene su propio data-astro-cid, no
  porque sobre. Se eliminó en el refactor del 2026-09-09 y dejó tres bloques
  de la home sin max-width, sin centrado y sin padding lateral —a todo el
  ancho del viewport— porque el scope de index.astro se quedó sin definición.
  Verificado en el HTML: 3 de los 7 .container de la home dependen de aquí. */
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }

  .section {
    padding: var(--sp-8) 0;
  }

  .section--surface {
    background: var(--c-surface);
  }

  @media (min-width: 1024px) {
    .section {
      padding: var(--sp-10) 0;
    }
  }
</style>
