---
// /cobertura/<slug> — Detalle de zona. Ruta dinámica generada desde
// COVERAGE_STATES (cdmx · edomex). Copy de cara al cliente, específico por zona.
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionHeading from '@components/SectionHeading.astro'
import FAQAccordion from '@components/FAQAccordion.astro'
import SectionMenu from '@components/SectionMenu.astro'
import { COVERAGE_STATES, SERVICES, waUrl } from '@config/site'

export async function getStaticPaths() {
  return COVERAGE_STATES.map((z) => ({ params: { slug: z.slug }, props: { zona: z } }))
}

const { zona } = Astro.props
const { slug, label } = zona

// Detalle real por zona (alcaldías / municipios) para un copy específico, no genérico.
const ZONE_DETAIL: Record<string, { areas: string; examples: string }> = {
  cdmx: {
    areas: 'las 16 alcaldías',
    examples: 'Benito Juárez, Cuauhtémoc, Miguel Hidalgo, Álvaro Obregón, Coyoacán y más',
  },
  edomex: {
    areas: 'los municipios conurbados',
    examples: 'Naucalpan, Tlalnepantla, Ecatepec, Nezahualcóyotl, Cuautitlán y más',
  },
}
const detail = ZONE_DETAIL[slug] ?? { areas: 'toda la zona', examples: 'consúltanos tu ubicación' }
const waZona = waUrl(`Hola, estoy en ${label} y quiero cotizar equipo y/o servicio contra incendio.`)

const faqs = [
  {
    question: `¿Dan servicio en todo ${label}?`,
    answer: `Sí, cubrimos ${detail.areas} de ${label} y sus alrededores. Cuéntanos tu ubicación exacta por WhatsApp y te confirmamos cobertura y tiempos de respuesta.`,
  },
  {
    question: `¿Hacen entrega e instalación en sitio en ${label}?`,
    answer: `Sí. Coordinamos día y hora para entrega de equipo, instalación, mantenimiento o inspección directamente en tu domicilio dentro de ${label}.`,
  },
  {
    question: `¿Atienden fuera de ${label}?`,
    answer: 'Escríbenos tu ubicación por WhatsApp y te confirmamos la cobertura. Para venta de equipo podemos coordinar envíos a otras zonas.',
  },
]

const otras = COVERAGE_STATES.filter((z) => z.slug !== slug)
const cierreItems = [
  ...otras.map((z) => ({ label: z.label, href: `/cobertura/${z.slug}/`, sub: 'Otra zona' })),
  { label: 'Toda la cobertura', href: '/cobertura/', sub: 'Volver a zonas' },
  { label: 'Servicios', href: '/servicios/', sub: 'Lo que ofrecemos' },
]
const cierreCta = { label: `Cotizar en ${label}`, href: waZona, sub: 'Respuesta inmediata', external: true }
---

<PageLayout
  title={`Equipo contra incendio en ${label}`}
  description={`Equipo contra incendio en ${label}: venta, instalación, mantenimiento e inspección con servicio en sitio. Cotiza por WhatsApp — CDMX y Estado de México.`}
  pageType="page"
  breadcrumbs={[{ label: 'Cobertura', href: '/cobertura/' }, { label }]}
  guia={false}
>
  <Hero
    badge={`Cobertura · ${label}`}
    title="Equipo contra incendio en"
    accent={label}
    subtitle={`Venta, instalación, mantenimiento e inspección de equipo contra incendio en ${label}, con servicio en sitio y entrega con documentación.`}
    descRight={[
      `Damos servicio en ${label}: cubrimos ${detail.areas} con visita en sitio para instalar, dar mantenimiento o inspeccionar tu equipo, y entregamos extintores, detección, hidrantes y señalización con factura.`,
      'Cuéntanos tu ubicación exacta y lo que necesitas, y te confirmamos cobertura, tiempos y la mejor opción para tu inmueble. Trabajamos conforme a la NOM-002-STPS y la NOM-154-SCFI.',
    ]}
    ctas={[
      { text: 'Cotizar por WhatsApp', href: waZona, variant: 'primary', whatsapp: true },
      { text: 'Ver catálogo', href: '/productos/', variant: 'outline' },
    ]}
  />

  <section class="section">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Qué cubrimos"
        title="Servicio en"
        titleAccent={label}
        desc={`Alcance y servicios disponibles en ${label}.`}
        body={[
          `Cubrimos ${detail.areas} —${detail.examples}— con servicio en sitio: instalación, mantenimiento, inspección y entrega de equipo contra incendio.`,
          'Atendemos cada zona con el mismo estándar de servicio y producto conforme a norma. Cambia la ubicación; la calidad y el cumplimiento, no.',
        ]}
      />

      <div class="servicios-zona">
        <p class="servicios-zona__lead">Servicios disponibles en {label}:</p>
        <ul class="chips">
          {SERVICES.map((s) => (
            <li><a class="chip" href={`/servicios/${s.id}/`}>{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <FAQAccordion items={faqs} title={`Preguntas sobre la cobertura en ${label}`} openFirst />
    </div>
  </section>

  <SectionMenu items={cierreItems} cta={cierreCta} ariaLabel="Otras zonas y servicios" />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }

  .servicios-zona { margin-top: var(--sp-6); }
  .servicios-zona__lead { font-weight: var(--weight-semibold); color: var(--c-ink); margin: 0 0 var(--sp-3); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .chip {
    display: inline-flex; padding: var(--sp-2) var(--sp-4); border-radius: var(--radius-full);
    background: var(--c-white); border: 1px solid var(--c-border); color: var(--c-ink-2);
    font-size: var(--text-sm); font-weight: var(--weight-medium); text-decoration: none; transition: border-color .15s, color .15s;
  }
  .chip:hover { border-color: var(--c-primary); color: var(--c-primary); }
</style>
