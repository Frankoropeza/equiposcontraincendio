---
// ============================================================================
// /cobertura/<slug> — Ficha de zona homologada al patrón L2/L3.
// ----------------------------------------------------------------------------
// La zona, sus áreas y sus FAQs salen de la colección `zonas`; la plantilla
// añade navegación, confianza, orientación comercial y enlaces internos.
// ============================================================================
import { getCollection, render } from 'astro:content'
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import SectionHeading from '@components/SectionHeading.astro'
import QuoteCard from '@components/QuoteCard.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import { CONTACT, sectionMenuItems, telUrl, waUrl } from '@config/site'
import { relDesc } from '@data/related-desc'

export async function getStaticPaths() {
  const zonas = await getCollection('zonas', ({ data }) => !data.draft)
  const servicios = await getCollection('servicios', ({ data }) => !data.draft)

  return zonas.map((zona) => {
    const disponibles = (zona.data.availableServices ?? []).flatMap((ref) => {
      const hit = servicios.find((service) => service.id === ref.id)
      return hit ? [{ label: hit.data.title, href: `/servicios/${hit.id}/`, desc: relDesc('servicios', hit.id) }] : []
    })
    const otras = zonas
      .filter((other) => other.id !== zona.id)
      .map((other) => ({ label: other.data.zoneName, href: `/cobertura/${other.id}/`, desc: relDesc('zonas', other.id) }))

    return { params: { slug: zona.id }, props: { zona, disponibles, otras } }
  })
}

const { zona, disponibles, otras } = Astro.props
const { data } = zona
const { Content } = await render(zona)
const label = data.zoneName
const areas = data.areas ?? []
const faqs = data.faqs ?? []
const waZona = waUrl(`Hola, estoy en ${label} y quiero cotizar equipo y/o servicio contra incendio.`)
const schemaData = { areaServed: [label], ...(faqs.length ? { faqs } : {}) }
const related = [
  ...otras,
  ...disponibles,
  { label: 'Productos contra incendio', href: '/productos/', desc: 'Extintores, detección, hidrantes y señalización.' },
]
const relatedZona = Array.from(new Map([
  ...related,
  { label: 'Contacto', href: '/contacto/', desc: 'Cotiza equipo y servicio.' },
  { label: 'Herramientas', href: '/herramientas/', desc: 'Calculadoras para tu inmueble.' },
].map((item) => [item.href, item])).values()).slice(0, 4)

---

<PageLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.description}
  image={data.image}
  pageType="page"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Cobertura', href: '/cobertura/' }, { label }]}
  noindex={data.noindex}
>
  <Hero
    badge={data.hero?.badge ?? `Cobertura · ${label}`}
    title={data.hero?.title ?? 'Equipo contra incendio en'}
    accent={data.hero?.title ? undefined : label}
    subtitle={data.hero?.subtitle ?? data.description}
    descRight={[
      `Cuéntanos tu ubicación exacta en ${label} y el tipo de inmueble que necesitas atender.`,
      'Te orientamos sobre el siguiente paso y confirmamos el alcance antes de cotizar.',
    ]}
    ctas={[
      { text: 'Cotizar por WhatsApp', href: waZona, variant: 'primary', whatsapp: true },
      { text: 'Equipos contra incendios', href: '/productos/', variant: 'outline' },
    ]}
  />

  <SectionMenu
    items={sectionMenuItems()}
    cta={{ label: `Cotizar en ${label}`, href: waZona, sub: 'Respuesta por WhatsApp', external: true }}
  />

  <section class="section section--surface">
    <div class="container">
      <div class="guide-grid">
        <article class="prose"><Content /></article>
        <QuoteCard
          title={`Cotiza en ${label}`}
          waLink={waZona}
          telHref={telUrl()}
          eyebrow={`Cotiza en ${label}`}
          items={['Dirección o alcaldía', 'Tipo de inmueble', 'Equipo o servicio que necesitas']}
          showPrice={false}
          ctaLabel="Cotizar por WhatsApp"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Alcance"
        title="Alcance en"
        titleAccent={label}
        desc={areas.length ? `${areas.length} ${data.type === 'ciudad' ? 'alcaldías' : 'municipios'} publicados en esta ficha.` : `Servicio en sitio en ${label}.`}
      />
      {areas.length > 0 && (
        <ul class="chips chips--areas">{areas.map((area) => <li><span class="chip chip--static">{area}</span></li>)}</ul>
      )}
      {disponibles.length > 0 && (
        <div class="servicios-zona">
          <p class="servicios-zona__lead">Servicios relacionados:</p>
          <ul class="chips">{disponibles.map((service) => <li><a class="chip" href={service.href}>{service.label}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <RelatedLinks title="Sigue por aquí" desc="La otra zona, servicios y productos relacionados." links={relatedZona} limit={4} />

  {faqs.length > 0 && <FAQWithContact items={faqs} waNumber={CONTACT.whatsapp} eyebrow="Preguntas frecuentes" title="Preguntas frecuentes" titleAccent={`sobre ${label}`} />}
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .guide-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-8); align-items: start; }
  .guide-grid .prose { max-width: 68ch; }
  @media (min-width: 900px) { .guide-grid { grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem); } }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: var(--sp-2); margin: var(--sp-5) 0 0; padding: 0; }
  .chip { display: inline-flex; align-items: center; min-height: 36px; padding: .4em 1em; font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--c-ink-2); text-decoration: none; background: var(--c-white); border: 1px solid var(--c-border); border-radius: var(--radius-full); }
  a.chip:hover, a.chip:focus-visible { color: #fff; background: var(--c-primary); border-color: var(--c-primary); outline: none; }
  a.chip:focus-visible { outline: 2px solid var(--c-primary); outline-offset: 2px; }
  .chip--static { color: var(--c-muted); }
  .servicios-zona { margin-top: var(--sp-6); }
  .servicios-zona__lead { margin: 0; font-weight: var(--weight-semibold); color: var(--c-ink); }
</style>
