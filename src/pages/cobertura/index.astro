---
// /cobertura/ — Landing L2 de cobertura. Responde «¿me atienden en mi zona,
// con qué alcance y cómo se agenda?». Estructura: Hero → SectionMenu →
// tarjetas de zona → módulos CategoryFeature → Alcance por zona (RiskGuide) →
// NormsTable → ProcessSteps → Sobre la cobertura → Reseñas → RelatedLinks → FAQ.
// El copy vive en src/data/cobertura.ts; esta página solo compone. Sin TrustBar.
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import CategoryFeature from '@components/CategoryFeature.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import RiskGuide from '@components/RiskGuide.astro'
import NormsTable from '@components/NormsTable.astro'
import ProcessSteps from '@components/ProcessSteps.astro'
import CompanyAbout from '@components/CompanyAbout.astro'
import Testimonios from '@components/Testimonios.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import {
  zoneCard,
  zoneFeatures,
  coberturaAlcance,
  coberturaNormRows,
  coberturaSteps,
  coberturaCompany,
  coberturaRelated,
  coberturaFaqs,
  coberturaTestimoniosHead,
  coberturaTestimoniosNombres,
  coberturaFaqHead,
} from '@data/cobertura'
import { cierreCobertura, cierreGeneral, faltanParaCuatro } from '@data/cierre'
import { testimonios } from '@data/testimonios'
import { COVERAGE_STATES, CONTACT, waUrl, WA_MESSAGES, sectionMenuItems } from '@config/site'

const tipoLabel = (t: string) => (t === 'operativo' ? 'Servicio en sitio' : 'Atención a distancia')

// Menú de secciones: subtítulos desde SECTION_MENU_SUB (site.ts), no un mapa
// local — así todas las páginas describen las secciones igual.
const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.cotizar),
  sub: 'Confirmamos tu zona',
  external: true,
}

const coberturaTestimonios = coberturaTestimoniosNombres
  .map((nombre) => testimonios.find((testimonio) => testimonio.nombre === nombre))
  .filter((testimonio): testimonio is (typeof testimonios)[number] => Boolean(testimonio))
---

<PageLayout
  title="Extintores cerca de mí en CDMX y Estado de México"
  description="Venta, recarga y mantenimiento de extintores cerca de ti: servicio en sitio en las 16 alcaldías de la CDMX y en la zona conurbada del Estado de México."
  pageType="category"
  schemaData={{ faqs: coberturaFaqs }}
  breadcrumbs={[{ label: 'Cobertura' }]}
>
  {/* ─── Hero (componente compartido, copy de cara al cliente) ─── */}
  <Hero
    badge="Cobertura · CDMX y Estado de México"
    title="Venta y recarga de extintores"
    accent={"cerca\u00a0de\u00a0ti"}
    subtitle="Servicio en sitio en la Ciudad de México, el Estado de México y la zona metropolitana: venta y recarga de extintores, mantenimiento, instalación e inspección de equipo contra incendio."
    descRight={[
      'Si buscas extintores cerca de ti, vamos a donde está tu inmueble: coordinamos la visita para la venta y la recarga de extintores, el mantenimiento, la instalación o la inspección de tu equipo contra incendio, y entregamos cada extintor con su ficha técnica y su documentación.',
      'Cada zona tiene su página con el detalle de cobertura. Indícanos tu alcaldía o municipio por WhatsApp y te confirmamos el servicio y la fecha de visita.',
    ]}
    ctas={[
      { text: 'Zonas que atendemos', href: '#zonas', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl('Hola, quiero confirmar si dan servicio en mi zona y cotizar equipo contra incendio.'), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />


  {/* ─── Tarjetas de zona ─── */}
  <section class="section section--surface" id="zonas">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Zonas que atendemos"
        title="Extintores y servicio"
        titleAccent="en tu zona"
        desc="Ciudad de México, Estado de México y zona metropolitana — cada una con su página."
        body={[
          'Damos servicio en sitio donde está tu inmueble: venta de extintores, recarga, mantenimiento preventivo, instalación, inspección y entrega de equipo. Elige tu zona para consultar el alcance de cobertura.',
          '¿No ves tu ubicación? Escríbenos por WhatsApp y te confirmamos si llegamos a tu zona.',
        ]}
      />
      <div class="card-grid">
        {COVERAGE_STATES.map((z, i) => (
          <CategoryCard
            label={z.label}
            href={`/cobertura/${z.slug}/`}
            image={zoneCard[z.slug]?.src}
            imageAlt={zoneCard[z.slug]?.alt ?? `Cobertura en ${z.label}`}
            blurb={zoneCard[z.slug]?.blurb ?? `Servicio en sitio en ${z.label}.`}
            badge={zoneCard[z.slug]?.badge ?? tipoLabel(z.type)}
            ctaLabel={zoneCard[z.slug]?.cta ?? `Cobertura en ${z.label}`}
            index={i}
          />
        ))}
        {[...cierreCobertura, ...cierreGeneral].slice(0, faltanParaCuatro(COVERAGE_STATES.length)).map((ficha, i) => (
          <CategoryCard
            label={ficha.title}
            href={ficha.whatsapp ? waUrl(ficha.href) : ficha.href}
            image={ficha.image}
            imageAlt={ficha.imageAlt}
            badge={ficha.badge}
            blurb={ficha.description}
            ctaLabel={ficha.ctaLabel}
            index={COVERAGE_STATES.length + i}
            external={ficha.whatsapp}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Módulos de zona (CategoryFeature) — diseño uniforme, copy propio ─── */}
  {zoneFeatures.map(({ id, ctaSecondaryMsg, ...feature }) => (
    <CategoryFeature
      {...feature}
      anchorId={id}
      ctaSecondaryLabel="Cotizar por WhatsApp"
      ctaSecondaryHref={waUrl(ctaSecondaryMsg)}
      ctaSecondaryExternal
    />
  ))}

  {/* ─── Alcance por zona ─── */}
  <RiskGuide
    eyebrow="Alcance por zona"
    title="Hasta dónde llevamos"
    titleAccent="extintores y servicio"
    desc="Antes de cotizar conviene saber si hay servicio en sitio en tu ubicación."
    body={[
      'No todas las zonas tienen el mismo alcance, y decirlo de frente evita agendar una visita que no se puede cumplir. Aquí está qué incluye cada zona y cómo se coordina.',
      'No publicamos tiempos de respuesta porque dependen de la agenda del día y de la ubicación exacta. La fecha se confirma al agendar, no antes.',
    ]}
    rows={coberturaAlcance}
    columns={['Zona', 'Qué comprende', 'Servicio en sitio', 'Cómo se coordina']}
    note="Si tu inmueble queda fuera del área conurbada, escríbenos con la ubicación exacta: se revisa caso por caso y te decimos si hay servicio en sitio o si conviene resolverlo con envío de equipo."
    ctaLabel="Confirmar mi zona"
    ctaHref={waUrl('Hola, quiero confirmar si dan servicio en sitio en mi ubicación.')}
  />

  {/* ─── Qué pide cada autoridad ─── */}
  <NormsTable
    eyebrow="Norma federal, trámite local"
    title="La norma es la misma,"
    titleAccent="el trámite no"
    desc="Las NOM aplican igual en las dos entidades; el Programa Interno cambia."
    body={[
      'La confusión más frecuente: cumplir la NOM-002 no es lo mismo que tener el Programa Interno en regla. Lo primero es federal; lo segundo lo pide tu entidad, con su propio procedimiento.',
      'Por eso el expediente que sirve en la Ciudad de México no se arma igual que el del Estado de México, aunque el equipo instalado sea idéntico.',
    ]}
    rows={coberturaNormRows}
    columns={['Norma o trámite', 'Qué exige', 'Dónde aplica']}
    note="Los datos del Programa Interno de cada entidad, con su fuente y la fecha en que se verificaron, están en la sección de Protección Civil del sitio."
  />

  {/* ─── Cómo se agenda (proceso, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Cómo se agenda"
    title="De tu ubicación"
    titleAccent="a la visita en sitio"
    desc="Primero se confirma la cobertura; después se cotiza y se agenda."
    body={[
      'Confirmar la zona antes de cotizar evita aceptar una propuesta que después no puede ejecutarse porque el inmueble queda fuera de ruta.',
      'La fecha se fija con la disponibilidad real del día: se confirma una fecha que se pueda cumplir, no un plazo optimista.',
    ]}
    steps={coberturaSteps}
  />

  {/* ─── Sobre la cobertura ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Sobre la cobertura"
        title="Ciudad y Estado de México,"
        titleAccent="un mismo estándar"
        desc="El mismo criterio técnico para una oficina en la ciudad que para una nave en el estado."
        body={[
          'Cada visita se atiende con el mismo procedimiento, la misma evidencia y el mismo seguimiento de vigencia, sin importar la entidad.',
          'Dinos tu ubicación por WhatsApp y te confirmamos cobertura antes de cualquier compromiso.',
        ]}
      />
      <CompanyAbout
        que={coberturaCompany.que}
        como={coberturaCompany.como}
        cta={{ label: 'Confirmar cobertura', href: waUrl('Hola, quiero confirmar si dan servicio en sitio en mi ubicación.'), external: true }}
      />
    </div>
  </section>

  {/* ─── Reseñas de cobertura ─── */}
  <Testimonios items={coberturaTestimonios} {...coberturaTestimoniosHead} />

  {/* ─── Interlinking a las otras secciones ─── */}
  <RelatedLinks
    title="Sigue por aquí"
    desc="Lo que suele preguntarse junto con la cobertura."
    links={coberturaRelated}
    limit={4}
  />

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={coberturaFaqs} waNumber={CONTACT.whatsapp} {...coberturaFaqHead} />
</PageLayout>

<style>
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }

  .section {
    padding: var(--sp-8) 0;
  }

  .section--surface {
    background: var(--c-surface);
  }

  @media (min-width: 768px) {
    .section {
      padding: var(--sp-10) 0;
    }
  }
</style>
