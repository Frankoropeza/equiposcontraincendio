---
// /cobertura/ — Landing de Cobertura (zonas atendidas). L2 HOMOLOGADA con
// /productos y /servicios: Hero → SectionMenu → TrustBar → tarjetas →
// módulos CategoryFeature → FAQ. Copy de cara al cliente (sin meta-SEO).
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import TrustBar from '@components/TrustBar.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import CategoryFeature from '@components/CategoryFeature.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import { COVERAGE_STATES, NAV, CONTACT, waUrl, WA_MESSAGES } from '@config/site'

const tipoLabel = (t: string) => (t === 'operativo' ? 'Servicio en sitio' : 'Atención a distancia')

// ── Menú de secciones bajo el hero (data-driven desde NAV; excluye Contacto) ──
const menuSub: Record<string, string> = {
  Productos: 'Catálogo de equipo',
  Servicios: 'Instalación y mantenimiento',
  Cobertura: 'Zonas que atendemos',
  Blog: 'Guías y normatividad',
}
const menuSecciones = NAV.filter((n) => n.label !== 'Contacto').map((n) => ({
  label: n.label,
  href: n.href,
  sub: menuSub[n.label] ?? 'Ver sección',
}))
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.cotizar),
  sub: 'Respuesta inmediata',
  external: true,
}

// ── Barra de confianza (pilares honestos) ──
const pillars = [
  { icon: 'pin', title: 'CDMX y Estado de México', desc: 'Servicio en sitio en la ciudad, el EdoMex y la zona metropolitana.' },
  { icon: 'clock', title: 'Visita y entrega en sitio', desc: 'Coordinamos día y hora para instalación, mantenimiento o entrega.' },
  { icon: 'doc', title: 'Documentación local', desc: 'Constancias para Protección Civil de tu alcaldía o municipio.' },
  { icon: 'chat', title: 'Cotiza por WhatsApp', desc: 'Dinos tu ubicación y te confirmamos cobertura y tiempos.' },
]

// ── Imagen por zona (para las tarjetas) ──
const ZONE_IMG: Record<string, string> = {
  cdmx: '/images/zonas/cobertura-cdmx.svg',
  edomex: '/images/zonas/cobertura-edomex.svg',
}

// ── Módulos de zona (CategoryFeature) — copy propio, diseño uniforme ──
const ZONE_FEATURES = [
  {
    eyebrow: 'Cobertura · Ciudad de México · Servicio en sitio',
    title: 'Servicio directo en',
    titleAccent: 'toda la Ciudad de México',
    description:
      'Operamos en la Ciudad de México con visita en sitio para venta, instalación, mantenimiento e inspección de equipo contra incendio. Cubrimos las 16 alcaldías y entregamos el equipo con la documentación que pide Protección Civil de la CDMX.',
    features: [
      { label: 'Las 16 alcaldías', desc: 'de Álvaro Obregón a Xochimilco; visita y entrega en sitio.' },
      { label: 'Servicio directo en sitio', desc: 'instalación, mantenimiento e inspección presenciales.' },
      { label: 'Entrega de equipo con factura', desc: 'extintores, detección, hidrantes y señalización.' },
      { label: 'Trámite ante PC-CDMX', desc: 'documentación y constancias para tu expediente de Protección Civil.' },
    ],
    ctaLabel: 'Cotizar en CDMX',
    ctaMsg: 'Hola, estoy en la Ciudad de México y quiero cotizar equipo y/o servicio contra incendio.',
    imgMain: { src: '/images/zonas/cobertura-cdmx.svg', alt: 'Cobertura de equipo contra incendio en la Ciudad de México' },
    imgA: { src: '/images/servicios/instalacion-sistemas-contra-incendio.svg', alt: 'Instalación de sistemas contra incendio en CDMX' },
    imgB: { src: '/images/servicios/mantenimiento-recarga-extintores.svg', alt: 'Mantenimiento y recarga de extintores en CDMX' },
  },
  {
    eyebrow: 'Cobertura · Estado de México · Servicio en sitio',
    title: 'Cobertura en la zona',
    titleAccent: 'metropolitana y EdoMex',
    description:
      'Atendemos el Estado de México y la zona metropolitana con servicio en sitio. Cubrimos los municipios conurbados —Naucalpan, Tlalnepantla, Ecatepec, Nezahualcóyotl, Cuautitlán y más— para venta, instalación, mantenimiento e inspección de tu equipo contra incendio.',
    features: [
      { label: 'Municipios conurbados', desc: 'Naucalpan, Tlalnepantla, Ecatepec, Neza, Cuautitlán y zona metropolitana.' },
      { label: 'Servicio directo en sitio', desc: 'instalación, mantenimiento e inspección presenciales.' },
      { label: 'Entrega y suministro', desc: 'equipo contra incendio con factura y ficha técnica.' },
      { label: 'Documentación local', desc: 'constancias para Protección Civil municipal y STPS.' },
    ],
    ctaLabel: 'Cotizar en EdoMex',
    ctaMsg: 'Hola, estoy en el Estado de México y quiero cotizar equipo y/o servicio contra incendio.',
    imgMain: { src: '/images/zonas/cobertura-edomex.svg', alt: 'Cobertura de equipo contra incendio en el Estado de México' },
    imgA: { src: '/images/servicios/inspeccion-dictamen-contra-incendio.svg', alt: 'Inspección de equipo contra incendio en EdoMex' },
    imgB: { src: '/images/servicios/suministro-equipo-contra-incendio.svg', alt: 'Suministro de equipo contra incendio en EdoMex' },
  },
]

const faqs = [
  {
    question: '¿Qué zonas atienden?',
    answer: 'Damos servicio en sitio en la Ciudad de México, el Estado de México y la zona metropolitana. Si estás en otra ubicación, escríbenos y te confirmamos si podemos llegar o atenderte a distancia.',
  },
  {
    question: '¿Cobran por el traslado o la visita?',
    answer: 'Depende de la zona y del servicio. Para la mayoría de CDMX y EdoMex la visita va incluida en el servicio; si hay algún costo de traslado, te lo decimos claro al cotizar, antes de cualquier compromiso.',
  },
  {
    question: '¿Hacen entregas a domicilio del equipo?',
    answer: 'Sí. Entregamos extintores, detección, señalización e hidrantes en CDMX y Estado de México, con factura y ficha técnica. Coordinamos día y hora por WhatsApp.',
  },
  {
    question: '¿En cuánto tiempo pueden ir?',
    answer: 'Depende de la disponibilidad de agenda y de tu ubicación. Cuéntanos qué necesitas y dónde estás, y te confirmamos la fecha más próxima de visita o entrega.',
  },
  {
    question: '¿Atienden fuera de CDMX y Estado de México?',
    answer: 'Para venta de equipo podemos coordinar envíos a otras zonas; para instalación y mantenimiento en sitio, consúltanos según la ubicación. Escríbenos y lo revisamos.',
  },
]
---

<PageLayout
  title="Cobertura — CDMX y Estado de México"
  description="Cobertura de equipo contra incendio: servicio en sitio en la Ciudad de México, el Estado de México y la zona metropolitana. Cotiza por WhatsApp."
  pageType="category"
  schemaData={{ faqs }}
  breadcrumbs={[{ label: 'Cobertura' }]}
  guia={false}
>
  {/* ─── Hero (componente compartido, copy de cara al cliente) ─── */}
  <Hero
    badge="Cobertura · CDMX y Estado de México"
    title="Estamos donde"
    accent="está tu inmueble"
    subtitle="Servicio en sitio en la Ciudad de México, el Estado de México y la zona metropolitana: venta, instalación, mantenimiento e inspección de equipo contra incendio."
    descRight={[
      'Atendemos donde está tu inmueble. Coordinamos la visita para instalar, dar mantenimiento o inspeccionar tu equipo contra incendio, y entregamos el producto con su documentación.',
      'Cada zona tiene su página con el detalle de cobertura. Dinos tu alcaldía o municipio y te confirmamos servicio y tiempos por WhatsApp.',
    ]}
    ctas={[
      { text: 'Ver zonas', href: '#zonas', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl('Hola, quiero confirmar si dan servicio en mi zona y cotizar equipo contra incendio.'), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Barra de confianza (pilares honestos) ─── */}
  <TrustBar items={pillars} />

  {/* ─── Tarjetas de zona ─── */}
  <section class="section section--surface" id="zonas">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Zonas que atendemos"
        title="Servicio en"
        titleAccent="tu zona"
        desc="Ciudad de México, Estado de México y zona metropolitana — cada una con su página."
        body={[
          'Damos servicio en sitio donde está tu inmueble: instalación, mantenimiento, inspección y entrega de equipo. Elige tu zona para ver el detalle de cobertura.',
          '¿No ves tu ubicación? Escríbenos por WhatsApp y te confirmamos si llegamos a tu zona.',
        ]}
      />
      <div class="grid">
        {COVERAGE_STATES.map((z, i) => (
          <CategoryCard
            label={z.label}
            href={`/cobertura/${z.slug}/`}
            image={ZONE_IMG[z.slug]}
            imageAlt={`Cobertura en ${z.label}`}
            blurb={`Servicio en sitio en ${z.label}: venta, instalación, mantenimiento e inspección de equipo contra incendio.`}
            badge={tipoLabel(z.type)}
            ctaLabel="Ver zona"
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Módulos de zona (CategoryFeature) — diseño uniforme, copy propio ─── */}
  {ZONE_FEATURES.map((c) => (
    <CategoryFeature
      eyebrow={c.eyebrow}
      title={c.title}
      titleAccent={c.titleAccent}
      description={c.description}
      features={c.features}
      ctaLabel={c.ctaLabel}
      ctaHref={waUrl(c.ctaMsg)}
      ctaExternal
      imgMain={c.imgMain}
      imgA={c.imgA}
      imgB={c.imgB}
    />
  ))}

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={faqs} waNumber={CONTACT.whatsapp} />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); margin-top: var(--sp-6); }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
