---
// /cobertura/ — Landing de Cobertura (zonas atendidas). L2 HOMOLOGADA con
// /productos y /servicios: Hero → SectionMenu → TrustBar → tarjetas →
// módulos CategoryFeature → FAQ. Copy de cara al cliente (sin meta-SEO).
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import TrustBar from '@components/TrustBar.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import CategoryFeature from '@components/CategoryFeature.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import RiskGuide from '@components/RiskGuide.astro'
import NormsTable from '@components/NormsTable.astro'
import ProcessSteps from '@components/ProcessSteps.astro'
import CompanyAbout from '@components/CompanyAbout.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import {
  zoneCard,
  zoneFeatures,
  coberturaAlcance,
  coberturaNormRows,
  coberturaSteps,
  coberturaCompany,
  coberturaRelated,
} from '@data/cobertura'
import { COVERAGE_STATES, CONTACT, waUrl, WA_MESSAGES, sectionMenuItems } from '@config/site'

const tipoLabel = (t: string) => (t === 'operativo' ? 'Servicio en sitio' : 'Atención a distancia')

// Menú de secciones: subtítulos desde SECTION_MENU_SUB (site.ts), no un mapa
// local — así todas las páginas describen las secciones igual.
const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.cotizar),
  sub: 'Respuesta inmediata',
  external: true,
}

// ── Barra de confianza (pilares honestos) ──
const pillars = [
  { icon: 'pin', title: 'CDMX y Estado de México', desc: 'Servicio en sitio en la ciudad, el EdoMex y la zona metropolitana.' },
  { icon: 'clock', title: 'Visita y entrega en sitio', desc: 'Coordinamos día y hora para instalación, mantenimiento o entrega.' },
  { icon: 'doc', title: 'Documentación local', desc: 'Constancias para Protección Civil de tu alcaldía o municipio.' },
  { icon: 'chat', title: 'Cotiza por WhatsApp', desc: 'Dinos tu ubicación y te confirmamos cobertura y tiempos.' },
]

const faqs = [
  {
    question: '¿Qué zonas atienden?',
    answer: 'Damos servicio en sitio en la Ciudad de México, el Estado de México y la zona metropolitana. Si estás en otra ubicación, escríbenos y te confirmamos si podemos llegar o atenderte a distancia.',
  },
  {
    question: '¿Cobran por el traslado o la visita?',
    answer: 'Depende de la zona y del servicio. Para la mayoría de CDMX y EdoMex la visita va incluida en el servicio; si hay algún costo de traslado, te lo decimos claro al cotizar, antes de cualquier compromiso.',
  },
  {
    question: '¿Hacen entregas a domicilio del equipo?',
    answer: 'Sí. Entregamos extintores, detección, señalización e hidrantes en CDMX y Estado de México, con factura y ficha técnica. Coordinamos día y hora por WhatsApp.',
  },
  {
    question: '¿En cuánto tiempo pueden ir?',
    answer: 'Depende de la disponibilidad de agenda y de tu ubicación. Cuéntanos qué necesitas y dónde estás, y te confirmamos la fecha más próxima de visita o entrega.',
  },
  {
    question: '¿Atienden fuera de CDMX y Estado de México?',
    answer: 'Para venta de equipo podemos coordinar envíos a otras zonas; para instalación y mantenimiento en sitio, consúltanos según la ubicación. Escríbenos y lo revisamos.',
  },
]
---

<PageLayout
  title="Cobertura — CDMX y Estado de México"
  description="Cobertura de equipo contra incendio: servicio en sitio en la Ciudad de México, el Estado de México y la zona metropolitana. Cotiza por WhatsApp."
  pageType="category"
  schemaData={{ faqs }}
  breadcrumbs={[{ label: 'Cobertura' }]}
  guia={false}
>
  {/* ─── Hero (componente compartido, copy de cara al cliente) ─── */}
  <Hero
    badge="Cobertura · CDMX y Estado de México"
    title="Estamos donde"
    accent="está tu inmueble"
    subtitle="Servicio en sitio en la Ciudad de México, el Estado de México y la zona metropolitana: venta, instalación, mantenimiento e inspección de equipo contra incendio."
    descRight={[
      'Atendemos donde está tu inmueble. Coordinamos la visita para instalar, dar mantenimiento o inspeccionar tu equipo contra incendio, y entregamos el producto con su documentación.',
      'Cada zona tiene su página con el detalle de cobertura. Dinos tu alcaldía o municipio y te confirmamos servicio y tiempos por WhatsApp.',
    ]}
    ctas={[
      { text: 'Zonas que atendemos', href: '#zonas', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl('Hola, quiero confirmar si dan servicio en mi zona y cotizar equipo contra incendio.'), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Barra de confianza (pilares honestos) ─── */}
  <TrustBar items={pillars} />

  {/* ─── Tarjetas de zona ─── */}
  <section class="section section--surface" id="zonas">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Zonas que atendemos"
        title="Servicio en"
        titleAccent="tu zona"
        desc="Ciudad de México, Estado de México y zona metropolitana — cada una con su página."
        body={[
          'Damos servicio en sitio donde está tu inmueble: instalación, mantenimiento, inspección y entrega de equipo. Elige tu zona para ver el detalle de cobertura.',
          '¿No ves tu ubicación? Escríbenos por WhatsApp y te confirmamos si llegamos a tu zona.',
        ]}
      />
      <div class="grid">
        {COVERAGE_STATES.map((z, i) => (
          <CategoryCard
            label={z.label}
            href={`/cobertura/${z.slug}/`}
            image={zoneCard[z.slug]?.src}
            imageAlt={zoneCard[z.slug]?.alt ?? `Cobertura en ${z.label}`}
            blurb={zoneCard[z.slug]?.blurb ?? `Servicio en sitio en ${z.label}.`}
            badge={zoneCard[z.slug]?.badge ?? tipoLabel(z.type)}
            ctaLabel={zoneCard[z.slug]?.cta ?? `Cobertura en ${z.label}`}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Módulos de zona (CategoryFeature) — diseño uniforme, copy propio ─── */}
  {zoneFeatures.map((c) => (
    <CategoryFeature
      anchorId={c.id}
      eyebrow={c.eyebrow}
      title={c.title}
      titleAccent={c.titleAccent}
      description={c.description}
      features={c.features}
      ctaLabel={c.ctaLabel}
      ctaHref={waUrl(c.ctaMsg)}
      ctaExternal
      ctaSecondaryLabel={c.ctaSecondaryLabel}
      ctaSecondaryHref={c.ctaSecondaryHref}
      imgMain={c.imgMain}
      imgA={c.imgA}
      imgB={c.imgB}
    />
  ))}

  {/* ─── Alcance por zona ─── */}
  <RiskGuide
    eyebrow="Alcance por zona"
    title="Hasta dónde llegamos"
    titleAccent="y con qué alcance"
    desc="Antes de cotizar conviene saber si hay servicio en sitio en tu ubicación."
    body={[
      'No todas las zonas tienen el mismo alcance, y decirlo de frente evita agendar una visita que no se puede cumplir. Aquí está qué incluye cada zona y cómo se coordina.',
      'No publicamos tiempos de respuesta porque dependen de la agenda del día y de la ubicación exacta. La fecha se confirma al agendar, no antes.',
    ]}
    rows={coberturaAlcance}
    columns={['Zona', 'Qué comprende', 'Servicio en sitio', 'Cómo se coordina']}
    note="Si tu inmueble queda fuera del área conurbada, escríbenos con la ubicación exacta: se revisa caso por caso y te decimos si hay servicio en sitio o si conviene resolverlo con envío de equipo."
    ctaLabel="Confirmar mi zona"
    ctaHref={waUrl('Hola, quiero confirmar si dan servicio en sitio en mi ubicación.')}
  />

  {/* ─── Qué pide cada autoridad ─── */}
  <NormsTable
    eyebrow="Norma federal, trámite local"
    title="La norma es la misma,"
    titleAccent="el trámite no"
    desc="Las NOM aplican igual en las dos entidades; el Programa Interno cambia."
    body={[
      'La confusión más común de esta página: cumplir la NOM-002 no es lo mismo que tener el Programa Interno en regla. Lo primero es federal; lo segundo lo pide tu entidad, con su propio procedimiento.',
      'Por eso el expediente que sirve en la Ciudad de México no se arma igual que el del Estado de México, aunque el equipo instalado sea idéntico.',
    ]}
    rows={coberturaNormRows}
    columns={['Norma o trámite', 'Qué exige', 'Dónde aplica']}
    note="Los datos del Programa Interno de cada entidad, con su fuente y la fecha en que se verificaron, están en la sección de Protección Civil del sitio."
  />

  {/* ─── Cómo se agenda (proceso, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Cómo se agenda"
    title="De tu ubicación"
    titleAccent="a la visita en sitio"
    desc="Primero se confirma la cobertura; después se cotiza y se agenda."
    body={[
      'Confirmar la zona antes de cotizar evita el problema clásico: una propuesta aceptada que después no se puede ejecutar porque el inmueble queda fuera de ruta.',
      'La fecha se fija con la disponibilidad real del día. Preferimos decir «el jueves» y cumplirlo, a prometer «hoy mismo» y fallar.',
    ]}
    steps={coberturaSteps}
  />

  {/* ─── Sobre la cobertura ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Sobre la cobertura"
        title="Dos entidades,"
        titleAccent="un mismo estándar"
        desc="El mismo criterio técnico para una oficina en la ciudad que para una nave en el estado."
        body={[
          'Servicio en sitio significa que el técnico va a tu inmueble con el equipo y la herramienta, no que se resuelve por teléfono.',
          'Dinos tu ubicación por WhatsApp y te confirmamos cobertura antes de cualquier compromiso.',
        ]}
      />
      <CompanyAbout
        que={coberturaCompany.que}
        como={coberturaCompany.como}
        cta={{ label: 'Confirmar cobertura', href: waUrl('Hola, quiero confirmar si dan servicio en sitio en mi ubicación.'), external: true }}
      />
    </div>
  </section>

  {/* ─── Interlinking a las otras secciones ─── */}
  <RelatedLinks
    title="Sigue por aquí"
    desc="Lo que suele preguntarse junto con la cobertura."
    links={coberturaRelated}
    limit={4}
  />

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={faqs} waNumber={CONTACT.whatsapp} />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); margin-top: var(--sp-6); }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
