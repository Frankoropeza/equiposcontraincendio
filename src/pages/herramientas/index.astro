---
// ============================================================================
// /herramientas/ — Hub de herramientas de utilidad pública (L2).
// ----------------------------------------------------------------------------
// HOMOLOGADA con /productos y /servicios: Hero → SectionMenu → TrustBar →
// SectionHeading + tarjetas CategoryCard → ProcessSteps ("cómo funcionan") →
// FAQ + contacto → SectionMenu de cierre. Mismos componentes compartidos;
// copy propio. Antes esta página se quedaba en Hero + tarjetas y sin más
// contenido, así que se veía pobre frente a /productos (459 líneas) y
// /servicios (233 líneas, con TrustBar + módulos + FAQ).
//
// Listado data-driven desde TOOLS (src/config/site.ts).
// Schema: CollectionPage + ItemList con las herramientas publicadas + FAQPage.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import TrustBar from '@components/TrustBar.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import ProcessSteps from '@components/ProcessSteps.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import { TOOLS, CONTACT, waUrl, WA_MESSAGES, sectionMenuItems } from '@config/site'

const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.default),
  sub: 'Respuesta inmediata',
  external: true,
}

const cierreItems = [
  { label: 'Formatos descargables', href: '/plantillas/', sub: 'Bitácora, acta y censo' },
  { label: 'Protección Civil', href: '/proteccion-civil/', sub: 'Qué exige por entidad' },
  { label: 'Catálogo', href: '/productos/', sub: 'Equipo contra incendio' },
  { label: 'Blog', href: '/blog/', sub: 'Guías y normatividad' },
]
const cierreCta = {
  label: 'Pedir diagnóstico',
  href: waUrl('Hola, usé sus herramientas y quiero un diagnóstico de mi inmueble.'),
  sub: 'CDMX y Estado de México',
  external: true,
}

// ── Barra de confianza (pilares honestos, vía componente TrustBar) ──
const pillars = [
  { icon: 'check', title: 'Gratis y sin registro', desc: 'Sin correo, sin cuenta y sin letras chiquitas: usa la herramienta y ve tu resultado al instante.' },
  { icon: 'doc', title: 'Basadas en la norma', desc: 'Cada criterio cita de dónde sale: NOM-002-STPS-2010 y NOM-154-SCFI-2005.' },
  { icon: 'shield', title: 'Orientan, no dictaminan', desc: 'Dan un punto de partida claro; el estudio o dictamen formal lo elabora y lo firma quien está facultado.' },
  { icon: 'chat', title: 'Atención por WhatsApp', desc: '¿Tu resultado da riesgo alto o no sabes cómo seguir? Escríbenos y te orientamos sin costo.' },
]

// ── Cómo funcionan (ProcessSteps, fondo oscuro) ──
const comoFuncionaSteps = [
  { num: '01', title: 'Elige tu pregunta', desc: 'Riesgo de incendio, cuántos extintores necesitas o si tu equipo actual está en regla: cada herramienta resuelve una duda concreta.' },
  { num: '02', title: 'Captura los datos de tu inmueble', desc: 'Superficie, inventario de sustancias o los doce puntos de revisión: información que ya conoces de tu negocio, sin trámites.' },
  { num: '03', title: 'Obtén tu resultado con su criterio', desc: 'Ves el resultado y la norma exacta de la que sale, para no tener que interpretarla tú mismo.' },
  { num: '04', title: 'Decide tu siguiente paso', desc: 'Si necesitas equipo, servicio o una segunda opinión, cotiza por WhatsApp con el resultado ya en mano.' },
]

// ── FAQ propio de herramientas ──
const faqs = [
  {
    question: '¿Estas herramientas sustituyen un dictamen o estudio oficial?',
    answer: 'No. Orientan y te dan un punto de partida con el mismo criterio que aplica la autoridad, pero el estudio o dictamen formal para tu expediente ante Protección Civil o STPS lo debe elaborar y firmar quien está facultado para ello. Si quieres que lo hagamos nosotros, escríbenos.',
  },
  {
    question: '¿Necesito registrarme o dar mi correo para usarlas?',
    answer: 'No. Las tres son gratuitas, sin registro y sin necesidad de correo: capturas tus datos, ves tu resultado al instante y decides si quieres compartirlo con nosotros por WhatsApp.',
  },
  {
    question: '¿Mis datos se guardan o los ve alguien más?',
    answer: 'No. El cálculo se hace en tu navegador; no guardamos ni enviamos tus datos a ningún lado, salvo que tú decidas compartirlos al escribirnos.',
  },
  {
    question: '¿Qué pasa si mi resultado da riesgo alto o mi extintor no pasa la verificación?',
    answer: 'Son la señal de que conviene revisar tu caso con más detalle. Escríbenos con tu resultado y te decimos qué corregir primero, sin compromiso.',
  },
  {
    question: '¿Tengo que ser cliente suyo para usarlas?',
    answer: 'No. Funcionan igual si eres cliente nuestro o no: son de utilidad pública, pensadas para cualquier empresa que necesite resolver estas tres preguntas.',
  },
  {
    question: '¿En qué normas se basan?',
    answer: 'La clasificación de riesgo y el mínimo de extintores salen de la NOM-002-STPS-2010; la verificación del servicio, de la NOM-154-SCFI-2005. Cada herramienta cita el artículo o tabla exacta de la que sale su número.',
  },
]

const schemaData = {
  list: {
    name: 'Herramientas de seguridad contra incendio',
    description:
      'Calculadoras y verificadores gratuitos para clasificar el riesgo de incendio, calcular extintores y revisar el estado de tu equipo.',
    path: '/herramientas/',
    items: TOOLS.map((t) => ({
      name: t.label,
      path: `/herramientas/${t.slug}/`,
      image: t.image,
      description: t.desc,
    })),
  },
  faqs,
}
---

<PageLayout
  title="Herramientas contra incendio gratuitas"
  description="Calculadoras y verificadores gratuitos: clasifica el riesgo de incendio de tu centro de trabajo, calcula cuántos extintores necesitas y revisa si el mantenimiento de tu equipo es real."
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Herramientas' }]}
  guia={false}
>
  <Hero
    badge="Gratis y sin registro"
    title="Herramientas para saber"
    accent="qué te exige la norma"
    subtitle="Tres herramientas que resuelven las preguntas con las que empieza cualquier empresa: en qué grado de riesgo estoy, cuánto equipo necesito y si el que ya tengo está en regla."
    descRight={[
      'Aplican los criterios de la NOM-002-STPS-2010 y de la NOM-154-SCFI-2005, y cada una cita de dónde sale su número. Sin registro, sin correo y sin letras chiquitas.',
      'Orientan, no dictaminan: el estudio o el dictamen formal lo elabora y lo firma quien está facultado. Si prefieres que lo hagamos nosotros, escríbenos.',
    ]}
    ctas={[
      { text: 'Equipos contra incendios', href: '/productos/', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.default), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Barra de confianza (pilares honestos) ─── */}
  <TrustBar items={pillars} />

  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Herramientas"
        title="Calcula, clasifica y"
        titleAccent="verifica"
        desc="Cada herramienta cita la norma de la que sale su criterio."
        body={[
          'Las hicimos porque son las tres preguntas que más nos llegan por WhatsApp antes de una cotización: qué grado de riesgo tengo, cuántos extintores me piden y si el servicio que me dieron el año pasado sirvió de algo.',
          'Son gratuitas, no piden registro y funcionan igual si eres cliente nuestro o no.',
        ]}
      />

      <div class="grid">
        {TOOLS.map((t, i) => (
          <CategoryCard
            label={t.label}
            href={`/herramientas/${t.slug}/`}
            image={t.image}
            imageAlt={t.imageAlt}
            badge={t.norm}
            blurb={t.desc}
            ctaLabel="Abrir herramienta"
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Cómo funcionan (ProcessSteps, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Cómo funcionan"
    title="Cuatro pasos y"
    titleAccent="tienes tu respuesta"
    desc="Sin trámites ni tecnicismos: capturas lo que ya sabes de tu inmueble y la herramienta hace el cálculo."
    steps={comoFuncionaSteps}
  />

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={faqs} waNumber={CONTACT.whatsapp} />

  <SectionMenu items={cierreItems} cta={cierreCta} ariaLabel="Sigue explorando el sitio" />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); margin-top: var(--sp-6); }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
