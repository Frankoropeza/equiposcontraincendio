---
// ============================================================================
// /herramientas/ — Hub de herramientas de utilidad pública (L2).
// ----------------------------------------------------------------------------
// HOMOLOGADA con /productos y /servicios: Hero → SectionMenu → SectionHeading +
// tarjetas CategoryCard → SectionMenu de cierre. Mismos componentes
// compartidos; copy propio. Antes esta página tenía su propio encabezado y sus
// propias tarjetas, así que se veía como de otro sitio.
//
// Listado data-driven desde TOOLS (src/config/site.ts).
// Schema: CollectionPage + ItemList con las herramientas publicadas.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import { TOOLS, waUrl, WA_MESSAGES, sectionMenuItems } from '@config/site'

const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.default),
  sub: 'Respuesta inmediata',
  external: true,
}

const cierreItems = [
  { label: 'Formatos descargables', href: '/plantillas/', sub: 'Bitácora, acta y censo' },
  { label: 'Protección Civil', href: '/proteccion-civil/', sub: 'Qué exige por entidad' },
  { label: 'Catálogo', href: '/productos/', sub: 'Equipo contra incendio' },
  { label: 'Blog', href: '/blog/', sub: 'Guías y normatividad' },
]
const cierreCta = {
  label: 'Pedir diagnóstico',
  href: waUrl('Hola, usé sus herramientas y quiero un diagnóstico de mi inmueble.'),
  sub: 'CDMX y Estado de México',
  external: true,
}

const schemaData = {
  list: {
    name: 'Herramientas de seguridad contra incendio',
    description:
      'Calculadoras y verificadores gratuitos para clasificar el riesgo de incendio, calcular extintores y revisar el estado de tu equipo.',
    path: '/herramientas/',
    items: TOOLS.map((t) => ({
      name: t.label,
      path: `/herramientas/${t.slug}/`,
      image: t.image,
      description: t.desc,
    })),
  },
}
---

<PageLayout
  title="Herramientas contra incendio gratuitas"
  description="Calculadoras y verificadores gratuitos: clasifica el riesgo de incendio de tu centro de trabajo, calcula cuántos extintores necesitas y revisa si el mantenimiento de tu equipo es real."
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Herramientas' }]}
  guia={false}
>
  <Hero
    badge="Gratis y sin registro"
    title="Herramientas para saber"
    accent="qué te exige la norma"
    subtitle="Tres herramientas que resuelven las preguntas con las que empieza cualquier empresa: en qué grado de riesgo estoy, cuánto equipo necesito y si el que ya tengo está en regla."
    descRight={[
      'Aplican los criterios de la NOM-002-STPS-2010 y de la NOM-154-SCFI-2005, y cada una cita de dónde sale su número. Sin registro, sin correo y sin letras chiquitas.',
      'Orientan, no dictaminan: el estudio o el dictamen formal lo elabora y lo firma quien está facultado. Si prefieres que lo hagamos nosotros, escríbenos.',
    ]}
    ctas={[
      { text: 'Ver catálogo', href: '/productos/', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.default), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Herramientas"
        title="Calcula, clasifica y"
        titleAccent="verifica"
        desc="Cada herramienta cita la norma de la que sale su criterio."
        body={[
          'Las hicimos porque son las tres preguntas que más nos llegan por WhatsApp antes de una cotización: qué grado de riesgo tengo, cuántos extintores me piden y si el servicio que me dieron el año pasado sirvió de algo.',
          'Son gratuitas, no piden registro y funcionan igual si eres cliente nuestro o no.',
        ]}
      />

      <div class="grid">
        {TOOLS.map((t, i) => (
          <CategoryCard
            label={t.label}
            href={`/herramientas/${t.slug}/`}
            image={t.image}
            imageAlt={t.imageAlt}
            badge={t.norm}
            blurb={t.desc}
            ctaLabel="Abrir herramienta"
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <SectionMenu items={cierreItems} cta={cierreCta} ariaLabel="Sigue explorando el sitio" />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); margin-top: var(--sp-6); }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
