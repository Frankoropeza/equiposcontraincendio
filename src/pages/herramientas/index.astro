---
// ============================================================================
// /herramientas/ — Hub de herramientas de utilidad pública (L2).
// ----------------------------------------------------------------------------
// AL PATRÓN L2 (2026-09-10), igual que /productos, /servicios y /cobertura:
//   Hero → SectionMenu → TrustBar → tarjetas → módulos CategoryFeature →
//   RiskGuide → NormsTable → ProcessSteps → CompanyAbout → RelatedLinks →
//   FAQ + Contacto
// El SectionMenu de cierre que tenía esta página lo sustituye RelatedLinks,
// que es como cierran las otras tres. Todo el contenido vive en
// src/data/herramientas.ts; aquí solo queda la composición.
//
// Listado propio (HERRAMIENTAS_CARDS, abajo): 3 herramientas + formatos,
// homologado con las 4 entradas del menú «Herramientas» del header.
// Schema: CollectionPage + ItemList con las herramientas publicadas + FAQPage.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import CategoryFeature from '@components/CategoryFeature.astro'
import ProcessSteps from '@components/ProcessSteps.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import { CONTACT, waUrl, WA_MESSAGES, sectionMenuItems } from '@config/site'
import RiskGuide from '@components/RiskGuide.astro'
import NormsTable from '@components/NormsTable.astro'
import CompanyAbout from '@components/CompanyAbout.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import {
  herramientasPillars as pillars,
  herramientasCards as HERRAMIENTAS_CARDS,
  herramientasFeatures as HERRAMIENTAS_FEATURES,
  herramientasSteps as comoFuncionaSteps,
  herramientasFaqs as faqs,
  herramientasComparativa,
  herramientasNormRows,
  herramientasCompany,
  herramientasRelated,
} from '@data/herramientas'
import { companyStats } from '@data/home'

// ── Tarjetas del hub (4, homologadas con el header: 3 herramientas + formatos).
// Copy propio por tarjeta (no reutiliza t.desc de TOOLS): título de venta,
// blurb más específico y 3 enlaces reales (subcategories del CategoryCard)
// a los artículos o formatos que profundizan el tema — reparten autoridad
// interna en vez de quedarse en una sola línea de texto.

const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.default),
  sub: 'Respuesta inmediata',
  external: true,
}


const schemaData = {
  list: {
    name: 'Herramientas de seguridad contra incendio',
    description:
      'Calculadoras y verificadores gratuitos para aplicar la NOM-002-STPS-2010: clasificar el riesgo de incendio, calcular extintores, revisar el estado de tu equipo y descargar tus formatos.',
    path: '/herramientas/',
    items: HERRAMIENTAS_CARDS.map((c) => ({
      name: c.label,
      path: c.href,
      image: c.image,
      description: c.blurb,
    })),
  },
  faqs,
}
---

<PageLayout
  title="NOM-002-STPS-2010: riesgo de incendio del centro de trabajo"
  description="Aplica la NOM-002-STPS-2010 en tu centro de trabajo: clasifica el grado de riesgo de incendio, calcula cuántos extintores necesitas y verifica tu equipo. Gratis."
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Herramientas' }]}
  guia={false}
>
  <Hero
    badge="Gratis y sin registro"
    title="Herramientas de la"
    accent="NOM-002-STPS-2010"
    accentNowrap
    subtitle="Cuatro herramientas gratuitas de prevención y protección contra incendios en los centros de trabajo: en qué grado de riesgo de incendio estoy, cuántos extintores necesito, si el equipo que ya tengo está en regla y con qué lo documento."
    descRight={[
      'Aplican los criterios de la NOM-002-STPS-2010 y de la NOM-154-SCFI-2005, y cada una cita de dónde sale su número. Sin registro, sin correo y sin letras chiquitas.',
      'Orientan, no dictaminan: el estudio o el dictamen formal lo elabora y lo firma quien está facultado. Si prefieres que lo hagamos nosotros, escríbenos.',
    ]}
    ctas={[
      { text: 'Equipos contra incendios', href: '/productos/', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.default), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />


  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Herramientas"
        title="Calcula el riesgo de incendio y"
        titleAccent="verifica tu equipo"
        desc="Cada herramienta cita la norma de la que sale su criterio."
        body={[
          'Las hicimos porque son las preguntas que más nos llegan por WhatsApp antes de una cotización: qué grado de riesgo tengo, cuántos extintores me piden, si el servicio que me dieron el año pasado sirvió de algo y con qué lo dejo por escrito.',
          'La Norma Oficial Mexicana NOM-002-STPS-2010, «Condiciones de seguridad – Prevención y protección contra incendios en los centros de trabajo», de la Secretaría del Trabajo y Previsión Social, obliga a toda empresa a clasificar su riesgo de incendio (ordinario o alto) y, con base en ese grado, a contar con extintores, detección, plan de atención a emergencias, instrucciones de seguridad y, en riesgo alto, brigada contra incendio. Estas herramientas convierten esos requisitos en números concretos para tu inmueble.',
          'Son gratuitas, no piden registro y funcionan igual si eres cliente nuestro o no.',
        ]}
      />

      <div class="card-grid">
        {HERRAMIENTAS_CARDS.map((c, i) => (
          <CategoryCard
            label={c.label}
            href={c.href}
            image={c.image}
            imageAlt={c.imageAlt}
            badge={c.badge}
            blurb={c.blurb}
            subcategories={c.subcategories}
            ctaLabel={c.ctaLabel}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Módulos de detalle por herramienta (CategoryFeature) ─── */}
  {HERRAMIENTAS_FEATURES.map((c) => (
    <CategoryFeature
      eyebrow={c.eyebrow}
      title={c.title}
      titleAccent={c.titleAccent}
      description={c.description}
      features={c.features}
      ctaLabel={c.ctaLabel}
      ctaHref={c.ctaHref}
      ctaSecondaryLabel={c.ctaSecondaryLabel}
      ctaSecondaryHref={c.ctaSecondaryHref}
      imgMain={c.imgMain}
      imgA={c.imgA}
      imgB={c.imgB}
    />
  ))}

  {/* ─── Comparativa: cuál herramienta resuelve tu pregunta ─── */}
  <RiskGuide
    eyebrow="Cuál te sirve"
    title="Qué resuelve cada herramienta"
    titleAccent="de prevención y protección contra incendios"
    desc="Para que abras la que necesitas sin tener que probarlas todas."
    body={[
      'Las cuatro parten de la misma idea: darte el número antes de que alguien te lo convierta en cotización. Cambia la pregunta que responden y los datos que hay que tener a la mano.',
      'Si no sabes por dónde empezar, empieza por el riesgo: casi todo lo demás —cuántos extintores, si necesitas brigada— depende de ese primer resultado.',
    ]}
    rows={herramientasComparativa}
    columns={['Herramienta', 'Qué pregunta responde', 'Qué necesitas a la mano', 'Qué te entrega']}
    note="Ninguna guarda ni envía tus datos: el cálculo ocurre en tu navegador. Y ninguna sustituye un dictamen: orientan con el mismo criterio que aplica la autoridad, pero el estudio formal para tu expediente lo elabora y lo firma quien está facultado."
    ctaLabel="Clasificar mi riesgo"
    ctaHref="/herramientas/riesgo-de-incendio/"
  />

  {/* ─── De qué norma sale cada número ─── */}
  <NormsTable
    eyebrow="De dónde sale cada número"
    title="Qué pide la NOM-002-STPS-2010 por grado de riesgo"
    titleAccent="y de dónde sale cada número"
    desc="Cada resultado cita el artículo o la tabla de la que sale."
    body={[
      'Una calculadora que no dice de dónde saca su número no sirve para discutir con nadie. Aquí está el sustento normativo de cada cálculo, para que puedas verificarlo o defenderlo ante una verificación.',
      'Además de la revisión mensual de los extintores, la norma fija los requerimientos para la prevención de incendios en todo centro de trabajo: medios de detección, instrucciones de seguridad aplicables en cada área, un plan de atención a emergencias, el croquis o plano con la ubicación del equipo y las rutas, un programa anual de capacitación y al menos un simulacro al año. Con riesgo de incendio alto suma brigadas con equipo de protección personal para sus integrantes, dos simulacros al año, alarmas de incendio y sistemas fijos contra incendio.',
      'Las NOM son obligatorias en México; el criterio de las herramientas no va más allá de lo que ellas dicen.',
    ]}
    rows={herramientasNormRows}
    columns={['Norma y apartado', 'Qué establece', 'Qué herramienta lo usa']}
    note="Si tu resultado da riesgo alto o tu extintor no pasa la verificación, no es un veredicto: es la señal de revisar tu caso con más detalle. Escríbenos con el resultado y te decimos qué corregir primero."
  />

  {/* ─── Cómo funcionan (ProcessSteps, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Cómo funcionan"
    title="Ocho pasos para evaluar tu"
    titleAccent="centro de trabajo"
    desc="Sin trámites ni tecnicismos: capturas lo que ya sabes de tu inmueble y la herramienta hace el cálculo."
    steps={comoFuncionaSteps}
  />

  {/* ─── Sobre las herramientas (por qué son públicas / cómo usarlas) ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Sobre estas herramientas"
        title="Prevención de incendios en los centros de trabajo:"
        titleAccent="gratis y con la norma a la vista"
        desc="Un cliente que entiende el porqué de su número compra mejor."
        body={[
          'Publicamos las cuentas en vez de guardarlas: es la forma más rápida de que dejes de depender de la palabra de un proveedor, el nuestro incluido.',
          '¿Tu resultado no te cuadra o no sabes cómo seguir? Escríbenos y lo revisamos contigo.',
        ]}
      />
      <CompanyAbout
        que={herramientasCompany.que}
        como={herramientasCompany.como}
        stats={companyStats}
        cta={{ label: 'Consultar mi resultado', href: waUrl('Hola, usé sus herramientas y quiero revisar mi resultado.'), external: true }}
      />
    </div>
  </section>

  {/* ─── Interlinking a las otras secciones ─── */}
  <RelatedLinks
    title="Sigue por aquí"
    desc="Lo que suele hacer falta después de tener el número."
    links={herramientasRelated}
    limit={4}
  />

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={faqs} waNumber={CONTACT.whatsapp} />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
</style>
