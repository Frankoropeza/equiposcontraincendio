  .fld__l { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--c-ink); }
  .fld__l em { font-style: normal; font-weight: 400; color: var(--c-muted); }
  .fld__h { font-size: var(--text-xs); color: var(--c-muted); }
  .fld__h a { color: var(--c-primary); }
  /* 16px reales: por debajo de eso iOS hace zoom al enfocar el campo. */
  .fld input[type="number"] { font-size: 1rem; padding: var(--sp-3); border: 1px solid var(--c-border); border-radius: var(--radius-md, 8px); background: var(--c-white); color: var(--c-ink); width: 100%; }
  .fld input:focus-visible { outline: 2px solid var(--c-primary); outline-offset: 1px; }

  .opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-2); }
  @media (max-width: 420px) { .opts { grid-template-columns: 1fr; } }
  .opt { display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-2); min-height: 44px; padding: var(--sp-2) var(--sp-3); border: 1px solid var(--c-border); border-radius: var(--radius-md, 8px); font-size: var(--text-sm); cursor: pointer; text-align: center; }
  .opt:has(input:checked) { border-color: var(--c-primary); color: var(--c-primary); font-weight: var(--weight-semibold); }
  .opt:has(input:focus-visible) { outline: 2px solid var(--c-primary); outline-offset: 2px; }

  /* ── Radios y checkboxes del sistema ──────────────────────────────────────
  Los controles nativos salían con el tamaño y la tipografía por defecto del
  navegador (17/18px, font-size 13.33px) junto a inputs ya estilados: se
  reemplaza su apariencia por la de los tokens y el área táctil la da la
  etiqueta contenedora (≥44px). */
  .opt input[type="radio"],
  .area__check input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    width: 1.25rem;
