---
// ============================================================================
// /nosotros/ — Página institucional de CONINC.
// ----------------------------------------------------------------------------
// La estructura y el copy se alimentan de src/data/nosotros.ts; esta página
// únicamente compone los módulos canónicos del sitio.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import DataTable from '@components/DataTable.astro'
import SectionHeading from '@components/SectionHeading.astro'
import QuoteCard from '@components/QuoteCard.astro'
import CategoryCard from '@components/CategoryCard.astro'
import ProcessSteps from '@components/ProcessSteps.astro'
import CompanyAbout from '@components/CompanyAbout.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import { COMPANY, CONTACT, SHOWCASE, WA_MESSAGES, sectionMenuItems, telUrl, waUrl } from '@config/site'
import { homeCompany, homeSteps } from '@data/home'
import {
  fichaEmpresa, loQueNoHacemos, nosotrosFaqs, nosotrosHero, nosotrosMeta,
  principios, serviciosTabla, trayectoria,
} from '@data/nosotros'

const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.cotizar),
  sub: 'Te decimos qué necesitas', external: true,
}
---

<PageLayout title={nosotrosMeta.title} description={nosotrosMeta.description} pageType="page" schemaData={{ faqs: nosotrosFaqs }} breadcrumbs={[{ label: 'Nosotros' }]}>
  <Hero badge={nosotrosHero.badge} title={nosotrosHero.title} accent={nosotrosHero.accent} subtitle={nosotrosHero.subtitle} descRight={nosotrosHero.descRight} ctas={[
    { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.contacto), variant: 'primary', whatsapp: true },
    { text: 'Nuestros servicios', href: '/servicios/', variant: 'outline' },
  ]} />
  <SectionMenu items={menuSecciones} cta={menuCta} />

  <DataTable {...fichaEmpresa} />

  <section class="section section--surface">
    <div class="container">
      <div class="about-grid">
        <article class="prose">
          <SectionHeading eyebrow={trayectoria.eyebrow} title={trayectoria.title} titleAccent={trayectoria.titleAccent} />
          {trayectoria.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </article>
        <QuoteCard title={trayectoria.quote.title} eyebrow={trayectoria.quote.eyebrow} items={trayectoria.quote.items} itemsLabel={trayectoria.quote.itemsLabel} ctaLabel={trayectoria.quote.ctaLabel} showPrice={false} waLink={waUrl(WA_MESSAGES.contacto)} telHref={telUrl()} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Vitrina" title="Qué vende" titleAccent="CONINC" desc="Ocho familias de equipo para proteger empresas e inmuebles según su riesgo real." />
      <div class="card-grid">
        {SHOWCASE.map((category, index) => <CategoryCard {...category} index={index} priority={index === 0} />)}
      </div>
    </div>
  </section>

  <DataTable {...serviciosTabla} surface />
  <ProcessSteps eyebrow="Cómo trabajamos" title="Del diagnóstico" titleAccent="a la continuidad" desc="El mismo proceso claro que usamos para orientar cada proyecto y cada servicio." steps={homeSteps} />

  <section class="section section--surface">
    <div class="container">
      <SectionHeading eyebrow="Principios" title="Cómo trabaja" titleAccent="CONINC" desc="Cuatro convicciones que guían la asesoría, el suministro y el servicio." />
      <div class="card-grid principles-grid">
        {principios.map((principio) => <article class="principle-card"><h3>{principio.t}</h3><p>{principio.d}</p></article>)}
      </div>
    </div>
  </section>

  <DataTable {...loQueNoHacemos} />

  <section class="section section--surface">
    <div class="container">
      <SectionHeading layout="duo" eyebrow="Sobre la empresa" title="Equipo y servicio" titleAccent="con contexto" desc={COMPANY.summary} />
      <CompanyAbout que={homeCompany.que} como={homeCompany.como} cta={{ label: 'Hablar por WhatsApp', href: waUrl(WA_MESSAGES.contacto), external: true }} />
    </div>
  </section>

  <RelatedLinks title="Sigue por aquí" links={[
    { label: 'Servicios', href: '/servicios/', desc: 'Instalación, mantenimiento, inspección y capacitación.' },
    { label: 'Productos', href: '/productos/', desc: 'Equipo contra incendio para cada inmueble.' },
    { label: 'Cobertura', href: '/cobertura/', desc: 'Zonas que atendemos en CDMX y Estado de México.' },
    { label: 'Contacto', href: '/contacto/', desc: 'WhatsApp, teléfono, correo y horario.' },
  ]} limit={4} />
  <FAQWithContact items={nosotrosFaqs} waNumber={CONTACT.whatsapp} />
</PageLayout>

<style>
  /* .container/.section/.section--surface: utilidades globales de tokens.css (F3.3). */
  .section { padding: var(--section-py) 0; }
  .about-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-8); align-items: start; }
  .prose { max-width: 68ch; color: var(--c-ink-2); line-height: var(--leading-relaxed); }
  .prose p { margin: 0 0 var(--sp-4); }
  .principle-card { display: flex; flex-direction: column; gap: var(--sp-2); height: 100%; padding: var(--sp-5); background: var(--c-white); border: 1px solid var(--c-border); border-radius: var(--radius-lg); }
  .principle-card h3, .principle-card p { margin: 0; }
  .principle-card h3 { font-family: var(--font-heading); font-size: var(--text-lg); color: var(--c-ink); }
  .principle-card p { color: var(--c-ink-2); line-height: var(--leading-relaxed); }
  @media (min-width: 900px) { .about-grid { grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem); } }
</style>
