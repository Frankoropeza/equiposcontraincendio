---
// ============================================================================
// /nosotros/ — Página "Nosotros" (acerca de).
// Página estática con PageLayout. Presenta la empresa, su forma de trabajar y sus
// principios. Contenido DEMO de la plantilla; identidad desde SITE (site.ts).
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionHeading from '@components/SectionHeading.astro'
import SectionMenu from '@components/SectionMenu.astro'
import { NAV, waUrl, WA_MESSAGES } from '@config/site'

// Principios — data-driven (grid de valores). DEMO de la plantilla.
const principios = [
  { t: 'Asesoría honesta', d: 'Te recomendamos el equipo que pide tu riesgo real, en lenguaje claro y sin venderte de más.' },
  { t: 'Conforme a norma', d: 'Trabajamos alineados a la NOM-002-STPS y la NOM-154-SCFI, con la documentación lista para tu expediente.' },
  { t: 'Servicio documentado', d: 'Cada equipo y cada servicio se entregan con su soporte: ficha técnica y constancias para Protección Civil.' },
  { t: 'Trato directo', d: 'Hablas con quien resuelve, no con un intermediario. Respuesta directa por WhatsApp.' },
]

// ── Menú de secciones bajo el hero (data-driven desde NAV; excluye Contacto) ──
const menuSub: Record<string, string> = {
  Productos: 'Catálogo de equipo',
  Servicios: 'Instalación y mantenimiento',
  Cobertura: 'Zonas que atendemos',
  Blog: 'Guías y normatividad',
}
const menuSecciones = NAV.filter((n) => n.label !== 'Contacto').map((n) => ({
  label: n.label,
  href: n.href,
  sub: menuSub[n.label] ?? 'Ver sección',
}))
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.cotizar),
  sub: 'Respuesta inmediata',
  external: true,
}
---

<PageLayout
  title="Nosotros — quiénes somos"
  description="Conoce a Equipos Contra Incendio: cómo trabajamos y en qué creemos. Asesoría honesta, apego a la norma y trato directo para proteger tu inmueble."
  pageType="page"
  breadcrumbs={[{ label: 'Nosotros' }]}
  guia={false}
>
  <Hero
    badge="Quiénes somos"
    title="Detrás de"
    accent="cada instalación"
    subtitle="No solo vendemos equipo: nos aseguramos de que tu inmueble quede realmente protegido y en regla, con asesoría honesta y apego a la norma."
    descRight={[
      'Somos un proveedor de equipo contra incendio con un método claro: te decimos qué necesitas y por qué, no lo que más nos conviene vender. Antes de cotizar, entendemos el riesgo real de tu inmueble.',
      'Vendemos, instalamos y damos mantenimiento con asesoría honesta y apego a la normatividad. Nuestro objetivo es que tu inmueble esté realmente protegido y en regla, no solo equipado.',
    ]}
    ctas={[
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.cotizar), variant: 'primary', whatsapp: true },
      { text: 'Ver servicios', href: '/servicios/', variant: 'outline' },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  <section class="section">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Cómo trabajamos"
        title="Método, no improvisación"
        desc="Un proceso claro que va del riesgo de tu inmueble al equipo instalado y en regla, sin sorpresas."
        body={[
          'Empezamos por entender tu riesgo: qué puede quemarse, qué exige la norma para tu giro y qué pide la inspección. Con eso definimos el equipo correcto antes de cotizar. Asesorar bien evita gastar de más.',
          'Suministramos, instalamos y damos mantenimiento conforme a norma, y te entregamos la documentación lista para tu expediente. Quedamos al pendiente para que tu protección siga vigente.',
        ]}
      />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        eyebrow="En qué creemos"
        title="Los principios que guían el"
        titleAccent="trabajo"
        desc="Cuatro convicciones que se notan en cómo atendemos a cada cliente."
      />
      <div class="principios">
        {principios.map((p) => (
          <article class="principio">
            <h3 class="principio__t">{p.t}</h3>
            <p class="principio__d">{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }

  .principios { display: grid; grid-template-columns: 1fr; gap: var(--sp-4); margin-top: var(--sp-6); }
  @media (min-width: 640px)  { .principios { grid-template-columns: repeat(2, 1fr); } }
  .principio { padding: var(--sp-5); background: var(--c-white); border: 1px solid var(--c-border); border-radius: var(--radius-lg); }
  .principio__t { font-family: var(--font-heading); font-size: var(--text-lg); font-weight: var(--weight-bold); color: var(--c-ink); margin: 0 0 var(--sp-2); }
  .principio__d { font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--c-ink-2); margin: 0; }
</style>
