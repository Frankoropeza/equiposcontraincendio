---
// ============================================================================
// /productos/ — Catálogo de equipos y materiales contra incendios.
// ----------------------------------------------------------------------------
// Estructura: Hero → SectionMenu → familias → módulos CategoryFeature → fichas
// → RiskGuide → NormsTable → ProcessSteps → Sobre el catálogo → Reseñas →
// RelatedLinks → FAQ.
// REGLA DE COPY: el contenido vive en src/data/productos.ts; esta página solo
// compone los componentes.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/Hero.astro';
import SectionMenu from '@components/SectionMenu.astro';
import SectionHeading from '@components/SectionHeading.astro';
import CategoryCard from '@components/CategoryCard.astro';
import CategoryFeature from '@components/CategoryFeature.astro';
import ProductCard from '@components/ProductCard.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import RiskGuide from '@components/RiskGuide.astro';
import NormsTable from '@components/NormsTable.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import CompanyAbout from '@components/CompanyAbout.astro';
import RelatedLinks from '@components/RelatedLinks.astro';
import Testimonios from '@components/Testimonios.astro';
import {
  productosRiskRows,
  productosNormRows,
  productosSteps,
  productosCompany,
  productosRelated,
  productosCategoryFeatures,
  productosFaqs,
  productosOrden,
  productosBadge,
  productosTestimoniosNombres,
  productosTestimoniosHead,
  productosFaqHead,
} from '@data/productos';
import { testimonios } from '@data/testimonios';
import { getCollection } from 'astro:content';
import { SHOWCASE, CONTACT, waUrl, WA_MESSAGES, sectionMenuItems } from '@config/site';
import { cierreGeneral, faltanParaCuatro } from '@data/cierre';

const productos = (await getCollection('productos', ({ data }) => !data.draft)).sort((a, b) => {
  const aOrder = productosOrden.indexOf(a.id);
  const bOrder = productosOrden.indexOf(b.id);
  return (aOrder === -1 ? a.data.order : aOrder) - (bOrder === -1 ? b.data.order : bOrder);
});
const cierreProductos = cierreGeneral.slice(0, faltanParaCuatro(productos.length));
const CAT_LABEL: Record<string, string> = {
  extintores: 'Extintores',
  'deteccion-alarmas': 'Detección',
  'hidrantes-mangueras': 'Hidrantes',
  senalizacion: 'Señalización',
  accesorios: 'Accesorios',
  general: 'General',
};
const menuSecciones = sectionMenuItems();
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.cotizar),
  sub: 'Te decimos cuál conviene',
  external: true,
};
const testimoniosProductos = productosTestimoniosNombres.flatMap((nombre) => testimonios.filter((testimonio) => testimonio.nombre === nombre));
const schemaData = {
  list: {
    name: 'Material contra incendios',
    description:
      'Catálogo de material contra incendios: extintores, detección y alarmas, hidrantes y mangueras, señalización, sistemas fijos y equipo de protección personal.',
    path: '/productos/',
    items: productos.map((p) => ({
      name: p.data.title,
      path: `/productos/${p.id}/`,
      image: p.data.image,
      description: p.data.description,
    })),
  },
  faqs: productosFaqs,
};
---
<PageLayout
  title="Material contra incendios: catálogo de equipos y sistemas"
  description="Material contra incendios en CDMX y Edomex: extintores, detectores, mangueras, rociadores y sistemas contra incendios, con instalación y mantenimiento."
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Productos' }]}
  guia={false}
>
  {/* ─── Hero ─── */}
  <Hero
    badge="Catálogo · CDMX y Estado de México"
    title="Equipos y materiales"
    accent="contra incendios"
    subtitle="Extintores, detección y alarmas, hidrantes y mangueras, señalización, sistemas fijos y equipo de protección personal — con instalación, mantenimiento y documentación para Protección Civil y STPS."
    descRight={[
      'Reunimos en un solo catálogo el material contra incendios que tu inmueble necesita para una protección contra incendios integral: extintores, detección y alarma, hidrantes y mangueras, señalización y sistemas fijos. Todo dimensionado al riesgo real del lugar y a sus ocupantes, no a un catálogo genérico.',
      'Cada equipo se entrega con ficha técnica y la documentación de servicio lista para tu expediente ante Protección Civil y STPS. Cotiza por WhatsApp y recibe una recomendación honesta.',
    ]}
    ctas={[
      { text: 'Material contra incendios', href: '#categorias', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.productos), variant: 'primary', whatsapp: true },
    ]}
  />

  {/* ─── Menú de secciones ─── */}
  <SectionMenu
    items={menuSecciones}
    cta={menuCta}
  />
  {/* ─── Familias ─── */}
  <section class="section section--surface" id="categorias">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Catálogo por familia"
        title="Materiales contra incendio,"
        titleAccent="por familia de equipo"
        desc="Selecciona la familia que necesitas o cotiza varias a la vez."
        body={[
          'Cada familia agrupa equipos y materiales por función: detectar, avisar, extinguir, evacuar y proteger a quien responde. Juntas forman la protección activa de un sistema contra incendios, y puedes pedir equipo de varias familias en una sola cotización.',
          'Si no sabes por dónde empezar, escríbenos: revisamos tu inmueble y te decimos exactamente qué necesitas, sin venderte de más.',
        ]}
      />
      <div class="card-grid">
        {SHOWCASE.map((c, i) => (
          <CategoryCard
            label={c.label}
            href={c.href}
            image={c.image}
            imageAlt={c.imageAlt}
            badge={c.badge}
            blurb={c.blurb}
            subcategories={c.subcategories}
            ctaLabel={c.ctaLabel}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Módulos CategoryFeature ─── */}
  {productosCategoryFeatures.map(({ ctaSecondaryMsg, ...feature }, i) => (
    <CategoryFeature
      {...feature}
      anchorId={SHOWCASE[i]?.slug}
      ctaSecondaryLabel={ctaSecondaryMsg ? 'Cotizar por WhatsApp' : undefined}
      ctaSecondaryHref={ctaSecondaryMsg ? waUrl(ctaSecondaryMsg) : undefined}
      ctaSecondaryExternal
    />
  ))}
  {/* ─── Fichas ─── */}
  {productos.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeading
          layout="duo"
          eyebrow="Fichas técnicas"
          title="Productos contra incendios"
          titleAccent="con ficha técnica"
          desc="Fichas técnicas de los productos de mayor rotación."
          body={[
            'Cada ficha incluye especificaciones técnicas, norma aplicable y el agente o uso recomendado. El precio varía según cantidad y si incluye servicio.',
            'Pide cotización por WhatsApp indicando el producto y la cantidad — te respondemos con precio, disponibilidad y tiempos de entrega.',
          ]}
        />
        <div class="card-grid">
          {productos.map((p, i) => (
            <ProductCard
              title={p.data.cardTitle ?? p.data.title}
              href={`/productos/${p.id}/`}
              image={p.data.image}
              imageAlt={p.data.title}
              badge={productosBadge[p.id] ?? CAT_LABEL[p.data.category] ?? p.data.category}
              description={p.data.cardDescription ?? p.data.description}
              index={i}
              priority={i === 0}
            />
          ))}
          {cierreProductos.map((ficha, i) => (
            <ProductCard
              title={ficha.title}
              href={ficha.whatsapp ? waUrl(ficha.href) : ficha.href}
              image={ficha.image}
              imageAlt={ficha.imageAlt}
              badge={ficha.badge}
              description={ficha.description}
              ctaLabel={ficha.ctaLabel}
              index={productos.length + i}
              external={ficha.whatsapp}
            />
          ))}
        </div>
      </div>
    </section>
  )}
  {/* ─── Guía de selección ─── */}
  <RiskGuide
    eyebrow="Guía de selección"
    title="Qué extintor pide"
    titleAccent="cada tipo de inmueble"
    desc="Primero se clasifica el riesgo de incendio del centro de trabajo: el agente y la capacidad se eligen por lo que puede arder, no por el tamaño del local."
    body={[
      'Un extintor de PQS no sirve bajo una campana de cocina y uno de CO₂ no apaga una tarima de cartón. Esta tabla traduce el giro del inmueble al agente correcto y a la capacidad con la que conviene arrancar.',
      'La distancia de recorrido cambia con la clase de fuego: 23 m para sólidos y riesgo eléctrico, 15 m para líquidos inflamables (10 m si el riesgo es alto) y 10 m para cocina.',
    ]}
    rows={productosRiskRows}
    columns={['Tipo de inmueble', 'Qué puede arder', 'Agente y capacidad base', 'A considerar']}
    note="Punto de partida, no dictamen. La NOM-002-STPS pide al menos un extintor por cada 300 m² en riesgo ordinario y por cada 200 m² en riesgo alto, colocado a no más de 1.50 m del piso. La cantidad exacta y la ubicación salen del plano de tu inmueble."
    ctaLabel="Calcular cuántos necesito"
    ctaHref="/herramientas/cuantos-extintores-necesito/"
  />
  {/* ─── Respaldo normativo ─── */}
  <NormsTable
    eyebrow="Respaldo normativo"
    title="Qué norma certifica"
    titleAccent="cada familia del catálogo"
    desc="Lo que revisa el inspector cuando levanta el equipo y busca la contraseña oficial."
    body={[
      'No basta con tener el equipo: en caso de incendio tiene que funcionar, y para eso debe estar certificado, colocado como manda la Norma Oficial Mexicana y con su servicio al día. Aquí está qué exige cada norma y a qué parte del catálogo aplica.',
      'Las NFPA se listan como referencia técnica internacional. No son ley federal en México, aunque tu aseguradora o tu corporativo sí pueden exigirlas.',
    ]}
    rows={productosNormRows}
    columns={['Norma / estándar', 'Qué exige', 'Aplica a']}
    note="Cada entrega incluye ficha técnica y la documentación de servicio para integrar a tu expediente ante Protección Civil y STPS. Si no sabes qué normas te aplican por giro y tamaño, se revisa contigo antes de cotizar."
  />

  {/* ─── Cómo se compra ─── */}
  <ProcessSteps
    eyebrow="Cómo se compra"
    title="Del catálogo a tu inmueble"
    titleAccent="sin sorpresas"
    desc="Sin carrito y sin precios a la vista, porque el equipo correcto depende de tu riesgo."
    body={[
      'Cotizar por WhatsApp no es un trámite más lento: es lo que evita que compres de más o que compres lo que no aplica a tu inmueble.',
      'El proceso es el mismo para una oficina con tres extintores que para una nave con red hidráulica; solo cambia el tamaño de la propuesta.',
    ]}
    steps={productosSteps}
  />

  {/* ─── Sobre el catálogo ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Sobre este catálogo"
        title="Todas las familias,"
        titleAccent="un solo proveedor"
        desc="Equipo certificado, con su documentación y con quien te explique cuál te toca."
        body={[
          'Reunimos en un mismo catálogo los materiales y equipos de seguridad contra incendios que un inmueble necesita para estar protegido y en regla, sin coordinar a tres proveedores para un mismo expediente.',
          'Cotiza por WhatsApp y habla directo con quien resuelve.',
        ]}
      />
      <CompanyAbout
        que={productosCompany.que}
        como={productosCompany.como}
        cta={{ label: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.productos), external: true }}
      />
    </div>
  </section>

  {/* ─── Reseñas ─── */}
  <Testimonios
    items={testimoniosProductos}
    {...productosTestimoniosHead}
  />

  {/* ─── Enlaces relacionados ─── */}
  <RelatedLinks
    title="Sigue por aquí"
    desc="Lo que suele hacer falta después de elegir el equipo."
    links={productosRelated}
    limit={4}
  />

  {/* ─── FAQ ─── */}
  <FAQWithContact
    items={productosFaqs}
    waNumber={CONTACT.whatsapp}
    {...productosFaqHead}
  />
</PageLayout>
<style>
  /* Contenedores y secciones canónicos (idénticos al index.astro). */
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }

  .section {
    padding: var(--sp-8) 0;
  }

  .section--surface {
    background: var(--c-surface);
  }

  @media (min-width: 1024px) {
    .section {
      padding: var(--sp-10) 0;
    }
  }
</style>
