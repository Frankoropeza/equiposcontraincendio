---
// /productos/ — Catálogo L2. HOMOLOGADO con el sistema de diseño del home:
// usa los componentes compartidos (Hero, SectionMenu, TrustBar, SectionHeading,
// CategoryCard, ProductCard, FAQWithContact) — sin hero ni pilares "a mano".
// Estructura: Hero → SectionMenu → TrustBar → Categorías → Productos → Normas → FAQ.
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/Hero.astro';
import SectionMenu from '@components/SectionMenu.astro';
import TrustBar from '@components/TrustBar.astro';
import SectionHeading from '@components/SectionHeading.astro';
import CategoryCard from '@components/CategoryCard.astro';
import CategoryFeature from '@components/CategoryFeature.astro';
import ProductCard from '@components/ProductCard.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import RiskGuide from '@components/RiskGuide.astro';
import NormsTable from '@components/NormsTable.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import CompanyAbout from '@components/CompanyAbout.astro';
import RelatedLinks from '@components/RelatedLinks.astro';
import {
  productosRiskRows,
  productosNormRows,
  productosSteps,
  productosCompany,
  productosRelated,
} from '@data/productos';
import { companyStats } from '@data/home';
import { getCollection } from 'astro:content';
import { SHOWCASE, CONTACT, waUrl, WA_MESSAGES, sectionMenuItems } from '@config/site';
import { cierreGeneral, faltanParaCuatro } from '@data/cierre';

const productos = (await getCollection('productos', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const cierreProductos = cierreGeneral.slice(0, faltanParaCuatro(productos.length));

const CAT_LABEL: Record<string, string> = {
  extintores: 'Extintores',
  'deteccion-alarmas': 'Detección',
  'hidrantes-mangueras': 'Hidrantes',
  senalizacion: 'Señalización',
  accesorios: 'Accesorios',
  general: 'General',
};

// ── Menú de secciones bajo el hero (data-driven desde NAV; excluye Contacto) ──
// Mismo patrón que la home (index.astro): el hero presenta, la franja convierte.
// Menú de secciones: subtítulos desde SECTION_MENU_SUB (site.ts), no un mapa
// local — así todas las páginas describen las secciones igual.
const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.cotizar),
  sub: 'Te decimos cuál conviene',
  external: true,
};

// ── Barra de confianza (pilares honestos, vía componente TrustBar) ──
const pillars = [
  { icon: 'shield', title: 'Conforme a norma', desc: 'Equipo alineado a la NOM-002-STPS, la NOM-154-SCFI y la NOM-003-SEGOB.' },
  { icon: 'doc', title: 'Documentación incluida', desc: 'Ficha técnica y constancias de servicio para tu expediente ante PC y STPS.' },
  { icon: 'pin', title: 'Entrega en CDMX y EdoMex', desc: 'Ciudad de México, Estado de México y zona metropolitana.' },
  { icon: 'chat', title: 'Asesoría sin compromiso', desc: 'Te recomendamos el equipo que pide tu riesgo real, sin venderte de más.' },
];

// ── Módulos de categoría (CategoryFeature) — copy PROPIO de /productos
