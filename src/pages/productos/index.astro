const faqs = [
  {
    question: '¿Cómo sé qué equipo necesito?',
    answer: 'Depende del riesgo de tu inmueble y lo que pueda quemarse. Escríbenos con tu giro y superficie y te recomendamos el equipo y las capacidades adecuadas, sin venderte de más.',
  },
  {
    question: '¿Por qué no muestran precios en el catálogo?',
    answer: 'Cotizamos según cantidades, capacidades y si incluye instalación o mantenimiento. Por eso trabajamos con cotización por WhatsApp en lugar de publicar un precio que podría no aplicar a tu caso real.',
  },
  {
    question: '¿Venden con instalación y mantenimiento incluidos?',
    answer: 'Sí. Además de la venta, instalamos, damos mantenimiento y recargamos extintores conforme a la NOM-154-SCFI-2005. Puedes cotizar producto y servicio juntos en un solo mensaje.',
  },
  {
    question: '¿Tienen stock o trabajan bajo pedido?',
    answer: 'Tenemos stock de los productos de mayor rotación (extintores PQS, CO₂, detectores y señalización básica). Equipos especializados o de gran capacidad pueden requerir tiempo de entrega; te lo confirmamos al cotizar.',
  },
  {
    question: '¿Me entregan con factura?',
    answer: 'Sí, facturamos con todos los RFC que nos proporciones. El equipo sale con su ficha técnica y, si incluye servicio, con la constancia correspondiente para Protección Civil y STPS.',
  },
  {
    question: '¿Hacen entregas fuera de CDMX?',
    answer: 'Atendemos CDMX, Estado de México y zona metropolitana. Para instalación y mantenimiento cubrimos esas mismas zonas. Cuéntanos dónde estás y te confirmamos cobertura y tiempos.',
  },
];

const schemaData = {
  list: {
    name: 'Equipo contra incendio',
    description: 'Catálogo de equipo contra incendio: extintores, detección y alarmas, hidrantes y mangueras, y señalización de emergencia.',
    path: '/productos/',
    items: productos.map((p) => ({
      name: p.data.title,
      path: `/productos/${p.id}/`,
      image: p.data.image,
      description: p.data.description,
    })),
  },
  faqs,
};
---

<PageLayout
  title="Catálogo de equipo contra incendio"
  description="Catálogo de equipo contra incendio: extintores, detección y alarmas, hidrantes, mangueras y señalización. Cotiza por WhatsApp — CDMX y Estado de México."
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Productos' }]}
  guia={false}
>

  {/* ─── Hero (componente compartido, idéntico al index) ─── */}
  <Hero
    badge="Catálogo · CDMX y Estado de México"
    title="Catálogo de equipo,"
    accent="para cada riesgo"
    subtitle="Extintores, detección y alarmas, hidrantes y mangueras, señalización, sistemas fijos y equipo de protección personal — con instalación, mantenimiento y documentación para Protección Civil y STPS."
    descRight={[
      'Reunimos en un solo catálogo el equipo contra incendio que tu inmueble necesita: extintores, detección y alarma, hidrantes y mangueras, señalización y sistemas fijos. Todo dimensionado al riesgo real del lugar, no a un catálogo genérico.',
      'Cada equipo se entrega con ficha técnica y la documentación de servicio lista para tu expediente ante Protección Civil y STPS. Cotiza por WhatsApp y recibe una recomendación honesta.',
    ]}
    ctas={[
      { text: 'Equipo contra incendio', href: '#categorias', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.productos), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Barra de confianza (pilares honestos) ─── */}
  <TrustBar items={pillars} />

  {/* ─── Categorías (vitrina SHOWCASE) ─── */}
  <section class="section section--surface" id="categorias">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Catálogo por familia"
        title="Ocho familias de"
        titleAccent="equipo contra incendio"
        desc="Selecciona la familia que necesitas o cotiza varias a la vez."
        body={[
          'Cada familia agrupa los equipos por función y tipo de riesgo que cubre. Puedes pedir equipo de varias familias en una sola cotización.',
          'Si no sabes por dónde empezar, escríbenos: revisamos tu inmueble y te decimos exactamente qué necesitas, sin venderte de más.',
        ]}
      />
      <div class="card-grid">
        {SHOWCASE.map((c, i) => (
          <CategoryCard
            label={c.label}
            href={c.href}
            image={c.image}
            imageAlt={c.imageAlt}
            badge={c.badge}
            blurb={c.blurb}
            subcategories={c.subcategories}
            ctaLabel={c.ctaLabel}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Módulos de categoría (CategoryFeature) — como el index, copy propio ─── */}
  {CATEGORY_FEATURES.map((c, i) => (
    <CategoryFeature
      anchorId={SHOWCASE[i]?.slug}
      eyebrow={c.eyebrow}
      title={c.title}
      titleAccent={c.titleAccent}
      description={c.description}
      features={c.features}
      brands={c.brands}
      ctaLabel={c.ctaLabel}
      ctaHref={waUrl(c.ctaMsg)}
      ctaExternal
      ctaSecondaryLabel={c.ctaSecondaryLabel}
      ctaSecondaryHref={c.ctaSecondaryHref}
      imgMain={c.imgMain}
      imgA={c.imgA}
      imgB={c.imgB}
    />
  ))}

  {/* ─── Productos individuales ─── */}
  {productos.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeading
          layout="duo"
          eyebrow="Productos destacados"
          title="Equipo disponible"
          titleAccent="en stock"
          desc="Fichas técnicas de los productos de mayor rotación."
          body={[
            'Cada ficha incluye especificaciones técnicas, norma aplicable y el agente o uso recomendado. El precio varía según cantidad y si incluye servicio.',
            'Pide cotización por WhatsApp indicando el producto y la cantidad — te respondemos con precio, disponibilidad y tiempos de entrega.',
          ]}
        />
        <div class="card-grid">
          {productos.map((p, i) => (
            <ProductCard
              title={p.data.title}
              href={`/productos/${p.id}/`}
              image={p.data.image}
              imageAlt={p.data.title}
              badge={CAT_LABEL[p.data.category] ?? p.data.category}
              description={p.data.description}
              index={i}
              priority={i === 0}
            />
          ))}
          {cierreProductos.map((ficha, i) => (
            <ProductCard
              title={ficha.title}
              href={ficha.whatsapp ? waUrl(ficha.href) : ficha.href}
              image={ficha.image}
              imageAlt={ficha.imageAlt}
              badge={ficha.badge}
              description={ficha.description}
              ctaLabel={ficha.ctaLabel}
              index={productos.length + i}
              external={ficha.whatsapp}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ─── Guía de selección: agente y capacidad por tipo de inmueble ─── */}
  <RiskGuide
    eyebrow="Guía de selección"
    title="Qué extintor pide"
    titleAccent="cada tipo de inmueble"
    desc="El agente y la capacidad se eligen por lo que puede arder, no por el tamaño del local."
    body={[
      'Un extintor de PQS no sirve bajo una campana de cocina y uno de CO₂ no apaga una tarima de cartón. Esta tabla traduce el giro del inmueble al agente correcto y a la capacidad con la que conviene arrancar.',
      'La distancia de recorrido cambia con la clase de fuego: 23 m para sólidos y riesgo eléctrico, 15 m para líquidos inflamables (10 m si el riesgo es alto) y 10 m para cocina.',
    ]}
    rows={productosRiskRows}
    columns={['Tipo de inmueble', 'Qué puede arder', 'Agente y capacidad base', 'A considerar']}
    note="Punto de partida, no dictamen. La NOM-002-STPS pide al menos un extintor por cada 300 m² en riesgo ordinario y por cada 200 m² en riesgo alto, colocado a no más de 1.50 m del piso. La cantidad exacta y la ubicación salen del plano de tu inmueble."
    ctaLabel="Calcular cuántos necesito"
    ctaHref="/herramientas/cuantos-extintores-necesito/"
  />

  {/* ─── Respaldo normativo por familia (reemplaza la banda hecha a mano) ─── */}
  <NormsTable
    eyebrow="Respaldo normativo"
    title="Qué norma certifica"
    titleAccent="cada familia del catálogo"
    desc="Lo que revisa el inspector cuando levanta el equipo y busca la contraseña oficial."
    body={[
      'No basta con tener el equipo: tiene que estar certificado, colocado como manda la norma y con su servicio al día. Aquí está qué exige cada norma y a qué parte del catálogo aplica.',
      'Las NFPA se listan como referencia técnica internacional. No son ley federal en México, aunque tu aseguradora o tu corporativo sí pueden exigirlas.',
    ]}
    rows={productosNormRows}
    columns={['Norma / estándar', 'Qué exige', 'Aplica a']}
    note="Cada entrega incluye ficha técnica y la documentación de servicio para integrar a tu expediente ante Protección Civil y STPS. Si no sabes qué normas te aplican por giro y tamaño, se revisa contigo antes de cotizar."
  />

  {/* ─── Cómo se compra (proceso, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Cómo se compra"
    title="Del catálogo a tu inmueble"
    titleAccent="en ocho pasos"
    desc="Sin carrito y sin precios a la vista, porque el equipo correcto depende de tu riesgo."
    body={[
      'Cotizar por WhatsApp no es un trámite más lento: es lo que evita que compres de más o que compres lo que no aplica a tu inmueble.',
      'El proceso es el mismo para una oficina con tres extintores que para una nave con red hidráulica; solo cambia el tamaño de la propuesta.',
    ]}
    steps={productosSteps}
  />

  {/* ─── Sobre el catálogo (qué encuentras / cómo se cotiza) ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Sobre este catálogo"
        title="Ocho familias,"
        titleAccent="un solo proveedor"
        desc="Equipo certificado, con su documentación y con quien te explique cuál te toca."
        body={[
          'Reunimos en un mismo catálogo todo lo que un inmueble necesita para estar protegido y en regla, para que no tengas que pelotear entre tres proveedores un mismo expediente.',
          'Cotiza por WhatsApp y habla directo con quien resuelve.',
        ]}
      />
      <CompanyAbout
        que={productosCompany.que}
        como={productosCompany.como}
        stats={companyStats}
        cta={{ label: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.productos), external: true }}
      />
    </div>
  </section>

  {/* ─── Interlinking a las otras secciones ─── */}
  <RelatedLinks
    title="Sigue por aquí"
    desc="Lo que suele hacer falta después de elegir el equipo."
    links={productosRelated}
    limit={4}
  />

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={faqs} waNumber={CONTACT.whatsapp} />

</PageLayout>

