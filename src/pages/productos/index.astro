const faqs = [
  {
    question: '¿Cómo sé qué equipo necesito?',
    answer: 'Depende del riesgo de tu inmueble y lo que pueda quemarse. Escríbenos con tu giro y superficie y te recomendamos el equipo y las capacidades adecuadas, sin venderte de más.',
  },
  {
    question: '¿Por qué no muestran precios en el catálogo?',
    answer: 'Cotizamos según cantidades, capacidades y si incluye instalación o mantenimiento. Por eso trabajamos con cotización por WhatsApp en lugar de publicar un precio que podría no aplicar a tu caso real.',
  },
  {
    question: '¿Venden con instalación y mantenimiento incluidos?',
    answer: 'Sí. Además de la venta, instalamos, damos mantenimiento y recargamos extintores conforme a la NOM-154-SCFI-2005. Puedes cotizar producto y servicio juntos en un solo mensaje.',
  },
  {
    question: '¿Tienen stock o trabajan bajo pedido?',
    answer: 'Tenemos stock de los productos de mayor rotación (extintores PQS, CO₂, detectores y señalización básica). Equipos especializados o de gran capacidad pueden requerir tiempo de entrega; te lo confirmamos al cotizar.',
  },
  {
    question: '¿Me entregan con factura?',
    answer: 'Sí, facturamos con todos los RFC que nos proporciones. El equipo sale con su ficha técnica y, si incluye servicio, con la constancia correspondiente para Protección Civil y STPS.',
  },
  {
    question: '¿Hacen entregas fuera de CDMX?',
    answer: 'Atendemos CDMX, Estado de México y zona metropolitana. Para instalación y mantenimiento cubrimos esas mismas zonas. Cuéntanos dónde estás y te confirmamos cobertura y tiempos.',
  },
];

const schemaData = {
  list: {
    name: 'Equipo contra incendio',
    description: 'Catálogo de equipo contra incendio: extintores, detección y alarmas, hidrantes y mangueras, y señalización de emergencia.',
    path: '/productos',
    items: productos.map((p) => ({
      name: p.data.title,
      path: `/productos/${p.id}`,
      image: p.data.image,
      description: p.data.description,
    })),
  },
  faqs,
};
---

<PageLayout
  title="Catálogo de equipo contra incendio"
  description="Catálogo de equipo contra incendio: extintores, detección y alarmas, hidrantes, mangueras y señalización. Cotiza por WhatsApp — CDMX y Estado de México."
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Productos' }]}
  guia={false}
>

  {/* ─── Hero (componente compartido, idéntico al index) ─── */}
  <Hero
    badge="Catálogo · CDMX y Estado de México"
    title="Catálogo de equipo,"
    accent="para cada riesgo"
    subtitle="Extintores, detección y alarmas, hidrantes y mangueras, señalización, sistemas fijos y equipo de protección personal — con instalación, mantenimiento y documentación para Protección Civil y STPS."
    descRight={[
      'Reunimos en un solo catálogo el equipo contra incendio que tu inmueble necesita: extintores, detección y alarma, hidrantes y mangueras, señalización y sistemas fijos. Todo dimensionado al riesgo real del lugar, no a un catálogo genérico.',
      'Cada equipo se entrega con ficha técnica y la documentación de servicio lista para tu expediente ante Protección Civil y STPS. Cotiza por WhatsApp y recibe una recomendación honesta.',
    ]}
    ctas={[
      { text: 'Ver catálogo', href: '#categorias', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.productos), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Barra de confianza (pilares honestos) ─── */}
  <TrustBar items={pillars} />

  {/* ─── Categorías (vitrina SHOWCASE) ─── */}
  <section class="section section--surface" id="categorias">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Catálogo por familia"
        title="Ocho familias de"
        titleAccent="equipo contra incendio"
        desc="Selecciona la familia que necesitas o cotiza varias a la vez."
        body={[
          'Cada familia agrupa los equipos por función y tipo de riesgo que cubre. Puedes pedir equipo de varias familias en una sola cotización.',
          'Si no sabes por dónde empezar, escríbenos: revisamos tu inmueble y te decimos exactamente qué necesitas, sin venderte de más.',
        ]}
      />
      <div class="showcase">
        {SHOWCASE.map((c, i) => (
          <CategoryCard
            label={c.label}
            href={c.href}
            image={c.image}
            imageAlt={c.imageAlt}
            badge={c.badge}
            blurb={c.blurb}
            subcategories={c.subcategories}
            ctaLabel={c.ctaLabel}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Módulos de categoría (CategoryFeature) — como el index, copy propio ─── */}
  {CATEGORY_FEATURES.map((c) => (
    <CategoryFeature
      eyebrow={c.eyebrow}
      title={c.title}
      titleAccent={c.titleAccent}
      description={c.description}
      features={c.features}
      brands={c.brands}
      ctaLabel={c.ctaLabel}
      ctaHref={waUrl(c.ctaMsg)}
      ctaExternal
      imgMain={c.imgMain}
      imgA={c.imgA}
      imgB={c.imgB}
    />
  ))}

  {/* ─── Productos individuales ─── */}
  {productos.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeading
          layout="duo"
          eyebrow="Productos destacados"
          title="Equipo disponible"
          titleAccent="en stock"
          desc="Fichas técnicas de los productos de mayor rotación."
          body={[
            'Cada ficha incluye especificaciones técnicas, norma aplicable y el agente o uso recomendado. El precio varía según cantidad y si incluye servicio.',
            'Pide cotización por WhatsApp indicando el producto y la cantidad — te respondemos con precio, disponibilidad y tiempos de entrega.',
          ]}
        />
        <div class="showcase">
          {productos.map((p, i) => (
            <ProductCard
              title={p.data.title}
              href={`/productos/${p.id}`}
              image={p.data.image}
              imageAlt={p.data.title}
              badge={CAT_LABEL[p.data.category] ?? p.data.category}
              description={p.data.description}
              index={i}
              priority={i === 0}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ─── Banda de normas ─── */}
  <section class="norms-strip">
    <div class="container">
      <p class="norms-strip__label">Normatividad que respaldamos</p>
      <div class="norms-strip__list">
        {[
          'NOM-002-STPS-2010',
          'NOM-154-SCFI-2005',
          'NOM-003-SEGOB-2011',
          'NOM-026-STPS-2008',
          'NFPA 10',
          'NFPA 13',
          'NFPA 14',
          'NFPA 72',
        ].map((n) => (
          <span class="norms-strip__badge">{n}</span>
        ))}
      </div>
    </div>
  </section>

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={faqs} waNumber={CONTACT.whatsapp} />

</PageLayout>

<style>
  /* Contenedores y secciones canónicos (idénticos al index.astro). */
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }

  /* Grid de tarjetas: mismo patrón que la vitrina del home (.showcase). */
  .showcase { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); margin-top: var(--sp-6); }
