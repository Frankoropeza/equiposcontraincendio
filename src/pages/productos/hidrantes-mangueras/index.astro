---
// Página L3 de hidrantes y mangueras: el patrón compartido vive en ServiceL3.
import ServiceL3 from '@components/ServiceL3.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('l3', 'productos/hidrantes-mangueras');
if (!entry) throw new Error('Falta la entrada L3: productos/hidrantes-mangueras');
---

<ServiceL3 data={entry.data} />
