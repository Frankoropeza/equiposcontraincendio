---
// Página L3 de accesorios y refacciones: el patrón compartido vive en ServiceL3.
import ServiceL3 from '@components/ServiceL3.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('l3', 'productos/accesorios');
if (!entry || 'kind' in entry.data && entry.data.kind === 'extintores') throw new Error('Falta la entrada L3: productos/accesorios');
---

<ServiceL3 data={entry.data} />
