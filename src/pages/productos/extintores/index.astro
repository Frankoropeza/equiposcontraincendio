---
// /productos/extintores/ — PATRÓN L3 canónico; referencia: /servicios/mantenimiento/.
// Bloques: Hero → SectionMenu + TrustBar → vitrina → catálogo → usos →
// comparativa → clases de fuego → capacidad → módulos por agente →
// portátil/ruedas → marcas → proceso → normas → empresa → enlaces → FAQ.
// Propios de esta L3 de producto: catálogo filtrable, usos por giro y marcas.
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/Hero.astro';
import SectionMenu from '@components/SectionMenu.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CategoryFeature from '@components/CategoryFeature.astro';
import RiskGuide from '@components/RiskGuide.astro';
import NormsTable from '@components/NormsTable.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import CompanyAbout from '@components/CompanyAbout.astro';
import GirosQueLoNecesitan from '@components/GirosQueLoNecesitan.astro';
import RelatedLinks from '@components/RelatedLinks.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import ExtintorCatalog from '@components/ExtintorCatalog.astro';
import UsoGrid from '@components/UsoGrid.astro';
import BrandGrid from '@components/BrandGrid.astro';
import DataTable from '@components/DataTable.astro';
import { getCollection, getEntry } from 'astro:content';
import { CONTACT, waUrl, sectionMenuItems } from '@config/site';
import { slugify } from '@lib/slug';
import {
  extSeo,
  extUsos,
  extCapacidades,
  extAgentesCols,
  extAgentesRows,
  extFormatoCols,
  extFormatoRows,
  extMarcas,
  extMarcasNota,
  extSecciones,
} from '@data/extintores-catalogo';

const entry = await getEntry('l3', 'productos/extintores');
if (!entry || entry.data.kind !== 'extintores') throw new Error('Falta la entrada L3: productos/extintores');
const { hero: extintoresHero, tarjetas: extintoresTarjetas, features: extintoresFeatures, clases: extintoresClases, normRows: extintoresNormRows, steps: extintoresSteps, company: extintoresCompany, related: extintoresRelated, faqs: extintoresFaqs } = entry.data;

const fichas = (
  await getCollection('productos', ({ data }) => !data.draft && data.category === 'extintores')
).sort((a, b) => a.data.order - b.data.order);

const items = fichas.flatMap((ficha) =>
  (ficha.data.variantes ?? [])
    .filter((variante) => variante.agente)
    .map((variante) => ({
      id: `${ficha.id}--${slugify(variante.nombre)}`,
      fichaId: ficha.id,
      fichaTitle: ficha.data.title,
      fichaHref: `/productos/${ficha.id}/#${slugify(variante.nombre)}`,
      ...variante,
    })),
);

const WA_EXTINTORES = 'Hola, quiero cotizar extintores. ¿Me ayudan a elegir el agente y la capacidad para mi inmueble?';
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_EXTINTORES),
  sub: 'Te decimos cuál conviene',
  external: true,
};
const schemaData = {
  list: {
    name: 'Catálogo de extintores',
    description: extSeo.description,
    path: '/productos/extintores/',
    items: fichas.map((p) => ({
      name: p.data.title,
      path: `/productos/${p.id}/`,
      // Los SVG son carteles «Imagen próximamente»: no se publican como imagen
      // de producto en el ItemList. Al llegar la foto real, entra sola.
      image: p.data.image?.endsWith('.svg') ? undefined : p.data.image,
      description: p.data.description,
    })),
  },
  faqs: extintoresFaqs,
};
---

<PageLayout
  title={extSeo.title}
  description={extSeo.description}
  image={extSeo.image}
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Productos', href: '/productos/' }, { label: 'Extintores' }]}
>
  {/* ─── Hero ─── */}
  <Hero
    badge={extintoresHero.badge}
    title={extSeo.heroTitle}
    accent={extSeo.heroAccent}
    subtitle={extintoresHero.subtitle}
    descRight={extintoresHero.descRight}
    ctas={[
      { text: 'Catálogo de extintores', href: '#catalogo', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_EXTINTORES), variant: 'primary', whatsapp: true },
    ]}
  />

  {/* ─── Navegación y confianza ─── */}
  <SectionMenu items={sectionMenuItems()} cta={menuCta} />

  {/* ─── Vitrina: una tarjeta por agente y servicio relacionado ─── */}
  <section class="section" id="agentes">
    <div class="container">
      <SectionHeading layout="duo" {...extSecciones.familias} />
      <div class="card-grid">
        {extintoresTarjetas.map((tarjeta) => (
          <ServiceCard
            title={tarjeta.title}
            href={tarjeta.href}
            image={tarjeta.image}
            imageAlt={tarjeta.imageAlt}
            badge={tarjeta.badge}
            description={tarjeta.description}
            specs={tarjeta.specs}
            ctaLabel={tarjeta.ctaLabel}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Catálogo filtrable ─── */}
  <ExtintorCatalog items={items} copy={extSecciones.catalogo} />
  <UsoGrid rows={extUsos} copy={extSecciones.negocio} />

  {/* ─── Comparativa de agentes ─── */}
  <DataTable
    id="comparativa"
    {...extSecciones.comparativa}
    columns={extAgentesCols}
    rows={extAgentesRows}
    surface
  />

  {/* ─── Clases de fuego ─── */}
  <RiskGuide
    eyebrow="Clases de fuego"
    title="Qué extintor usar"
    titleAccent="en cada clase de fuego"
    desc="Qué agente apaga cada tipo de fuego y, sobre todo, con cuál no hay que atacarlo."
    body={[
      'La clase de fuego describe lo que arde, y cada agente está clasificado para unas clases y no para otras. La etiqueta del extintor lo indica con letras y pictogramas.',
      'Fíjate en la última columna. Agua sobre aceite de cocina o sobre un tablero con corriente convierte un conato en una emergencia.',
    ]}
    rows={extintoresClases}
    columns={['Clase', 'Qué arde', 'Agente que sí', 'Agente que no']}
    note="Casi todos los inmuebles combinan varias clases de fuego. Se protegen por zonas: cada área lleva el agente de lo que ahí puede arder."
    ctaLabel="Riesgo de incendio"
    ctaHref="/herramientas/riesgo-de-incendio/"
  />

  <DataTable
    id="por-capacidad"
    {...extSecciones.capacidad}
    columns={['Rango de capacidad', 'Perfil', 'Dónde conviene', 'A considerar']}
    rows={extCapacidades.map((row) => [row.rango, row.perfil, row.conviene, row.considera])}
    ctaLabel={extSecciones.capacidad.ctaLabel}
    ctaHref={extSecciones.capacidad.ctaHref}
    surface
  />

  {/* ─── Módulos por agente ───
      Todos idénticos: texto en la columna izquierda, galería en la derecha, fondo
      blanco. NO se alterna `flip` ni `surface`. El zig-zag rompía la homologación
      con el resto del sitio (2026-09-10): el ojo tiene que encontrar el texto
      siempre en el mismo lugar al bajar por una pila de módulos. ─── */}
  {extintoresFeatures.map((feature) => (
    <CategoryFeature
      anchorId={feature.id}
      eyebrow={feature.eyebrow}
      title={feature.title}
      titleAccent={feature.titleAccent}
      description={feature.description}
      features={feature.features}
      ctaLabel={feature.ctaLabel}
      ctaHref={feature.ctaHref}
      ctaSecondaryLabel={feature.ctaSecondaryLabel}
      ctaSecondaryHref={waUrl(feature.ctaMsg)}
      ctaSecondaryExternal
      imgMain={feature.imgMain}
      imgA={feature.imgA}
      imgB={feature.imgB}
    />
  ))}

  <DataTable
    id="portatil-o-ruedas"
    {...extSecciones.formato}
    columns={extFormatoCols}
    rows={extFormatoRows}
    surface
  />

  {/* ─── Marcas ─── */}
  <BrandGrid marcas={extMarcas} nota={extMarcasNota} copy={extSecciones.marcas} />

  {/* ─── Proceso de servicio ─── */}
  <ProcessSteps
    eyebrow="Después de comprarlo"
    title="Lo que le toca a un extintor"
    titleAccent="mientras está en servicio"
    desc="Comprarlo es el primer paso. En una inspección lo que se revisa es que siga vigente."
    body={[
      'Un extintor vencido o sin revisión cuenta como si no existiera. La norma pide revisarlo cada mes, darle mantenimiento al menos una vez al año y probar el cilindro por lo menos cada 5 años.',
      'La revisión mensual la puede hacer tu propio personal y anotarla en la bitácora. El mantenimiento, la recarga y la prueba hidrostática los hace un proveedor, y ese servicio lo damos nosotros.',
    ]}
    steps={extintoresSteps}
  />

  {/* ─── Normas, empresa y contacto ─── */}
  <NormsTable
    eyebrow="Normatividad"
    title="Normas oficiales mexicanas"
    titleAccent="para extintores"
    desc="Cada agente tiene su norma de producto. La colocación y el servicio se rigen igual para todos."
    body={[
      'Las normas de producto dicen cómo debe fabricarse cada extintor. La NOM-002 dice cuántos se colocan y dónde, y la NOM-154 cómo se les da servicio.',
      'La clase K y el agente limpio no tienen norma mexicana de producto propia. En clase K se toma como referencia la NFPA 10, que no es ley federal, aunque algunas aseguradoras y corporativos la piden.',
    ]}
    rows={extintoresNormRows}
    columns={['Norma', 'Qué regula', 'Aplica a']}
    note="Normas de producto consultadas en el catálogo de normas de la Secretaría de Economía, donde figuran vigentes. Cada extintor se entrega con su ficha técnica para tu expediente."
  />
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Por qué con nosotros"
        title="Tus extintores y su servicio"
        titleAccent="con un solo proveedor"
        desc="Venta y recarga de extintores con un solo proveedor: el equipo correcto y su servicio al día."
        body={[
          'Vendemos el extintor y le damos el mantenimiento, la recarga y la prueba hidrostática que pide la norma. Así no tienes que buscar a otro proveedor cada año ni armar el expediente con papeles de tres empresas.',
          'Escríbenos por WhatsApp con tu giro y la superficie, y te decimos qué agente y qué capacidad te tocan.',
        ]}
      />
      <CompanyAbout
        que={extintoresCompany.que}
        como={extintoresCompany.como}
        cta={{ label: 'Cotizar por WhatsApp', href: waUrl(WA_EXTINTORES), external: true }}
      />
    </div>
  </section>
  <GirosQueLoNecesitan nombre="extintores" />
  <RelatedLinks
    title="Servicios y guías relacionados"
    desc="Lo que suele hacer falta después de elegir el extintor."
    links={extintoresRelated}
    limit={8}
  />
  <FAQWithContact
    items={extintoresFaqs}
    waNumber={CONTACT.whatsapp}
    eyebrow="Preguntas frecuentes"
    title="Preguntas frecuentes"
    titleAccent="sobre extintores"
    desc="Lo que más nos preguntan antes de comprar un extintor: dónde, cuánto cuesta, cuál elegir y qué le toca después."
    body={[
      'Si tu caso no aparece aquí, escríbenos con el giro, la superficie y lo que se guarda en el lugar. Con eso te decimos qué equipo te conviene.',
      'Las respuestas citan la norma cuando aplica; lo que depende de tu inmueble lo revisamos contigo.',
    ]}
  />
</PageLayout>

<style>
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }

  .section {
    padding: var(--sp-8) 0;
  }

  .section--surface {
    background: var(--c-surface);
  }

  @media (min-width: 768px) {
    .section {
      padding: var(--sp-10) 0;
    }
  }
</style>
