---
// /productos/extintores/ — catálogo L3 de extintores portátiles.
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/Hero.astro';
import SectionMenu from '@components/SectionMenu.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ProductCard from '@components/ProductCard.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CategoryFeature from '@components/CategoryFeature.astro';
import TrustBar from '@components/TrustBar.astro';
import RiskGuide from '@components/RiskGuide.astro';
import NormsTable from '@components/NormsTable.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import CompanyAbout from '@components/CompanyAbout.astro';
import RelatedLinks from '@components/RelatedLinks.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import ExtintorCatalog from '@components/ExtintorCatalog.astro';
import UsoGrid from '@components/UsoGrid.astro';
import BrandGrid from '@components/BrandGrid.astro';
import DataTable from '@components/DataTable.astro';
import { getCollection } from 'astro:content';
import { CONTACT, waUrl, sectionMenuItems } from '@config/site';
import { slugify } from '@lib/slug';
import {
  extSeo,
  extUsos,
  extCapacidades,
  extAgentesCols,
  extAgentesRows,
  extFormatoCols,
  extFormatoRows,
  extServicioCols,
  extServicioRows,
  extMarcas,
  extMarcasNota,
  extSecciones,
  extAccesoriosLinks,
} from '@data/extintores-catalogo';
import {
  extintoresHero,
  extintoresPillars,
  extintoresFichas,
  extintoresFeatures,
  extintoresClases,
  extintoresNormRows,
  extintoresSteps,
  extintoresCompany,
  extintoresRelated,
  extintoresFaqs,
} from '@data/extintores';

const fichas = (
  await getCollection('productos', ({ data }) => !data.draft && data.category === 'extintores')
).sort((a, b) => a.data.order - b.data.order);

const items = fichas.flatMap((ficha) =>
  (ficha.data.variantes ?? [])
    .filter((variante) => variante.agente)
    .map((variante) => ({
      id: `${ficha.id}--${slugify(variante.nombre)}`,
      fichaId: ficha.id,
      fichaTitle: ficha.data.title,
      fichaHref: `/productos/${ficha.id}/#${slugify(variante.nombre)}`,
      ...variante,
    })),
);

const WA_EXTINTORES = 'Hola, quiero cotizar extintores. ¿Me ayudan a elegir el agente y la capacidad para mi inmueble?';
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_EXTINTORES),
  sub: 'Respuesta inmediata',
  external: true,
};
const schemaData = {
  list: {
    name: 'Catálogo de extintores',
    description: extSeo.description,
    path: '/productos/extintores/',
    items: fichas.map((p) => ({
      name: p.data.title,
      path: `/productos/${p.id}/`,
      image: p.data.image,
      description: p.data.description,
    })),
  },
  faqs: extintoresFaqs,
};
---

<PageLayout
  title={extSeo.title}
  description={extSeo.description}
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Productos', href: '/productos/' }, { label: 'Extintores portátiles' }]}
  guia={false}
>
  {/* ─── Hero ─── */}
  <Hero
    badge={extintoresHero.badge}
    title={extSeo.heroTitle}
    accent={extSeo.heroAccent}
    subtitle={extintoresHero.subtitle}
    descRight={extintoresHero.descRight}
    ctas={[
      { text: 'Catálogo de extintores', href: '#catalogo', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_EXTINTORES), variant: 'primary', whatsapp: true },
    ]}
  />

  {/* ─── Navegación y confianza ─── */}
  <SectionMenu items={sectionMenuItems()} cta={menuCta} />
  <TrustBar items={extintoresPillars} />

  {/* ─── Familias ─── */}
  <section class="section" id="agentes">
    <div class="container">
      <SectionHeading layout="duo" {...extSecciones.familias} />
      <div class="card-grid card-grid--trio">
        {fichas.map((ficha, index) => (
          <ProductCard
            title={ficha.data.title}
            href={`/productos/${ficha.id}/`}
            image={extintoresFichas[ficha.id]?.image ?? ficha.data.image}
            imageAlt={extintoresFichas[ficha.id]?.imageAlt ?? ficha.data.title}
            badge={extintoresFichas[ficha.id]?.badge}
            description={extintoresFichas[ficha.id]?.blurb ?? ficha.data.description}
            ctaLabel={extintoresFichas[ficha.id]?.ctaLabel}
            index={index}
            priority={index === 0}
          />
        ))}
        <ServiceCard
          title="Recarga y mantenimiento"
          href="/servicios/mantenimiento/"
          image="/images/servicios/inspeccion-recarga-extintores.avif"
          imageAlt="Recarga y mantenimiento de extintores en taller de servicio"
          badge="Servicio NOM-154"
          description="Mantenimiento anual, recarga después de cualquier uso y prueba hidrostática para los extintores que ya tienes."
          ctaLabel="Recarga de extintores"
        />
      </div>
    </div>
  </section>

  {/* ─── Catálogo, negocios y capacidades ─── */}
  <ExtintorCatalog items={items} copy={extSecciones.catalogo} />
  <UsoGrid rows={extUsos} copy={extSecciones.negocio} />
  <DataTable
    id="por-capacidad"
    {...extSecciones.capacidad}
    columns={['Rango de capacidad', 'Perfil', 'Dónde conviene', 'A considerar']}
    rows={extCapacidades.map((row) => [row.rango, row.perfil, row.conviene, row.considera])}
    ctaLabel={extSecciones.capacidad.ctaLabel}
    ctaHref={extSecciones.capacidad.ctaHref}
    surface
  />
  {/* ─── Clases de fuego, comparativa y formatos ─── */}
  <RiskGuide
    eyebrow="Clases de fuego"
    title="Qué agente apaga"
    titleAccent="cada clase de fuego"
    desc="Y, lo que casi nadie publica, con cuál no hay que atacarlo."
    body={[
      'La clase de fuego describe lo que arde, y cada agente está clasificado para unas clases y no para otras. La etiqueta del extintor lo indica con letras y pictogramas.',
      'La columna de la derecha es la que evita accidentes: el agua sobre aceite de cocina o sobre un tablero energizado convierte un conato en una emergencia.',
    ]}
    rows={extintoresClases}
    columns={['Clase', 'Qué arde', 'Agente que sí', 'Agente que no']}
    note="La mayoría de los inmuebles combina varias clases de fuego. En ese caso se protege por zonas: el agente se elige para lo que arde en cada una, no para el inmueble completo."
    ctaLabel="Riesgo de incendio"
    ctaHref="/herramientas/riesgo-de-incendio/"
  />
  <DataTable
    id="comparativa"
    {...extSecciones.comparativa}
    columns={extAgentesCols}
    rows={extAgentesRows}
    surface
  />

  <DataTable
    id="portatil-o-ruedas"
    {...extSecciones.formato}
    columns={extFormatoCols}
    rows={extFormatoRows}
  />

  {/* ─── Módulos por agente (fondos alternados, empezando en surface) ─── */}
  {extintoresFeatures.map((feature, i) => (
    <CategoryFeature
      anchorId={feature.id}
      eyebrow={feature.eyebrow}
      title={feature.title}
      titleAccent={feature.titleAccent}
      description={feature.description}
      features={feature.features}
      ctaLabel={feature.ctaLabel}
      ctaHref={feature.ctaHref}
      ctaSecondaryLabel={feature.ctaSecondaryLabel}
      ctaSecondaryHref={waUrl(feature.ctaMsg)}
      ctaSecondaryExternal
      imgMain={feature.imgMain}
      imgA={feature.imgA}
      imgB={feature.imgB}
      surface={i % 2 === 0}
      flip={i % 2 === 1}
    />
  ))}

  {/* ─── Marcas y accesorios ─── */}
  <BrandGrid marcas={extMarcas} nota={extMarcasNota} copy={extSecciones.marcas} />
  <RelatedLinks
    title={extSecciones.accesorios.title}
    desc={extSecciones.accesorios.desc}
    links={extAccesoriosLinks}
    limit={4}
  />

  {/* ─── Mantenimiento ─── */}
  <DataTable
    id="mantenimiento"
    {...extSecciones.mantenimiento}
    columns={extServicioCols}
    rows={extServicioRows}
    ctaLabel={extSecciones.mantenimiento.ctaLabel}
    ctaHref={extSecciones.mantenimiento.ctaHref}
  />
  <ProcessSteps
    eyebrow="Después de comprarlo"
    title="Lo que le toca a un extintor"
    titleAccent="durante su vida útil"
    desc="Comprarlo es el primer paso; mantenerlo vigente es lo que revisa la autoridad."
    body={[
      'Un extintor vencido o sin revisión cuenta como si no existiera en una inspección. La norma pide una revisión mensual, un mantenimiento anual y una prueba del cilindro cada 5 años.',
      'Las dos primeras las puedes llevar tú con la bitácora; el mantenimiento y la prueba hidrostática los hace un proveedor, y nosotros los hacemos.',
    ]}
    steps={extintoresSteps}
  />

  {/* ─── Normas, empresa y contacto ─── */}
  <NormsTable
    eyebrow="Norma por agente"
    title="Qué norma respalda"
    titleAccent="cada tipo de extintor"
    desc="Cada agente tiene su norma de producto; el servicio y la colocación son comunes a todos."
    body={[
      'Las normas de producto dicen cómo debe fabricarse cada extintor; la NOM-002 dice dónde y cuántos se colocan, y la NOM-154 cómo se les da servicio.',
      'La clase K no tiene una norma mexicana de producto propia: se toma como referencia técnica la NFPA 10, que no es ley federal pero sí la exigen aseguradoras y corporativos.',
    ]}
    rows={extintoresNormRows}
    columns={['Norma', 'Qué regula', 'Aplica a']}
    note="Normas de producto consultadas en el catálogo de normas de la Secretaría de Economía, donde figuran vigentes. Cada extintor se entrega con su ficha técnica para tu expediente."
  />
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Sobre esta familia"
        title="Cinco familias,"
        titleAccent="un solo proveedor"
        desc="El extintor y el servicio que pide durante toda su vida útil."
        body={[
          'Vendemos el extintor y le damos el mantenimiento, la recarga y la prueba hidrostática que la norma pide, para que no tengas que buscar a otro proveedor cada año.',
          'Cotiza por WhatsApp y te decimos qué agente y qué capacidad te tocan.',
        ]}
      />
      <CompanyAbout
        que={extintoresCompany.que}
        como={extintoresCompany.como}
        cta={{ label: 'Cotizar por WhatsApp', href: waUrl(WA_EXTINTORES), external: true }}
      />
    </div>
  </section>
  <RelatedLinks
    title="Sigue por aquí"
    desc="Lo que suele hacer falta después de elegir el extintor."
    links={extintoresRelated}
    limit={4}
  />
  <FAQWithContact items={extintoresFaqs} waNumber={CONTACT.whatsapp} />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
</style>
