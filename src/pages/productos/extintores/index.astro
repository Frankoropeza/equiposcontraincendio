---
// ============================================================================
// /productos/extintores/ — Categoría «Extintores portátiles» (L3).
// ----------------------------------------------------------------------------
// PRIMERA L3 (2026-09-10). Inicio → Productos (L2) → Extintores (L3) → ficha (L4).
// Las fichas conservan su URL plana (/productos/extintor-pqs/); la jerarquía
// la dan las migas y el BreadcrumbList, sin redirecciones.
//
// Mismo esqueleto que las L2:
//   Hero → SectionMenu → TrustBar → vitrina de fichas → módulos
//   CategoryFeature → RiskGuide → NormsTable → ProcessSteps → CompanyAbout →
//   RelatedLinks → FAQ + Contacto
//
// Las fichas se leen de la colección `productos` (category: extintores); el
// resto del contenido vive en src/data/extintores.ts, donde también está el
// ángulo de esta página frente a /productos/ y a las fichas.
// ============================================================================
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import SectionHeading from '@components/SectionHeading.astro'
import ProductCard from '@components/ProductCard.astro'
import CategoryFeature from '@components/CategoryFeature.astro'
import TrustBar from '@components/TrustBar.astro'
import RiskGuide from '@components/RiskGuide.astro'
import NormsTable from '@components/NormsTable.astro'
import ProcessSteps from '@components/ProcessSteps.astro'
import CompanyAbout from '@components/CompanyAbout.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import { getCollection } from 'astro:content'
import { CONTACT, waUrl, sectionMenuItems } from '@config/site'
import {
  extintoresPillars,
  extintoresFichas,
  extintoresFeatures,
  extintoresClases,
  extintoresNormRows,
  extintoresSteps,
  extintoresCompany,
  extintoresRelated,
  extintoresFaqs,
} from '@data/extintores'

const fichas = (
  await getCollection('productos', ({ data }) => !data.draft && data.category === 'extintores')
).sort((a, b) => a.data.order - b.data.order)

const WA_EXTINTORES = 'Hola, quiero cotizar extintores. ¿Me ayudan a elegir el agente y la capacidad para mi inmueble?'

const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_EXTINTORES),
  sub: 'Respuesta inmediata',
  external: true,
}

const schemaData = {
  list: {
    name: 'Extintores portátiles contra incendio',
    description:
      'Extintores de polvo químico seco ABC, CO₂, agente K para cocina y a base de agua, en presentaciones portátiles y móviles.',
    path: '/productos/extintores/',
    items: fichas.map((p) => ({
      name: p.data.title,
      path: `/productos/${p.id}/`,
      image: p.data.image,
      description: p.data.description,
    })),
  },
  faqs: extintoresFaqs,
}
---

<PageLayout
  title="Venta de extintores contra incendio en CDMX y Edomex"
  description="Extintores PQS ABC, CO₂, clase K y a base de agua, portátiles y sobre ruedas: qué apaga cada agente, en qué capacidades y con recarga incluida."
  pageType="category"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Productos', href: '/productos/' }, { label: 'Extintores portátiles' }]}
  guia={false}
>
  <Hero
    badge="Extintores portátiles · CDMX y Edomex"
    title="Extintores contra incendio,"
    accent="según lo que puede arder"
    subtitle="Polvo químico seco ABC, CO₂, agente K para cocina y la familia a base de agua, en portátil y sobre ruedas, con recarga y prueba hidrostática del mismo proveedor."
    descRight={[
      'Un extintor no se elige por tamaño ni por color: se elige por la clase de fuego que puede presentarse en cada zona. El agente equivocado no solo falla; puede avivar el incendio o exponer a quien lo usa.',
      'Aquí están los cuatro agentes que manejamos, qué apaga cada uno y dónde no debe usarse. Cada ficha trae sus presentaciones y capacidades para cotizar la exacta.',
    ]}
    ctas={[
      { text: 'Extintores por agente', href: '#agentes', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_EXTINTORES), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Barra de confianza (pilares honestos) ─── */}
  <TrustBar items={extintoresPillars} />

  {/* ─── Vitrina: una ficha L4 por agente ─── */}
  <section class="section section--surface" id="agentes">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Por agente extintor"
        title="Cuatro agentes,"
        titleAccent="cuatro fichas"
        desc="Entra a la ficha del agente para ver todas sus presentaciones."
        body={[
          'Cada ficha reúne las capacidades de un mismo agente, del portátil compacto a la unidad sobre ruedas, con lo que conviene revisar antes de elegir una.',
          'Si todavía no sabes qué agente te toca, la tabla de clases de fuego de más abajo lo resuelve en un vistazo.',
        ]}
      />
      <div class="card-grid">
        {fichas.map((p, i) => (
          <ProductCard
            title={p.data.title}
            href={`/productos/${p.id}/`}
            image={p.data.image}
            imageAlt={p.data.title}
            badge={extintoresFichas[p.id]?.badge}
            description={extintoresFichas[p.id]?.blurb ?? p.data.description}
            ctaLabel={extintoresFichas[p.id]?.ctaLabel}
            index={i}
            priority={i === 0}
          />
        ))}
      </div>
    </div>
  </section>

  {/* ─── Módulos por agente (CategoryFeature) ─── */}
  {extintoresFeatures.map((c) => (
    <CategoryFeature
      anchorId={c.id}
      eyebrow={c.eyebrow}
      title={c.title}
      titleAccent={c.titleAccent}
      description={c.description}
      features={c.features}
      ctaLabel={c.ctaLabel}
      ctaHref={c.ctaHref}
      ctaSecondaryLabel={c.ctaSecondaryLabel}
      ctaSecondaryHref={waUrl(c.ctaMsg)}
      ctaSecondaryExternal
      imgMain={c.imgMain}
      imgA={c.imgA}
      imgB={c.imgB}
    />
  ))}

  {/* ─── Qué agente apaga cada clase de fuego ─── */}
  <RiskGuide
    eyebrow="Clases de fuego"
    title="Qué agente apaga"
    titleAccent="cada clase de fuego"
    desc="Y, lo que casi nadie publica, con cuál no hay que atacarlo."
    body={[
      'La clase de fuego describe lo que arde, y cada agente está clasificado para unas clases y no para otras. La etiqueta del extintor lo indica con letras y pictogramas.',
      'La columna de la derecha es la que evita accidentes: el agua sobre aceite de cocina o sobre un tablero energizado convierte un conato en una emergencia.',
    ]}
    rows={extintoresClases}
    columns={['Clase', 'Qué arde', 'Agente que sí', 'Agente que no']}
    note="La mayoría de los inmuebles combina varias clases de fuego. En ese caso se protege por zonas: el agente se elige para lo que arde en cada una, no para el inmueble completo."
    ctaLabel="Riesgo de incendio"
    ctaHref="/herramientas/riesgo-de-incendio/"
  />

  {/* ─── Qué norma certifica cada agente ─── */}
  <NormsTable
    eyebrow="Norma por agente"
    title="Qué norma respalda"
    titleAccent="cada tipo de extintor"
    desc="Cada agente tiene su norma de producto; el servicio y la colocación son comunes a todos."
    body={[
      'Las normas de producto dicen cómo debe fabricarse cada extintor; la NOM-002 dice dónde y cuántos se colocan, y la NOM-154 cómo se les da servicio.',
      'La clase K no tiene una norma mexicana de producto propia: se toma como referencia técnica la NFPA 10, que no es ley federal pero sí la exigen aseguradoras y corporativos.',
    ]}
    rows={extintoresNormRows}
    columns={['Norma', 'Qué regula', 'Aplica a']}
    note="Normas de producto consultadas en el catálogo de normas de la Secretaría de Economía, donde figuran vigentes. Cada extintor se entrega con su ficha técnica para tu expediente."
  />

  {/* ─── Ciclo de vida del extintor (proceso, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Después de comprarlo"
    title="Lo que le toca a un extintor"
    titleAccent="durante su vida útil"
    desc="Comprarlo es el primer paso; mantenerlo vigente es lo que revisa la autoridad."
    body={[
      'Un extintor vencido o sin revisión cuenta como si no existiera en una inspección. La norma pide una revisión mensual, un mantenimiento anual y una prueba del cilindro cada 5 años.',
      'Las dos primeras las puedes llevar tú con la bitácora; el mantenimiento y la prueba hidrostática los hace un proveedor, y nosotros los hacemos.',
    ]}
    steps={extintoresSteps}
  />

  {/* ─── Sobre esta familia ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Sobre esta familia"
        title="Cuatro agentes,"
        titleAccent="un solo proveedor"
        desc="El extintor y el servicio que pide durante toda su vida útil."
        body={[
          'Vendemos el extintor y le damos el mantenimiento, la recarga y la prueba hidrostática que la norma pide, para que no tengas que buscar a otro proveedor cada año.',
          'Cotiza por WhatsApp y te decimos qué agente y qué capacidad te tocan.',
        ]}
      />
      <CompanyAbout
        que={extintoresCompany.que}
        como={extintoresCompany.como}
        cta={{ label: 'Cotizar por WhatsApp', href: waUrl(WA_EXTINTORES), external: true }}
      />
    </div>
  </section>

  {/* ─── Interlinking ─── */}
  <RelatedLinks
    title="Sigue por aquí"
    desc="Lo que suele hacer falta después de elegir el extintor."
    links={extintoresRelated}
    limit={4}
  />

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={extintoresFaqs} waNumber={CONTACT.whatsapp} />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
</style>
