---
// Página L3 de capacitación de brigada y DC-3: el patrón compartido vive en ServiceL3.
import ServiceL3 from '@components/ServiceL3.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('l3', 'servicios/capacitacion-dc3');
if (!entry || 'kind' in entry.data && entry.data.kind === 'extintores') throw new Error('Falta la entrada L3: servicios/capacitacion-dc3');
---

<ServiceL3 data={entry.data} />
