---
// Página L3 de instalación de sistemas: el patrón compartido vive en ServiceL3.
import ServiceL3 from '@components/ServiceL3.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('l3', 'servicios/instalacion');
if (!entry) throw new Error('Falta la entrada L3: servicios/instalacion');
---

<ServiceL3 data={entry.data} />
