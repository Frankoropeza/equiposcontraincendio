---
// /servicios/ — Landing de Servicios (categoría L2). Lista SERVICES (SSoT site.ts).
// Cada tarjeta enlaza a /servicios/<id>, generada por [...slug].astro.
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import SectionMenu from '@components/SectionMenu.astro'
import { SERVICES, waUrl, WA_MESSAGES } from '@config/site'

const cierreItems = [
  { label: 'Productos', href: '/productos', sub: 'Catálogo de equipo' },
  { label: 'Cobertura', href: '/cobertura', sub: 'Zonas que atendemos' },
  { label: 'Nosotros', href: '/nosotros', sub: 'Cómo trabajamos' },
  { label: 'Contacto', href: '/contacto', sub: 'Hablemos de tu proyecto' },
]
const cierreCta = { label: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.servicios), sub: 'Respuesta inmediata', external: true }
---

<PageLayout
  title="Servicios contra incendio"
  description="Servicios contra incendio: instalación de sistemas, mantenimiento y recarga de extintores, e inspección y dictamen. Cada servicio con su página de detalle."
  pageType="category"
  breadcrumbs={[{ label: 'Servicios' }]}
  guia={false}
>
  <Hero
    badge="Servicios"
    title="No solo vendemos:"
    accent="instalamos y mantenemos"
    subtitle="De la instalación al mantenimiento, la recarga y la inspección: acompañamos tu protección contra incendio durante toda su vida útil."
    descRight={[
      'Un equipo contra incendio protege si está bien elegido, bien instalado y vigente. Por eso ofrecemos el ciclo completo y no solo la venta: proyecto e instalación, mantenimiento y recarga, e inspección con dictamen.',
      'Trabajamos conforme a la normatividad aplicable —NOM-002-STPS-2010 y NOM-154-SCFI-2005— y te entregamos un reporte claro de lo realizado.',
    ]}
  />

  <section class="section">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Lo que hacemos"
        title="Tres formas de"
        titleAccent="protegerte"
        desc="Instalación para construir, mantenimiento para conservar e inspección para verificar."
        body={[
          'Cada servicio se presenta como una etapa con un resultado claro, para que sepas en cuál estás y qué sigue. La claridad reduce la fricción y mejora el resultado.',
          'Cada tarjeta lleva a una página de detalle con lo que incluye, cómo se trabaja y las preguntas frecuentes.',
        ]}
      />

      <div class="grid">
        {SERVICES.map((s, i) => (
          <CategoryCard
            label={s.label}
            href={`/servicios/${s.id}`}
            blurb={s.desc}
            badge="Servicio"
            ctaLabel="Ver detalle"
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <SectionMenu items={cierreItems} cta={cierreCta} ariaLabel="Sigue explorando el sitio" />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); margin-top: var(--sp-6); }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
