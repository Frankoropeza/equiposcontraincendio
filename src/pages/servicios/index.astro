---
// /servicios/ — Landing L2 de servicios. Responde «¿qué servicio me toca,
// cada cuándo y qué evidencia deja?». Estructura: Hero → SectionMenu →
// tarjetas de servicio → módulos CategoryFeature → Calendario (RiskGuide) →
// NormsTable → ProcessSteps → Sobre el servicio → Reseñas → RelatedLinks → FAQ.
// El copy vive en src/data/servicios.ts; esta página solo compone. Sin TrustBar.
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import Section from '@components/Section.astro'
import SectionMenu from '@components/SectionMenu.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import CategoryFeature from '@components/CategoryFeature.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import RiskGuide from '@components/RiskGuide.astro'
import NormsTable from '@components/NormsTable.astro'
import ProcessSteps from '@components/ProcessSteps.astro'
import CompanyAbout from '@components/CompanyAbout.astro'
import Testimonios from '@components/Testimonios.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import {
  serviceFeatures,
  serviciosCalendario,
  serviciosNormRows,
  serviciosSteps,
  serviciosCompany,
  serviciosRelated,
  serviciosFaqs,
  serviciosTestimoniosHead,
  serviciosTestimoniosNombres,
  serviciosFaqHead,
} from '@data/servicios'
import ServiceCard from '@components/ServiceCard.astro'
import { getCollection } from 'astro:content'
import { testimonios } from '@data/testimonios'
import { SERVICES, SERVICE_ANCHOR, CONTACT, waUrl, WA_MESSAGES, sectionMenuItems } from '@config/site'

// Menú de secciones: subtítulos desde SECTION_MENU_SUB (site.ts), no un mapa
// local — así todas las páginas describen las secciones igual.
const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.servicios),
  sub: 'Te decimos qué te toca',
  external: true,
}

// ── Imagen y badge por servicio, LEÍDOS DE LA COLECCIÓN ──
// Antes esto era un mapa hardcodeado con solo 3 de los 7 servicios (el mismo
// anti-patrón D3 que la auditoría corrigió en la home): las otras 4 tarjetas
// salían sin imagen, y una de ellas quedaba sola y a media altura en la
// tercera fila del grid. La colección ya tiene `image` y `badge` de los 7.
const serviciosCol = await getCollection('servicios', ({ data }) => !data.draft)
const SERVICE_META = Object.fromEntries(
  serviciosCol.map((s) => [s.id, { image: s.data.image, badge: s.data.badge }]),
) as Record<string, { image?: string; badge?: string }>

const serviciosTestimonios = serviciosTestimoniosNombres
  .map((nombre) => testimonios.find((testimonio) => testimonio.nombre === nombre))
  .filter((testimonio): testimonio is (typeof testimonios)[number] => Boolean(testimonio))
---

<PageLayout
  title="Empresa de sistemas contra incendio en CDMX y Edomex"
  description="Empresa de sistemas contra incendio en CDMX y Edomex: servicio de instalación, mantenimiento y recarga, inspección, prueba hidrostática y capacitación DC-3."
  pageType="category"
  schemaData={{ faqs: serviciosFaqs }}
  breadcrumbs={[{ label: 'Servicios' }]}
>
  {/* ─── Hero (componente compartido, idéntico al index y a /productos) ─── */}
  <Hero
    badge="Servicios · CDMX y Estado de México"
    title="Servicio y mantenimiento de sistemas"
    accent={"contra\u00a0incendio"}
    subtitle="De la instalación al mantenimiento, la recarga y la inspección: acompañamos tu sistema contra incendio durante toda su vida útil."
    descRight={[
      'Un equipo contra incendio protege si está bien elegido, bien instalado y vigente. Por eso ofrecemos el ciclo completo y no solo la venta de equipos: diseño e instalación, mantenimiento y recarga, e inspección con dictamen.',
      'Trabajamos conforme a la NOM-002-STPS-2010 y la NOM-154-SCFI-2005, con el mismo estándar de seguridad para cada sistema contra incendio que instalamos o revisamos, y cada servicio termina con un reporte claro de lo realizado.',
    ]}
    ctas={[
      { text: 'Servicios contra incendio', href: '#servicios', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.servicios), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />


  {/* ─── Tarjetas de servicio ─── */}
  <Section surface id="servicios">
      <SectionHeading
        layout="duo"
        eyebrow="Lo que hacemos"
        title="Servicios para tu"
        titleAccent="sistema contra incendio"
        desc="Del proyecto y la instalación al expediente en regla, con la vigencia de cada equipo al día."
        body={[
          'La protección contra incendios no se compra una vez: se diseña, se instala, se revisa, se recarga, se prueba y se documenta. Cada etapa tiene su servicio, su periodicidad y su evidencia, y solo así el sistema sirve para prevenir incendios y controlarlos a tiempo.',
          'Atendemos el ciclo completo de instalación y mantenimiento de sistemas contra incendios —sistemas de alarma y detección de humo, red de hidrantes con su cuarto de bombas, rociadores automáticos, extintores y señalización—, con un diseño e ingeniería que parten del cálculo hidráulico y del grado de riesgo del inmueble.',
        ]}
      />
      <div class="card-grid">
        {SERVICES.map((s, i) => (
          <CategoryCard
            label={s.label}
            href={`/servicios/${s.id}/`}
            image={SERVICE_META[s.id]?.image}
            imageAlt={s.label}
            blurb={s.desc}
            badge={SERVICE_META[s.id]?.badge ?? 'Servicio'}
            ctaLabel={SERVICE_ANCHOR[s.id] ?? s.label}
            index={i}
          />
        ))}
        {/* Celda de cierre: 7 servicios en un grid de 4 columnas dejaban un
            hueco. La octava es la salida para quien no sabe cuál pedir. */}
        <ServiceCard
          title="¿No sabes qué servicio necesitas?"
          description="Cuéntanos giro y superficie y te decimos qué servicio pide la norma y cada cuándo."
          href={waUrl('Hola, no sé qué servicio necesito. ¿Me ayudan a saber qué me pide la norma para mi inmueble?')}
          image="/images/servicios/inspeccion-gabinete-manguera-contra-incendio.avif"
          imageAlt="Técnico inspeccionando un gabinete de manguera contra incendio"
          badge="Asesoría sin costo"
          ctaLabel="Diagnóstico por WhatsApp"
          whatsapp
        />
      </div>
  </Section>

  {/* ─── Módulos de servicio (CategoryFeature) — diseño uniforme, copy propio ─── */}
  {serviceFeatures.map(({ id, ctaSecondaryMsg, ...feature }) => (
    <CategoryFeature
      {...feature}
      anchorId={id}
      ctaSecondaryLabel="Cotizar por WhatsApp"
      ctaSecondaryHref={waUrl(ctaSecondaryMsg)}
      ctaSecondaryExternal
    />
  ))}

  {/* ─── Calendario de servicio: cada cuándo toca cada cosa ─── */}
  <RiskGuide
    eyebrow="Calendario de servicio"
    title="Protección contra incendios: cada cuándo toca"
    titleAccent="y qué evidencia deja"
    desc="La periodicidad no la fija el proveedor: la fija la norma."
    body={[
      'La pregunta que más se repite no es cuánto cuesta, sino cada cuándo toca. Aquí está el calendario completo, con la norma que obliga cada servicio y la evidencia que debe quedar en tu expediente.',
      'Si no sabes en qué punto del calendario estás, el levantamiento inicial lo resuelve: se revisa qué equipo hay y cuándo venció cada pieza.',
    ]}
    rows={serviciosCalendario}
    columns={['Servicio', 'Cada cuándo', 'Qué lo obliga', 'Evidencia que queda']}
    note="La revisión mensual la hace tu propio personal y solo requiere bitácora; el mantenimiento anual y la prueba hidrostática los presta un proveedor. La brigada es obligatoria únicamente en centros de trabajo de riesgo alto, y la constancia DC-3 no tiene vigencia fijada por norma."
    ctaLabel="Verifica tu extintor"
    ctaHref="/herramientas/verifica-tu-extintor/"
  />

  {/* ─── Respaldo normativo del servicio ─── */}
  <NormsTable
    eyebrow="Respaldo normativo"
    title="Qué exigen la NOM y la NFPA"
    titleAccent="a cada servicio"
    desc="Un servicio sin evidencia es, para la autoridad, un servicio que no ocurrió."
    body={[
      'La Norma Oficial Mexicana no solo manda dar mantenimiento: manda cómo hacerlo y qué rastro debe dejar. Aquí está qué exige cada una y a qué parte del servicio aplica.',
      'Las NFPA se listan como referencia técnica internacional. No son ley federal en México, aunque tu aseguradora o tu corporativo sí pueden pedirlas.',
    ]}
    rows={serviciosNormRows}
    columns={['Norma / formato', 'Qué exige', 'Aplica a']}
    note="Cada servicio deja etiqueta y collarín sobre el equipo, reporte por escrito y, cuando corresponde, constancia DC-3 a nombre del trabajador. Ese conjunto demuestra el cumplimiento de las normas en una verificación."
  />

  {/* ─── Cómo se contrata (proceso, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Cómo se contrata"
    title="Diseño e ingeniería del servicio,"
    titleAccent="del levantamiento al aviso de vencimiento"
    desc="Primero se revisa qué equipo tienes y en qué estado está; así la cotización corresponde a tu inmueble."
    body={[
      'El servicio no termina cuando se firma el reporte: termina cuando te avisamos que toca el siguiente, para que la vigencia no se pierda por olvido.',
      'El proceso es el mismo para tres extintores de oficina que para una red hidráulica completa; solo cambia el tamaño del programa.',
    ]}
    steps={serviciosSteps}
  />

  {/* ─── Sobre el servicio (qué cubre / cómo se agenda) ─── */}
  <Section surface>
      <SectionHeading
        layout="duo"
        eyebrow="Sobre el servicio"
        title="Seguridad contra incendios con"
        titleAccent="un solo interlocutor"
        desc="Del proyecto al expediente, sin coordinar a tres proveedores para un mismo inmueble."
        body={[
          'Cubrimos el ciclo completo de la protección contra incendios, con más de 35 años de experiencia en el mercado mexicano: el mismo equipo que instaló lleva el registro de qué toca revisar y cuándo vence.',
          'Agenda por WhatsApp y habla directo con quien resuelve.',
        ]}
      />
      <CompanyAbout
        que={serviciosCompany.que}
        como={serviciosCompany.como}
        cta={{ label: 'Agendar por WhatsApp', href: waUrl(WA_MESSAGES.servicios), external: true }}
      />
  </Section>

  {/* ─── Reseñas del servicio ─── */}
  <Testimonios items={serviciosTestimonios} {...serviciosTestimoniosHead} />

  {/* ─── Interlinking a las otras secciones ─── */}
  <RelatedLinks
    title="Sigue por aquí"
    desc="Lo que suele hacer falta junto con el servicio."
    links={serviciosRelated}
    limit={4}
  />

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={serviciosFaqs} waNumber={CONTACT.whatsapp} {...serviciosFaqHead} />
</PageLayout>
