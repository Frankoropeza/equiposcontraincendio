---
// /servicios/ — Landing de Servicios (categoría L2). HOMOLOGADA con /productos:
// Hero → SectionMenu → TrustBar → tarjetas → módulos CategoryFeature → FAQ.
// Mismos componentes compartidos; copy propio de servicios.
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionMenu from '@components/SectionMenu.astro'
import TrustBar from '@components/TrustBar.astro'
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import CategoryFeature from '@components/CategoryFeature.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import RiskGuide from '@components/RiskGuide.astro'
import NormsTable from '@components/NormsTable.astro'
import ProcessSteps from '@components/ProcessSteps.astro'
import CompanyAbout from '@components/CompanyAbout.astro'
import RelatedLinks from '@components/RelatedLinks.astro'
import {
  serviceFeatures,
  serviciosCalendario,
  serviciosNormRows,
  serviciosSteps,
  serviciosCompany,
  serviciosRelated,
} from '@data/servicios'
import ServiceCard from '@components/ServiceCard.astro'
import { getCollection } from 'astro:content'
import { SERVICES, SERVICE_ANCHOR, CONTACT, waUrl, WA_MESSAGES, sectionMenuItems } from '@config/site'

// Menú de secciones: subtítulos desde SECTION_MENU_SUB (site.ts), no un mapa
// local — así todas las páginas describen las secciones igual.
const menuSecciones = sectionMenuItems()
const menuCta = {
  label: 'Cotizar por WhatsApp',
  href: waUrl(WA_MESSAGES.servicios),
  sub: 'Respuesta inmediata',
  external: true,
}

// ── Barra de confianza (pilares honestos, vía componente TrustBar) ──
const pillars = [
  { icon: 'shield', title: 'Conforme a norma', desc: 'Servicio alineado a la NOM-154-SCFI y la NOM-002-STPS.' },
  { icon: 'doc', title: 'Reporte y constancias', desc: 'Evidencia del servicio lista para tu expediente ante PC y STPS.' },
  { icon: 'clock', title: 'Programa de vigencia', desc: 'Te avisamos cuándo toca recarga, prueba hidrostática y revisión.' },
  { icon: 'chat', title: 'Atención por WhatsApp', desc: 'Agenda y resuelve dudas directo, con atención personal.' },
]

// ── Imagen y badge por servicio, LEÍDOS DE LA COLECCIÓN ──
// Antes esto era un mapa hardcodeado con solo 3 de los 7 servicios (el mismo
// anti-patrón D3 que la auditoría corrigió en la home): las otras 4 tarjetas
// salían sin imagen, y una de ellas quedaba sola y a media altura en la
// tercera fila del grid. La colección ya tiene `image` y `badge` de los 7.
const serviciosCol = await getCollection('servicios', ({ data }) => !data.draft)
const SERVICE_META = Object.fromEntries(
  serviciosCol.map((s) => [s.id, { image: s.data.image, badge: s.data.badge }]),
) as Record<string, { image?: string; badge?: string }>

const faqs = [
  {
    question: '¿Cada cuándo se da mantenimiento o recarga a un extintor?',
    answer: 'El mantenimiento y recarga se realiza conforme a la NOM-154-SCFI-2005 (de forma anual como práctica habitual). Además, en centros de trabajo la NOM-002-STPS-2010 pide una revisión mensual a cargo del personal.',
  },
  {
    question: '¿Cada cuándo se hace la prueba hidrostática?',
    answer: 'En México la prueba hidrostática se realiza cada 5 años para extintores de agua, CO₂ y PQS, conforme a la NOM-154-SCFI-2005 (o antes si el cilindro se golpea). El dato de “12 años” es de la NFPA 10 de Estados Unidos, no es norma mexicana.',
  },
  {
    question: '¿La instalación incluye planos y memoria de diseño?',
    answer: 'Sí. El servicio de instalación incluye cálculo, planos y memoria técnica, para que tengas la documentación que pide Protección Civil y tu aseguradora.',
  },
  {
    question: '¿Me entregan dictamen o constancia para Protección Civil y STPS?',
    answer: 'Sí. Cada servicio se entrega con su reporte o constancia correspondiente, listos para integrar a tu expediente ante Protección Civil y STPS.',
  },
  {
    question: '¿Puedo cotizar servicio y producto en el mismo mensaje?',
    answer: 'Claro. Puedes pedir, por ejemplo, suministro de extintores junto con su instalación y mantenimiento en una sola cotización por WhatsApp.',
  },
  {
    question: '¿En qué zonas dan servicio?',
    answer: 'Atendemos la Ciudad de México, el Estado de México y la zona metropolitana. Cuéntanos dónde estás y te confirmamos cobertura y tiempos.',
  },
]
---

<PageLayout
  title="Servicios contra incendio"
  description="Servicios contra incendio en CDMX y Estado de México: instalación, mantenimiento y recarga de extintores, e inspección y dictamen. Cotiza por WhatsApp."
  pageType="category"
  schemaData={{ faqs }}
  breadcrumbs={[{ label: 'Servicios' }]}
  guia={false}
>
  {/* ─── Hero (componente compartido, idéntico al index y a /productos) ─── */}
  <Hero
    badge="Servicios · CDMX y Estado de México"
    title="No solo vendemos:"
    accent="instalamos y mantenemos"
    subtitle="De la instalación al mantenimiento, la recarga y la inspección: acompañamos tu protección contra incendio durante toda su vida útil."
    descRight={[
      'Un equipo contra incendio protege si está bien elegido, bien instalado y vigente. Por eso ofrecemos el ciclo completo y no solo la venta: proyecto e instalación, mantenimiento y recarga, e inspección con dictamen.',
      'Trabajamos conforme a la normatividad aplicable —NOM-002-STPS-2010 y NOM-154-SCFI-2005— y te entregamos un reporte claro de lo realizado.',
    ]}
    ctas={[
      { text: 'Nuestros servicios', href: '#servicios', variant: 'outline' },
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.servicios), variant: 'primary', whatsapp: true },
    ]}
  />

  <SectionMenu items={menuSecciones} cta={menuCta} />

  {/* ─── Barra de confianza (pilares honestos) ─── */}
  <TrustBar items={pillars} />

  {/* ─── Tarjetas de servicio ─── */}
  <section class="section section--surface" id="servicios">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Lo que hacemos"
        title="Siete servicios,"
        titleAccent="un ciclo completo"
        desc="Del proyecto y la instalación al expediente en regla, con la vigencia siempre al día."
        body={[
          'La protección contra incendio no se compra una vez: se instala, se revisa, se recarga, se prueba y se documenta. Cada uno de esos momentos tiene su servicio y su periodicidad.',
          'Cada tarjeta lleva a la página del servicio, con lo que incluye, cómo se trabaja y las preguntas que más nos hacen.',
        ]}
      />
      <div class="card-grid">
        {SERVICES.map((s, i) => (
          <CategoryCard
            label={s.label}
            href={`/servicios/${s.id}/`}
            image={SERVICE_META[s.id]?.image}
            imageAlt={s.label}
            blurb={s.desc}
            badge={SERVICE_META[s.id]?.badge ?? 'Servicio'}
            ctaLabel={SERVICE_ANCHOR[s.id] ?? s.label}
            index={i}
          />
        ))}
        {/* Celda de cierre: 7 servicios en un grid de 4 columnas dejaban un
            hueco. La octava es la salida para quien no sabe cuál pedir. */}
        <ServiceCard
          title="¿No sabes qué servicio necesitas?"
          description="Cuéntanos el giro y la superficie de tu inmueble y te decimos qué servicio te pide la norma y con qué periodicidad, sin venderte de más."
          href={waUrl('Hola, no sé qué servicio necesito. ¿Me ayudan a saber qué me pide la norma para mi inmueble?')}
          image="/images/servicios/inspeccion-gabinete-manguera-contra-incendio.avif"
          imageAlt="Técnico inspeccionando un gabinete de manguera contra incendio"
          badge="Asesoría sin costo"
          ctaLabel="Diagnóstico por WhatsApp"
          whatsapp
        />
      </div>
    </div>
  </section>

  {/* ─── Módulos de servicio (CategoryFeature) — diseño uniforme, copy propio ─── */}
  {serviceFeatures.map((c) => (
    <CategoryFeature
      anchorId={c.id}
      eyebrow={c.eyebrow}
      title={c.title}
      titleAccent={c.titleAccent}
      description={c.description}
      features={c.features}
      ctaLabel={c.ctaLabel}
      ctaHref={waUrl(c.ctaMsg)}
      ctaExternal
      ctaSecondaryLabel={c.ctaSecondaryLabel}
      ctaSecondaryHref={c.ctaSecondaryHref}
      imgMain={c.imgMain}
      imgA={c.imgA}
      imgB={c.imgB}
    />
  ))}

  {/* ─── Calendario de servicio: cada cuándo toca cada cosa ─── */}
  <RiskGuide
    eyebrow="Calendario de servicio"
    title="Cada cuándo toca"
    titleAccent="y qué papel te deja"
    desc="La periodicidad no la fija el proveedor: la fija la norma."
    body={[
      'La pregunta que más se repite no es cuánto cuesta, sino cada cuándo toca. Aquí está el calendario completo, con la norma que obliga cada servicio y la evidencia que debe quedar en tu expediente.',
      'Si no sabes en qué punto del calendario estás, el levantamiento inicial lo resuelve: se revisa qué equipo hay y cuándo venció cada pieza.',
    ]}
    rows={serviciosCalendario}
    columns={['Servicio', 'Cada cuándo', 'Qué lo obliga', 'Evidencia que queda']}
    note="La revisión mensual la hace tu propio personal y solo requiere bitácora; el mantenimiento anual y la prueba hidrostática los presta un proveedor. La brigada es obligatoria únicamente en centros de trabajo de riesgo alto, y la constancia DC-3 no tiene vigencia fijada por norma."
    ctaLabel="Verifica tu extintor"
    ctaHref="/herramientas/verifica-tu-extintor/"
  />

  {/* ─── Respaldo normativo del servicio ─── */}
  <NormsTable
    eyebrow="Respaldo normativo"
    title="Qué le exige la norma"
    titleAccent="a cada servicio"
    desc="Un servicio sin evidencia es, para la autoridad, un servicio que no ocurrió."
    body={[
      'La norma no solo manda dar mantenimiento: manda cómo hacerlo y qué rastro debe dejar. Aquí está qué exige cada una y a qué parte del servicio aplica.',
      'Las NFPA se listan como referencia técnica internacional. No son ley federal en México, aunque tu aseguradora o tu corporativo sí pueden pedirlas.',
    ]}
    rows={serviciosNormRows}
    columns={['Norma / formato', 'Qué exige', 'Aplica a']}
    note="Cada servicio deja etiqueta y collarín sobre el equipo, reporte por escrito y, cuando corresponde, constancia DC-3 a nombre del trabajador. Ese conjunto es lo que se presenta en una verificación."
  />

  {/* ─── Cómo se contrata (proceso, fondo oscuro) ─── */}
  <ProcessSteps
    eyebrow="Cómo se contrata"
    title="Del levantamiento"
    titleAccent="al aviso de vencimiento"
    desc="Primero se revisa qué tienes; cotizar sin eso es dar un número al aire."
    body={[
      'El servicio no termina cuando se firma el reporte: termina cuando te avisamos que toca el siguiente, para que la vigencia no se pierda por olvido.',
      'El proceso es el mismo para tres extintores de oficina que para una red hidráulica completa; solo cambia el tamaño del programa.',
    ]}
    steps={serviciosSteps}
  />

  {/* ─── Sobre el servicio (qué cubre / cómo se agenda) ─── */}
  <section class="section section--surface">
    <div class="container">
      <SectionHeading
        layout="duo"
        eyebrow="Sobre el servicio"
        title="Siete servicios,"
        titleAccent="un solo interlocutor"
        desc="Del proyecto al expediente, sin pelotear entre tres proveedores."
        body={[
          'Cubrimos el ciclo completo de la protección contra incendio, así que la misma persona que instaló sabe qué toca revisar y cuándo vence.',
          'Agenda por WhatsApp y habla directo con quien resuelve.',
        ]}
      />
      <CompanyAbout
        que={serviciosCompany.que}
        como={serviciosCompany.como}
        cta={{ label: 'Agendar por WhatsApp', href: waUrl(WA_MESSAGES.servicios), external: true }}
      />
    </div>
  </section>

  {/* ─── Interlinking a las otras secciones ─── */}
  <RelatedLinks
    title="Sigue por aquí"
    desc="Lo que suele hacer falta junto con el servicio."
    links={serviciosRelated}
    limit={4}
  />

  {/* ─── FAQ + Contacto ─── */}
  <FAQWithContact items={faqs} waNumber={CONTACT.whatsapp} />
</PageLayout>

<style>
  .container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .section { padding: var(--sp-8) 0; }
  .section--surface { background: var(--c-surface); }
  @media (min-width: 768px) { .section { padding: var(--sp-10) 0; } }
</style>
