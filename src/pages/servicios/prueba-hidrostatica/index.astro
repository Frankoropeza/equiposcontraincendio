---
// Página L3 de prueba hidrostática: el patrón compartido vive en ServiceL3.
import ServiceL3 from '@components/ServiceL3.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('l3', 'servicios/prueba-hidrostatica');
if (!entry) throw new Error('Falta la entrada L3: servicios/prueba-hidrostatica');
---

<ServiceL3 data={entry.data} />
