---
// ============================================================================
// /servicios/<slug> — Ficha de servicio (Nivel L4).
// ----------------------------------------------------------------------------
// AUDITORÍA 2026-09-09 · hallazgo NUEVO-3 (Fase 2):
// Esta ruta NO leía la colección `servicios`. Generaba los slugs desde SERVICES
// (TAXONOMY de site.ts) y sacaba el cuerpo de un mapa hardcodeado con los
// servicios de una AGENCIA WEB —`consultoria`, `implementacion`, `soporte`, con
// textos como «Construcción del sitio en Astro»—. Como los ids reales son
// instalacion/mantenimiento/inspeccion, ninguno casaba y las tres fichas caían
// al mismo fallback genérico («Alcance a medida · Acompañamiento técnico ·
// Entrega documentada»). Consecuencias, verificadas en producción:
//   · el markdown de src/content/servicios/*.md NUNCA se renderizaba;
//   · las tres fichas eran prácticamente idénticas entre sí;
//   · con pageType="page" no se emitía el schema Service.
//
// AHORA: rutas y contenido salen de la colección `servicios` (Zod .strict()),
// el cuerpo markdown se renderiza, y el JSON-LD emite Service + FAQPage.
// El menú del Header sigue viniendo de TAXONOMY.services: los `id` de allí y
// los nombres de archivo de la colección DEBEN coincidir (lo vigila
// tests/taxonomy-collections.test.mjs).
// ============================================================================
import { getCollection, render } from 'astro:content'
import PageLayout from '@layouts/PageLayout.astro'
import Hero from '@components/Hero.astro'
import SectionHeading from '@components/SectionHeading.astro'
import FAQAccordion from '@components/FAQAccordion.astro'
import SectionMenu from '@components/SectionMenu.astro'
import { waUrl, WA_MESSAGES } from '@config/site'

export async function getStaticPaths() {
  // Servicios con página L3 propia en src/pages/servicios/<id>/index.astro.
  // Se excluyen para no generar dos páginas en la misma URL; su ficha de la
  // colección se conserva (tarjeta de /servicios/, menú y blog). Va dentro de
  // getStaticPaths porque Astro la ejecuta aislada del resto del frontmatter.
  const L3_PROPIAS = new Set(['mantenimiento', 'prueba-hidrostatica', 'inspeccion'])
  const servicios = (await getCollection('servicios', ({ data }) => !data.draft)).sort(
    (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
  )
  const productos = await getCollection('productos', ({ data }) => !data.draft)

  return servicios.filter((servicio) => !L3_PROPIAS.has(servicio.id)).map((servicio) => {
    // Interlinking (B6). Preferencia: las relaciones declaradas en el
    // frontmatter (reference() tipado); si no hay, los servicios hermanos.
    // flatMap en vez de map+filter(Boolean): filter no estrecha el tipo en TS
    // y `astro check` marcaba «possibly undefined» aguas abajo.
    const declaredServices = (servicio.data.relatedServices ?? []).flatMap((ref) => {
      const hit = servicios.find((s) => s.id === ref.id)
      return hit ? [hit] : []
    })
    const declaredProducts = (servicio.data.relatedProducts ?? []).flatMap((ref) => {
      const hit = productos.find((p) => p.id === ref.id)
      return hit ? [hit] : []
    })

    const hermanos = servicios.filter((s) => s.id !== servicio.id)
    const related = [
      ...(declaredServices.length ? declaredServices : hermanos).map((s) => ({
        label: s.data.title,
        href: `/servicios/${s.id}/`,
        sub: 'Otro servicio',
      })),
      ...declaredProducts.map((p) => ({
        label: p.data.title,
        href: `/productos/${p.id}/`,
        sub: 'Producto relacionado',
      })),
    ]

    return { params: { slug: servicio.id }, props: { servicio, related } }
  })
}

const { servicio, related } = Astro.props
const { data, id } = servicio
const { Content } = await render(servicio)

const includes = data.includes ?? []
const faqs = data.faqs ?? []

// schemaData → Service (+ FAQPage si la ficha tiene preguntas visibles).
// Claves EXACTAS del contrato de lib/seo.ts: service { name, description, path,
// serviceType?, image?, areaServed?, priceRange? }.
const schemaData = {
  service: {
    name: data.title,
    description: data.description,
    path: `/servicios/${id}/`,
    serviceType: data.category,
    image: data.image,
  },
  ...(faqs.length ? { faqs } : {}),
}

const cierreItems = [
  ...related.slice(0, 4),
  { label: 'Todos los servicios', href: '/servicios/', sub: 'Volver al catálogo' },
  { label: 'Contacto', href: '/contacto/', sub: 'Hablemos de tu proyecto' },
]
const cierreCta = {
  label: 'Cotizar este servicio',
  href: waUrl(WA_MESSAGES.servicios),
  sub: 'Respuesta inmediata',
  external: true,
}
---

<PageLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.description}
  image={data.image}
  pageType="service"
  schemaData={schemaData}
  breadcrumbs={[{ label: 'Servicios', href: '/servicios/' }, { label: data.title }]}
  noindex={data.noindex}
  guia={false}
>
  <Hero
    badge={data.hero?.badge ?? 'Servicio'}
    title={data.hero?.title ?? data.title}
    subtitle={data.hero?.subtitle ?? data.description}
    descRight={[
      'Aquí encuentras lo concreto del servicio: qué incluye, cómo trabajamos y las dudas más frecuentes. Si te queda alguna, escríbenos por WhatsApp y te respondemos.',
    ]}
    ctas={[
      { text: 'Cotizar por WhatsApp', href: waUrl(WA_MESSAGES.servicios), variant: 'primary', whatsapp: true },
      { text: 'Equipos contra incendios', href: '/productos/', variant: 'outline' },
    ]}
  />

  {includes.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeading
          layout="duo"
          eyebrow="Qué incluye"
          title={`El alcance de ${data.title.toLowerCase()}`}
          desc="Lo que recibes y por qué importa."
          body={[
            data.description,
            'Si tu caso necesita algo distinto, lo ajustamos en la cotización con entregables y tiempos claros.',
          ]}
        />
        <ul class="incluye">
          {includes.map((it) => (
            <li class="incluye__item">
              <span class="incluye__check" aria-hidden="true">✓</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--surface">
    <div class="container">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section">
      <div class="container">
        <FAQAccordion items={faqs} title="Preguntas frecuentes" openFirst />
      </div>
    </section>
  )}

  <SectionMenu items={cierreItems} cta={cierreCta} ariaLabel="Otros servicios y contacto" />
</PageLayout>

<style>
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }

  .section {
    padding: var(--sp-8) 0;
  }

  .section--surface {
    background: var(--c-surface);
  }

  @media (min-width: 768px) {
    .section {
      padding: var(--sp-10) 0;
    }
  }

  .incluye {
    list-style: none;
    margin: var(--sp-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
    max-width: 60ch;
  }

  .incluye__item {
    display: flex;
    gap: var(--sp-3);
    align-items: start;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--c-ink-2);
  }

  .incluye__check {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--c-primary-light);
    color: #fff;
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
  }

  /* Cuerpo markdown de la ficha (colección `servicios`). */
  .prose {
    max-width: var(--container-prose);
    margin-inline: auto;
    color: var(--c-ink-2);
    line-height: var(--leading-relaxed);
  }

  .prose :global(h2) {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--c-ink);
    margin: var(--sp-6) 0 var(--sp-3);
  }

  .prose :global(h3) {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    color: var(--c-ink);
    margin: var(--sp-5) 0 var(--sp-2);
  }

  .prose :global(p) {
    margin: 0 0 var(--sp-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--sp-4);
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: var(--sp-2);
  }

  .prose :global(strong) {
    color: var(--c-ink);
    font-weight: var(--weight-semibold);
  }

  .prose :global(a) {
    color: var(--c-primary);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 var(--sp-4);
    font-size: var(--text-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--c-border);
    padding: var(--sp-3);
    text-align: left;
  }

  .prose :global(th) {
    background: var(--c-white);
    font-weight: var(--weight-semibold);
    color: var(--c-ink);
  }
</style>
