---
// ============================================================================
// Testimonios.astro — Reseñas de clientes (home).
// 2026-09-17 v2 (pedido de Frank: diseño equilibrado, profesional, SIN líneas
// de color): retícula uniforme de 12 celdas = 11 reseñas + 1 tarjeta de
// invitación, todas de la misma altura, con la firma alineada al pie.
//   ≥1100 px: 4 × 3 · 700–1099 px: 3 × 4 · <700 px: carrusel con scroll-snap.
// Sin estrellas ni schema de reseñas (ver src/data/testimonios.ts).
// ============================================================================
import SectionHeading from '@components/SectionHeading.astro';
import type { Testimonio } from '@data/testimonios';
import { waUrl } from '@config/site';

interface Props {
  items: Testimonio[];
}
const { items } = Astro.props;
const inicial = (n: string) => n.trim().charAt(0).toUpperCase();
const waResena = waUrl('Hola, ya les compré equipo contra incendio y quiero dejarles mi reseña.');
---

<section class="testi" aria-labelledby="testi-title">
  <div class="testi__inner">
    <SectionHeading
      id="testi-title"
      layout="duo"
      title="Lo que dicen"
      titleAccent="nuestros clientes"
      desc="Opiniones de clientes que compraron su equipo con nosotros, publicadas con su autorización."
      body={[
        'Nos importa que la compra sea sencilla: que entiendas qué equipo necesitas, por qué y cuándo te toca darle servicio.',
        'Cada reseña se publica tal como nos la enviaron.',
      ]}
    />

    <ul class="testi__grid" role="list">
      {items.map((t: Testimonio) => (
        <li class="testi__cell">
          <figure class="testi__card">
            <svg class="testi__mark" width="28" height="22" viewBox="0 0 34 26" aria-hidden="true" focusable="false">
              <path d="M0 26V15.6C0 6.9 4.6 1.7 13 0l1.6 3.4C10.3 4.8 8.2 7.6 8 11.4h6V26H0Zm19.4 0V15.6C19.4 6.9 24 1.7 32.4 0L34 3.4c-4.3 1.4-6.4 4.2-6.6 8H33V26H19.4Z" fill="currentColor"/>
            </svg>
            <blockquote class="testi__quote"><p>{t.texto}</p></blockquote>
            <figcaption class="testi__who">
              <span class="testi__avatar" aria-hidden="true">{inicial(t.nombre)}</span>
              <span class="testi__meta">
                <span class="testi__name">{t.nombre}</span>
                <span class="testi__role">Cliente de CONINC</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
      <li class="testi__cell">
        <div class="testi__card testi__card--invite">
          <p class="testi__invite-title">¿Ya nos compraste?</p>
          <p class="testi__invite-text">Cuéntanos cómo te fue con tu equipo y con la atención. Tu opinión ayuda a otras empresas a decidir.</p>
          <a class="btn btn--primary testi__invite-btn" href={waResena} target="_blank" rel="noopener">Dejar mi reseña</a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .testi { padding: var(--sp-8) 0; background: var(--c-white); }
  @media (min-width: 768px) { .testi { padding: var(--sp-10) 0; } }
  .testi__inner { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }

  /* Móvil: carrusel con scroll-snap (una tarjeta y media a la vista) */
  .testi__grid {
    list-style: none;
    margin: var(--sp-6) calc(-1 * var(--container-px)) 0;
    padding: var(--sp-1) var(--container-px) var(--sp-4);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 84%;
    gap: var(--sp-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-px);
    scrollbar-width: none;
  }
  .testi__grid::-webkit-scrollbar { display: none; }
  .testi__cell { display: flex; scroll-snap-align: start; }

  /* Tableta: 3 columnas × 4 filas */
  @media (min-width: 700px) {
    .testi__grid {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-5);
      overflow: visible;
      margin-inline: 0;
      padding: 0;
    }
  }
  /* Escritorio: 4 columnas × 3 filas */
  @media (min-width: 1100px) {
    .testi__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .testi__card {
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding: var(--sp-6);
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 2px rgba(20, 24, 31, .04), 0 6px 18px rgba(20, 24, 31, .05);
  }

  .testi__mark { color: var(--c-primary); flex-shrink: 0; }

  .testi__quote { margin: var(--sp-4) 0 0; flex: 1; }
  .testi__quote p {
    margin: 0;
    color: var(--c-ink-2);
    font-size: .95rem;
    line-height: 1.65;
  }

  /* Firma al pie: todas las tarjetas terminan a la misma altura */
  .testi__who {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }
  .testi__avatar {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    display: grid;
    place-items: center;
    background: var(--c-surface);
    color: var(--c-ink);
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold, 600);
    font-size: 1rem;
  }
  .testi__meta { display: flex; flex-direction: column; line-height: 1.3; }
  .testi__name { font-family: var(--font-heading); font-weight: var(--weight-semibold, 600); color: var(--c-ink); }
  .testi__role { font-size: var(--text-sm, .875rem); color: var(--c-muted); }

  /* Tarjeta de invitación: misma caja, fondo suave, contenido centrado */
  .testi__card--invite {
    justify-content: center;
    align-items: flex-start;
    background: var(--c-surface);
    box-shadow: none;
  }
  .testi__invite-title {
    margin: 0 0 var(--sp-2);
    font-family: var(--font-heading);
    font-size: var(--text-xl, 1.25rem);
    font-weight: var(--weight-semibold, 600);
    color: var(--c-ink);
  }
  .testi__invite-text { margin: 0 0 var(--sp-5); color: var(--c-ink-2); font-size: .95rem; line-height: 1.65; }
</style>
