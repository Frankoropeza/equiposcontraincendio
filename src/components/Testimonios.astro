---
// ============================================================================
// Testimonios.astro — Reseñas de clientes en cards (home).
// Escritorio: mosaico de 3 columnas (alturas naturales, sin huecos).
// Móvil: carrusel horizontal con scroll-snap (sin JS).
// Sin estrellas ni schema de reseñas (ver src/data/testimonios.ts).
// ============================================================================
import SectionHeading from '@components/SectionHeading.astro';
import type { Testimonio } from '@data/testimonios';

interface Props {
  items: Testimonio[];
}
const { items } = Astro.props;
const inicial = (n: string) => n.trim().charAt(0).toUpperCase();
---

<section class="testi" aria-labelledby="testi-title">
  <div class="testi__inner">
    <SectionHeading
      id="testi-title"
      layout="duo"
      eyebrow="Reseñas"
      title="Lo que dicen"
      titleAccent="nuestros clientes"
      desc="Opiniones de clientes que compraron su equipo con nosotros, publicadas con su autorización."
      body={[
        'Nos importa que la compra sea sencilla: que entiendas qué equipo necesitas, por qué y cuándo te toca darle servicio.',
        '¿Ya nos compraste? Escríbenos por WhatsApp y cuéntanos cómo te fue.',
      ]}
    />

    <ul class="testi__grid" role="list">
      {items.map((t) => (
        <li class="testi__card">
          <figure class="testi__fig">
            <svg class="testi__mark" width="34" height="26" viewBox="0 0 34 26" aria-hidden="true" focusable="false">
              <path d="M0 26V15.6C0 6.9 4.6 1.7 13 0l1.6 3.4C10.3 4.8 8.2 7.6 8 11.4h6V26H0Zm19.4 0V15.6C19.4 6.9 24 1.7 32.4 0L34 3.4c-4.3 1.4-6.4 4.2-6.6 8H33V26H19.4Z" fill="currentColor"/>
            </svg>
            <blockquote class="testi__quote"><p>{t.texto}</p></blockquote>
            <figcaption class="testi__who">
              <span class="testi__avatar" aria-hidden="true">{inicial(t.nombre)}</span>
              <span class="testi__name">{t.nombre}</span>
              <span class="testi__role">Cliente de CONINC</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .testi { padding: var(--sp-8) 0; background: var(--c-white); }
  @media (min-width: 768px) { .testi { padding: var(--sp-10) 0; } }
  .testi__inner { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }

  /* Móvil: carrusel con scroll-snap */
  .testi__grid {
    list-style: none; margin: var(--sp-6) calc(-1 * var(--container-px)) 0; padding: 0 var(--container-px) var(--sp-3);
    display: grid; grid-auto-flow: column; grid-auto-columns: 86%; gap: var(--sp-4);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--container-px); scrollbar-width: thin;
  }
  .testi__card { scroll-snap-align: start; }

  /* Escritorio: mosaico de 3 columnas */
  @media (min-width: 768px) {
    .testi__grid { display: block; columns: 2; column-gap: var(--sp-5); overflow: visible; margin-inline: 0; padding: 0; }
    .testi__card { break-inside: avoid; margin-bottom: var(--sp-5); }
  }
  @media (min-width: 1100px) { .testi__grid { columns: 3; } }

  .testi__fig {
    position: relative; margin: 0; height: 100%;
    display: flex; flex-direction: column; gap: var(--sp-4);
    padding: var(--sp-6) var(--sp-5) var(--sp-5);
    background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius-lg);
    border-top: 3px solid var(--c-primary);
  }

  .testi__mark { color: var(--c-primary); opacity: .9; }
  .testi__quote { margin: 0; flex: 1; }
  .testi__quote p { margin: 0; color: var(--c-ink-2); font-size: var(--text-base, 1rem); line-height: var(--leading-relaxed, 1.7); }

  .testi__who {
    display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: var(--sp-3);
    align-items: center; padding-top: var(--sp-4); border-top: 1px solid var(--c-border);
  }
  .testi__avatar {
    grid-row: 1 / span 2; width: 44px; height: 44px; border-radius: var(--radius-full);
    display: grid; place-items: center;
    background: var(--c-primary); color: #fff;
    font-family: var(--font-heading); font-weight: var(--weight-bold, 700); font-size: 1.1rem;
  }
  .testi__name { font-family: var(--font-heading); font-weight: var(--weight-semibold, 600); color: var(--c-ink); }
  .testi__role { font-size: var(--text-sm, .875rem); color: var(--c-muted); }
</style>
