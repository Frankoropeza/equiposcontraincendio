---
// RelatedLinks.astro — Cross-linking interno data-driven por taxonomía (hub-and-spoke SEO). ORIGEN: PROYECTORED/src/components/sections/CategoriasRelacionadas.astro (excluye la categoría actual, distribuye link equity). Patrón canónico B6 del ecosistema.
// Por defecto lee PRODUCT_CATEGORIES de config/site y excluye `current`. También acepta `links` manuales (otras taxonomías: servicios, sectores, artículos).
import Icon from '@components/Icon.astro'
import { PRODUCT_CATEGORIES } from '@config/site'

interface LinkItem {
  slug?: string
  label: string
  href: string
  desc?: string
}
interface Props {
  /** Slug a excluir del listado (la página actual). */
  current?: string
  /** Límite de tarjetas. */
  limit?: number
  title?: string
  desc?: string
  eyebrow?: string
  body?: string[]
  /** Links manuales. Si se pasan, se usan en lugar de PRODUCT_CATEGORIES. */
  links?: LinkItem[]
}
const { current = '', limit = 4, title = 'Explora también', desc, eyebrow, body = [], links } = Astro.props
const SectionHeading: any = body.length > 0 ? (await import('@components/SectionHeading.astro')).default : undefined

const source: LinkItem[] = links ?? PRODUCT_CATEGORIES.map((c) => ({
  slug: c.slug, label: c.label, href: c.href, desc: (c as any).badge ?? undefined,
}))
const limitedItems = source.filter((l) => l.slug !== current).slice(0, limit)
// Las barras visibles cierran filas de 4; los widgets bare conservan su lista
// variable porque viven en una columna lateral y no participan en esa retícula.
const items = title && limitedItems.length > 4
  ? limitedItems.slice(0, limitedItems.length - (limitedItems.length % 4))
  : limitedItems
---

{items.length > 0 && (
  <section class:list={['rel', !title && 'rel--bare']} aria-label={title || 'Enlaces relacionados'}>
    <div class="rel__inner">
      {/* title="" omite el encabezado: lo usa la barra lateral de la ficha,
          que ya tiene su propio h2 («También te puede servir»). */}
      {title && (body.length > 0 ? (
        <SectionHeading layout="duo" {eyebrow} title={title} desc={desc} body={body} />
      ) : (
        <header class="rel__head">
          <h2 class="rel__title">{title}</h2>
          {desc && <p class="rel__desc">{desc}</p>}
        </header>
      ))}
      <ul class="rel__grid" role="list">
        {items.map((item) => (
          <li>
            <a href={item.href} class="rel__card">
              <span class="rel__card-label">{item.label}</span>
              {item.desc && <span class="rel__card-desc">{item.desc}</span>}
              <span class="rel__card-arrow" aria-hidden="true">
                <Icon name="arrow" size={16} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .rel { padding: var(--section-py, clamp(3rem, 6vw, 5rem)) 0; background: var(--color-gray-50, #fafafa); border-top: 1px solid var(--c-border, var(--border, #e8e8e8)); }
  .rel__inner { max-width: var(--container-max, 1400px); margin-inline: auto; padding-inline: var(--container-px, 1.5rem); }
  .rel__head { margin-bottom: var(--sp-6, 1.5rem); }
  .rel__title { font-family: var(--font-heading); font-size: var(--text-2xl, 1.5rem); font-weight: var(--weight-bold, 700); color: var(--c-ink, var(--color-gray-900, #111827)); margin: 0; }
  .rel__desc { font-size: var(--text-sm, .9375rem); color: var(--text-muted, var(--c-muted, #6b7280)); margin: var(--sp-2, .5rem) 0 0; }
  /* Misma retícula que .card-grid: 1 → 2 (640) → 4 (1280). Antes auto-fit
     metía 5 por fila a 1440 y dejaba filas incompletas (regla de 4 por fila). */
  .rel__grid { display: grid; grid-template-columns: 1fr; align-items: stretch; gap: var(--sp-4, 1rem); list-style: none; padding: 0; margin: 0; }
  @media (min-width: 640px) { .rel__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1280px) { .rel__grid { grid-template-columns: repeat(4, 1fr); } }
  /* Sin título = widget de la barra lateral del blog (20rem): una columna siempre. */
  .rel--bare .rel__grid { grid-template-columns: 1fr; }
  /* Tarjeta con las MISMAS reglas de retícula que el resto del sistema:
     altura completa en la fila y zonas de altura reservada, para que un
     enlace con descripción larga no deje a los demás desalineados. */
  .rel__card { display: flex; flex-direction: column; height: 100%; gap: var(--sp-2, .5rem); padding: var(--sp-5, 1.25rem) calc(var(--sp-5, 1.25rem) + 28px) var(--sp-5, 1.25rem) var(--sp-5, 1.25rem); background: var(--c-white, #fff); border: 1px solid var(--c-border, var(--border, #e8e8e8)); border-radius: var(--radius-lg, .75rem); text-decoration: none; position: relative; }
  /* Tarjeta estática: al pasar solo cambia el color del borde, sin sombra ni movimiento. */
  .rel__card:hover { border-color: var(--c-primary, #C41E24); }
  .rel__card-label { font-family: var(--font-heading); font-size: var(--text-base, 1rem); font-weight: var(--weight-semibold, 600); color: var(--c-ink, var(--color-gray-900, #111827)); }
  /* La descripción es una FRASE, no una etiqueta: antes heredaba el estilo de
     badge (mayúsculas, rojo, bold) porque el componente nacía leyendo el
     `badge` de la taxonomía, y una oración en ese estilo se lee como un grito. */
  .rel__card-desc { font-size: var(--text-sm, .875rem); font-weight: var(--weight-regular, 400); color: var(--c-ink-2, #3a424e); line-height: var(--leading-normal, 1.5); height: calc(var(--text-sm, .875rem) * var(--leading-normal, 1.5) * 2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  /* Barra lateral (una sola columna): no hay fila que alinear, así que la frase
     se muestra completa en vez de cortarse a dos líneas (2026-09-16). */
  .rel--bare .rel__card-desc { height: auto; display: block; overflow: visible; }
  .rel__card-arrow { position: absolute; top: var(--sp-5, 1.25rem); right: var(--sp-5, 1.25rem); color: var(--text-muted, var(--c-muted, #9ca3af)); }
  .rel__card:hover .rel__card-arrow { color: var(--color-red, var(--c-primary, #C41E24)); }
  .rel__card:focus-visible { outline: 2px solid var(--color-red, var(--c-primary, #C41E24)); outline-offset: 2px; }
</style>
