---
// ============================================================================
// ProductCard.astro — Tarjeta de producto del catálogo.
// ----------------------------------------------------------------------------
// ORIGEN: PROYECTORED .ccard (CatalogoProductos) + RelatedProducts de MESECI.
// Imagen estática con width/height (anti-CLS). Para WhatsApp directo usa waUrl
// en el href que pases.
//
// REDISEÑO 2026-09-10 — CONTRATO DE TARJETA COMPARTIDO
// Misma geometría que CategoryCard y ServiceCard, para que los grids del sitio
// se lean como un solo sistema: media 16/10 con badge, título de altura fija de
// 2 líneas, descripción de altura fija de 3 líneas con line-clamp (el texto
// completo sigue en el DOM para SEO) y CTA sólido a ancho completo anclado al
// fondo, con el texto en `nowrap`. Detalle importante: las alturas son `height`
// y no `min-height` — un glifo como el subíndice de «CO₂» agranda la caja de
// línea y hacía que las tarjetas con ese carácter midieran ~11 px más que el
// resto, desalineando toda la fila del grid.
// La tarjeta entera sigue siendo un enlace, así que el CTA es un <span> con
// aspecto de botón (no se anida un <a> dentro de otro).
interface Props {
  title: string
  href: string                 // /productos/<slug>
  image?: string
  imageAlt?: string
  /** Badge superior (ej. norma o categoría). */
  badge?: string
  description?: string
  /** Texto del CTA. */
  ctaLabel?: string
  /** Posición del card en el grid (para loading eager en los primeros). */
  index?: number
  /** Recurso LCP (primer card del primer grid). */
  priority?: boolean
}
const { title, href, image, imageAlt, badge, description, ctaLabel = 'Ficha técnica', index = 99, priority = false } = Astro.props
const eager = priority || index < 4
---

<article class="pcard" aria-label={title}>
  <a href={href} class="pcard__link">
    {image && (
      <div class="pcard__media">
        <img
          src={image}
          alt={imageAlt ?? title}
          width="640" height="360"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : undefined}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 320px"
          class="pcard__img"
        />
        <span class="pcard__overlay" aria-hidden="true"></span>
        {badge && <span class="pcard__badge">{badge}</span>}
      </div>
    )}
    <div class="pcard__body">
      <h3 class="pcard__title">{title}</h3>
      {description && <p class="pcard__desc">{description}</p>}
      <span class="pcard__cta">
        <span>{ctaLabel}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    </div>
  </a>
</article>

<style>
  /* Cards estáticas; solo los botones tienen transición (regla 2026-09-10). */
  .pcard {
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    height: 100%;
  }

  .pcard__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  /* ── Media: 16/10, igual que CategoryCard y ServiceCard ── */
  .pcard__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--c-surface);
  }

  .pcard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pcard__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,.22) 100%);
  }

  .pcard__badge {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    max-width: calc(100% - var(--sp-6));
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #fff;
    background: var(--c-primary);
    padding: .3em .65em;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Cuerpo: zonas de altura reservada ── */
  .pcard__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: var(--sp-5);
  }

  .pcard__title {
    margin: 0 0 var(--sp-3);
    height: calc(var(--text-lg) * var(--leading-snug) * 2);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--c-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pcard__desc {
    margin: 0 0 var(--sp-4);
    height: calc(var(--text-sm) * var(--leading-normal) * 3);
    font-size: var(--text-sm);
    color: var(--c-ink-2);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── CTA: sólido, ancho completo, anclado al fondo ── */
  .pcard__cta {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    width: 100%;
    min-height: 48px;
    padding: .6em 1em;
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    color: #fff;
    background: var(--c-primary);
    border-radius: var(--radius-md);
    transition: background-color var(--transition);
  }

  .pcard__cta > span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pcard__link:hover .pcard__cta {
    background: var(--c-primary-dark);
  }

  .pcard__link:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }
</style>
