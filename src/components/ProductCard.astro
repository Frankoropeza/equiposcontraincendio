---
// ============================================================================
// ProductCard.astro — Tarjeta de producto del catálogo.
// ----------------------------------------------------------------------------
// ORIGEN: PROYECTORED .ccard (CatalogoProductos) + RelatedProducts de MESECI.
// Imagen estática con width/height (anti-CLS). Para WhatsApp directo usa waUrl
// en el href que pases.
//
import { srcsetFor } from '@lib/img'
import Icon from '@components/Icon.astro'
import Card from './Card.astro'
// REDISEÑO 2026-09-10 — CONTRATO DE TARJETA COMPARTIDO
// Misma geometría que CategoryCard y ServiceCard, para que los grids del sitio
// se lean como un solo sistema: media 16/10 con badge, título de altura fija de
// 2 líneas, descripción de altura fija de 3 líneas con line-clamp (el texto
// completo sigue en el DOM para SEO) y CTA sólido a ancho completo anclado al
// fondo, con el texto en `nowrap`. Detalle importante: las alturas son `height`
// y no `min-height` — un glifo como el subíndice de «CO₂» agranda la caja de
// línea y hacía que las tarjetas con ese carácter midieran ~11 px más que el
// resto, desalineando toda la fila del grid.
// La tarjeta entera sigue siendo un enlace, así que el CTA es un <span> con
// aspecto de botón (no se anida un <a> dentro de otro).
interface Props {
  title: string
  href: string                 // /productos/<slug>
  image?: string
  imageAlt?: string
  /** Badge superior (ej. norma o categoría). */
  badge?: string
  description?: string
  /** Texto del CTA. */
  ctaLabel?: string
  /** Posición del card en el grid (para loading eager en los primeros). */
  index?: number
  /** Recurso LCP (primer card del primer grid). */
  priority?: boolean
  external?: boolean
}
const { title, href, image, imageAlt, badge, description, ctaLabel = 'Ficha técnica', index = 99, priority = false, external = false } = Astro.props
const eager = priority || index < 4
---

<Card variant="product" class="pcard" aria-label={title}>
  <a href={href} class="pcard__link" target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
    {image && (
      <div class="pcard__media">
        <img
          src={image}
          alt={imageAlt ?? title}
          width="640" height="360"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          srcset={srcsetFor(image)}
          fetchpriority={priority ? 'high' : undefined}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 320px"
          class="pcard__img"
        />
        <span class="pcard__overlay" aria-hidden="true"></span>
        {badge && <span class="pcard__badge">{badge}</span>}
      </div>
    )}
    <div class="pcard__body">
      <h3 class="pcard__title">{title}</h3>
      {description && <p class="pcard__desc">{description}</p>}
      <span class="pcard__cta">
        <span>{ctaLabel}</span>
        <Icon name="arrow" size={14} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </span>
    </div>
  </a>
</Card>

<style>
  /* Cards estáticas; solo los botones tienen transición (regla 2026-09-10). */
  .pcard {
    height: 100%;
  }

  .pcard__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  /* ── Media: 16/10, igual que CategoryCard y ServiceCard ── */
  /* ── Cuerpo: zonas de altura reservada ── */
  /* ── CTA: sólido, ancho completo, anclado al fondo ── */
  .pcard__cta {
    margin-top: auto;
  }

  .pcard__cta > span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pcard__link:hover .pcard__cta {
    background: var(--c-primary-dark);
  }

  .pcard__link:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }
</style>
