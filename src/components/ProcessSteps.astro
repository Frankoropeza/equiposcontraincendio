---
// ============================================================================
// ProcessSteps.astro — "Cómo trabajamos" en pasos (fondo oscuro).
// ----------------------------------------------------------------------------
// Proceso de trabajo en 8 pasos, en filas de 4 sobre fondo tinta. Da claridad y
// reduce fricción ("¿qué pasa si te escribo?"). Contenido = proceso real del
// negocio (sin promesas que no se puedan cumplir, p. ej. tiempos garantizados).
// Encabezado vía SectionHeading (duo, dark). ORIGEN del patrón: PROYECTORED ProcesoIndex.
// ============================================================================
import SectionHeading from './SectionHeading.astro';

interface Step {
  num: string;
  title: string;
  desc: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  titleAccent?: string;
  desc?: string;
  body?: string[];
  steps: Step[];
}
const {
  eyebrow = 'Cómo trabajamos',
  title,
  titleAccent,
  desc,
  body = [],
  steps,
} = Astro.props;
if (steps.length % 4 !== 0) {
  throw new Error(`ProcessSteps requiere un múltiplo de 4 pasos; recibió ${steps.length}.`);
}
---

<section class="process">
  <div class="container">
    <SectionHeading
      layout="duo"
      dark
      eyebrow={eyebrow}
      title={title}
      titleAccent={titleAccent}
      desc={desc}
      body={body}
    />

    <ol class="process__grid" role="list" aria-label="Proceso de trabajo">
      {steps.map((p) => (
        <li class="step">
          <div class="step__body">
            <h3 class="step__title">{p.title}</h3>
            <p class="step__desc">{p.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* .container/.section/.section--surface: utilidades globales de tokens.css (F3.3). */

  .process { padding: var(--section-py) 0; background: var(--c-ink); color: #fff; }

  .process__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .step {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    border-top: 1px solid rgba(255,255,255,.10);
  }
  .step:first-child { border-top: none; }
  /* Título de paso: ALTURA FIJA de 2 líneas. Con altura libre, los pasos de
     título largo empujaban su descripción hacia abajo y la fila quedaba
     dentada — el mismo defecto que se corrigió en las tarjetas. Es `height` y
     no `min-height` a propósito: un glifo alto (subíndices, acentos) agranda
     la caja de línea y volvería a descuadrar la retícula. */
  .step__title {
    margin: 0;
    height: calc(var(--text-base) * var(--leading-snug) * 2);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: #fff;
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .step__desc {
    margin: 0;
    font-size: var(--text-sm);
    color: rgba(255,255,255,.62);
    line-height: var(--leading-relaxed);
  }
  /* En una sola columna (móvil) el título no necesita reservar dos líneas. */
  @media (max-width: 767px) {
    .step__title { height: auto; -webkit-line-clamp: none; display: block; }
  }

  @media (min-width: 640px) {
    .process__grid { grid-template-columns: repeat(2, 1fr); }
    .step { border-top: 1px solid rgba(255,255,255,.10); border-right: 1px solid rgba(255,255,255,.10); }
    .step:nth-child(-n+2) { border-top: none; }
    .step:nth-child(2n) { border-right: none; }
  }
  @media (min-width: 1024px) {
    .process__grid { grid-template-columns: repeat(4, 1fr); }
    .step { border-top: 1px solid rgba(255,255,255,.10); border-right: 1px solid rgba(255,255,255,.10); }
    .step:nth-child(-n+4) { border-top: none; }
    .step:nth-child(4n) { border-right: none; }
  }
</style>
