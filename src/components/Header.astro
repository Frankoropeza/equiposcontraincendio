</style>

<script>
  (() => {
    const OPEN_DELAY = 90
    const CLOSE_DELAY = 160
    const header = document.querySelector<HTMLElement>('.site-header')
    const overlay = document.getElementById('hdr-overlay')
    const mobileNav = document.getElementById('hdr-mobile-nav')
    const burger = document.getElementById('hdr-burger-btn') as HTMLButtonElement | null
    const desktopItems = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-item]'))
      .map((item) => {
        const trigger = item.querySelector<HTMLButtonElement>('.hdr-nav__trigger')
        const panel = document.getElementById(trigger?.getAttribute('aria-controls') ?? '')

        return {
          item,
          trigger,
          panel,
          timer: null as ReturnType<typeof setTimeout> | null,
        }
      })
      .filter(
        (
          entry,
        ): entry is {
          item: HTMLElement
          trigger: HTMLButtonElement
          panel: HTMLElement
          timer: ReturnType<typeof setTimeout> | null
        } => Boolean(entry.trigger && entry.panel),
      )

    const clearTimer = (entry: typeof desktopItems[number]) => {
      if (!entry.timer) return

      clearTimeout(entry.timer)
      entry.timer = null
    }

    const closeNow = (entry: typeof desktopItems[number]) => {
      clearTimer(entry)
      entry.item.classList.remove('is-open')
      entry.trigger.setAttribute('aria-expanded', 'false')
      entry.panel.classList.remove('is-open')
      entry.panel.setAttribute('aria-hidden', 'true')
      entry.panel.hidden = true
    }

    const syncOverlay = () => {
      const anyOpen = desktopItems.some((entry) => entry.panel.classList.contains('is-open'))

      overlay?.classList.toggle('is-visible', anyOpen)
      overlay?.setAttribute('aria-hidden', anyOpen ? 'false' : 'true')
    }

    const closeAll = () => {
      desktopItems.forEach(closeNow)
      syncOverlay()
    }

    const open = (entry: typeof desktopItems[number]) => {
      clearTimer(entry)
      desktopItems.forEach((other) => {
        if (other !== entry) closeNow(other)
      })
      entry.item.classList.add('is-open')
      entry.trigger.setAttribute('aria-expanded', 'true')
      entry.panel.hidden = false
      entry.panel.classList.add('is-open')
      entry.panel.setAttribute('aria-hidden', 'false')
      syncOverlay()
    }

    const scheduleClose = (entry: typeof desktopItems[number]) => {
      clearTimer(entry)
      entry.timer = setTimeout(() => {
        closeNow(entry)
        syncOverlay()
      }, CLOSE_DELAY)
    }

    desktopItems.forEach((entry) => {
      entry.trigger.addEventListener('click', () => {
        if (entry.panel.classList.contains('is-open')) closeNow(entry)
        else open(entry)
        syncOverlay()
      })

      entry.trigger.addEventListener('mouseenter', () => {
        if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return

        clearTimer(entry)
        entry.timer = setTimeout(() => open(entry), OPEN_DELAY)
      })

      entry.item.addEventListener('mouseleave', () => {
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          scheduleClose(entry)
        }
      })

      entry.panel.addEventListener('mouseenter', () => clearTimer(entry))
      entry.panel.addEventListener('mouseleave', () => scheduleClose(entry))
      entry.trigger.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown') return

        event.preventDefault()
        open(entry)
        entry.panel.querySelector<HTMLElement>('a')?.focus()
      })
    })

    overlay?.addEventListener('click', closeAll)
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return

      const opened = desktopItems.find((entry) => entry.panel.classList.contains('is-open'))
      if (opened) {
        closeAll()
        opened.trigger.focus()
        return
      }

      if (mobileNav?.getAttribute('aria-hidden') === 'false') setMenu(false)
    })
    document.querySelectorAll<HTMLElement>('.mega-panel a, .drop-panel a').forEach((link) => link.addEventListener('click', closeAll))

    const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4)
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })

    const mobileTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.mob-item__trigger'))
    const closeMobileAccordions = () => {
      mobileTriggers.forEach((trigger) => {
        trigger.setAttribute('aria-expanded', 'false')
        const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '')
        if (panel) panel.hidden = true
      })
    }

    const setMenu = (isOpen: boolean) => {
      if (!mobileNav || !burger) return

      mobileNav.hidden = !isOpen
      if (isOpen) {
        const bottom = header ? Math.max(0, Math.round(header.getBoundingClientRect().bottom)) : 0
        mobileNav.style.top = `${bottom}px`
      } else {
        closeMobileAccordions()
      }
      mobileNav.setAttribute('aria-hidden', isOpen ? 'false' : 'true')
      burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false')
      burger.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú')
      document.body.classList.toggle('menu-open', isOpen)
      if (isOpen) mobileNav.querySelector<HTMLElement>('a, button')?.focus()
      else burger.focus()
    }

    burger?.addEventListener('click', () => setMenu(mobileNav?.getAttribute('aria-hidden') !== 'false'))
    mobileTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '')
        if (!panel) return

        const wasOpen = trigger.getAttribute('aria-expanded') === 'true'
        closeMobileAccordions()
        trigger.setAttribute('aria-expanded', wasOpen ? 'false' : 'true')
        panel.hidden = wasOpen
        if (!wasOpen) {
          trigger.scrollIntoView({ block: 'start', behavior: 'auto' })
        }
      })
    })
    mobileNav?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => link.addEventListener('click', () => setMenu(false)))
    mobileNav?.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return

      const focusable = Array.from(mobileNav.querySelectorAll<HTMLElement>('a, button')).filter((element) => !element.hasAttribute('disabled'))
      if (!focusable.length) return

      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    })
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        closeAll()
        if (mobileNav?.getAttribute('aria-hidden') === 'false') setMenu(false)
      }
    })
  })()
</script>
