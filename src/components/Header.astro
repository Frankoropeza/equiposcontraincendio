---
import { NAV, SITE, CONTACT, navHref, waUrl, telUrl, WA_MESSAGES } from '@config/site'
import EmailLink from '@components/EmailLink.astro'
import Icon from '@components/Icon.astro'

interface Props {
  guia?: boolean
}

const { guia = false } = Astro.props
const currentPath = Astro.url.pathname
const schedule = CONTACT.schedule?.display

const PUNTOS = [
  {
    n: 1,
    nombre: 'Logotipo',
    que: 'La marca, a la izquierda, enlazando a la home. Es el ancla de identidad y el «volver al inicio» que todos esperan.',
    dato: 'SITE.brand · SITE.name',
  },
  {
    n: 2,
    nombre: 'Navegación',
    que: 'Las seis entradas se generan desde NAV; los botones con panel abren un mega-menú o un dropdown y los enlaces directos llevan a su página.',
    dato: 'NAV · NAV[].groups · NAV[].items',
  },
  {
    n: 3,
    nombre: 'Paneles',
    que: 'Las entradas con panel usan mega-menús o dropdown. El overlay y el teclado mantienen la navegación enfocada.',
    dato: 'NAV[].panel · NAV[].promo',
  },
  {
    n: 4,
    nombre: 'CTA · Cotizar',
    que: 'El botón de WhatsApp se mantiene visible en escritorio y reaparece en el pie fijo del drawer móvil.',
    dato: 'waUrl(WA_MESSAGES.cotizacion)',
  },
]

const navId = (value: string) =>
  'navp-' + value.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-')

const matchesPath = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href)

const isActive = (item: (typeof NAV)[number]) =>
  matchesPath(item.href) || (item.match ?? []).some(matchesPath)

const isExact = (item: (typeof NAV)[number]) =>
  currentPath === item.href || (item.match ?? []).some((href) => currentPath === href)

---

<header class:list={['site-header', { 'is-guia': guia }]} role="banner">
  <div class="hdr-inner">
    <a href="/" class="hdr-logo">
      {guia && <span class="hdr-mark" aria-hidden="true">1</span>}
      <span class="hdr-logo__mark" aria-hidden="true">{SITE.brand.charAt(0)}</span>
      <span class="hdr-logo__lockup">
        <span class="hdr-logo__word">{SITE.brand}</span>
        <span class="hdr-logo__descriptor">Contra incendios</span>
      </span>
      <span class="sr-only">, ir al inicio</span>
    </a>

    <nav class="hdr-nav" aria-label="Navegación principal">
      <ul class="hdr-nav__list" role="list">
        {NAV.map((item, index) => item.panel ? (
          <li class="hdr-nav__item" data-nav-item={navId(item.label)}>
            <button
              type="button"
              class:list={['hdr-nav__trigger', { 'hdr-nav__trigger--active': isActive(item) }]}
              aria-expanded="false"
              aria-controls={navId(item.label)}
              aria-haspopup="true"
              aria-current={isExact(item) ? 'page' : undefined}
            >
              {guia && index === 0 && <span class="hdr-mark" aria-hidden="true">2</span>}
              <span>{item.label}</span>
              <Icon name="chevron" size={14} class="nav-chevron" />
              {guia && index === 1 && <span class="hdr-mark" aria-hidden="true">3</span>}
            </button>
            {item.panel === 'dropdown' && (
              <div class="drop-panel" id={navId(item.label)} role="region" aria-label={item.label} aria-hidden="true" hidden>
                <div class="drop-panel__inner">
                  <a href={navHref(item.href)} class="drop-panel__all">{item.allLabel} <Icon name="arrow" size={14} /></a>
                  {(item.items ?? []).map((link) => (
                    <a
                      href={navHref(link.href)}
                      class="drop-panel__link"
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      <span class="drop-panel__link-label">{link.label}</span>
                      {link.desc && <span class="drop-panel__link-desc">{link.desc}</span>}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </li>
        ) : (
          <li class="hdr-nav__item">
            <a
              href={navHref(item.href)}
              class:list={['hdr-nav__link', { 'hdr-nav__link--active': isActive(item) }]}
              aria-current={isExact(item) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href={waUrl(WA_MESSAGES.cotizacion)} class="hdr-cta" target="_blank" rel="noopener noreferrer" aria-label="Solicitar cotización por WhatsApp">
      {guia && <span class="hdr-mark hdr-mark--cta" aria-hidden="true">4</span>}
      <Icon name="wa" size={16} />
      <span>Cotizar</span>
    </a>

    <button class="hdr-burger" id="hdr-burger-btn" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="hdr-mobile-nav">
      <span></span><span></span><span></span>
    </button>
  </div>

  {NAV.filter((item) => item.panel === 'mega').map((item) => (
    <div class="mega-panel" id={navId(item.label)} role="region" aria-label={item.label} aria-hidden="true" hidden>
      <div class="mega-panel__inner">
        <div class="mega-panel__top">
          <div>
            <p class="mega-panel__label">{item.label}</p>
            {item.sub && <p class="mega-panel__sub">{item.sub}</p>}
          </div>
          <a href={navHref(item.href)} class="mega-panel__all">{item.allLabel} <Icon name="arrow" size={14} /></a>
        </div>
        <div class="mega-panel__body">
          <div class:list={['mega-groups', { 'mega-groups--three': (item.groups ?? []).length === 3 }]}>
            {(item.groups ?? []).map((group) => (
              <section class="mega-group">
                {group.href ? (
                  <a href={navHref(group.href)} class="mega-group__title">{group.title}</a>
                ) : (
                  <p class="mega-group__title">{group.title}</p>
                )}
                <ul class="mega-group__links" role="list">
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={navHref(link.href)}
                        class="mega-link"
                        target={link.external ? '_blank' : undefined}
                        rel={link.external ? 'noopener noreferrer' : undefined}
                      >
                        <span class="mega-link__label">{link.label}</span>
                        {link.desc && <span class="mega-link__desc">{link.desc}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
          {item.promo && (
            <aside class="mega-promo">
              <p class="mega-promo__eyebrow">{item.promo.eyebrow}</p>
              <p class="mega-promo__title">{item.promo.title}</p>
              <p class="mega-promo__text">{item.promo.text}</p>
              <a
                href={navHref(item.promo.cta.href)}
                class="mega-promo__cta"
                target={item.promo.cta.external ? '_blank' : undefined}
                rel={item.promo.cta.external ? 'noopener noreferrer' : undefined}
              >
                {item.promo.cta.href.startsWith('wa:') && <Icon name="wa" size={16} />}
                <span>{item.promo.cta.label}</span>
              </a>
              {item.promo.secondary && (
                <a
                  href={navHref(item.promo.secondary.href)}
                  class="mega-promo__secondary"
                  target={item.promo.secondary.external ? '_blank' : undefined}
                  rel={item.promo.secondary.external ? 'noopener noreferrer' : undefined}
                >
                  {item.promo.secondary.label} <Icon name="arrow" size={14} />
                </a>
              )}
            </aside>
          )}
        </div>
      </div>
    </div>
  ))}
</header>

{guia && (
  <div class="hbg" role="note" aria-label="Guía del header">
    <div class="hbg-inner">
      <p class="hbg__tag"><span aria-hidden="true">🧭</span> Guía · Header</p>
      <p class="hbg__intro">Barra de navegación principal (logotipo + menú), bajo el topbar. Todo el menú —escritorio, paneles y móvil— se genera desde <code>NAV</code> en <code>src/config/site.ts</code>.</p>
      <ol class="hbg__list">
        {PUNTOS.map((point) => (
          <li class="hbg__pt">
            <span class="hbg__num">{point.n}</span>
            <div class="hbg__pt-body">
              <p class="hbg__nombre">{point.nombre}</p>
              <p class="hbg__que">{point.que}</p>
              <p class="hbg__dato"><span>Dato</span> <code>{point.dato}</code></p>
            </div>
          </li>
        ))}
      </ol>
      <p class="hbg__edit"><span>Edita en</span> <code>src/components/Header.astro</code> · <code>src/config/site.ts</code></p>
    </div>
  </div>
)}

<div class="hdr-overlay" id="hdr-overlay" aria-hidden="true"></div>

<div class="hdr-mobile-nav" id="hdr-mobile-nav" role="dialog" aria-modal="true" aria-label="Menú principal" aria-hidden="true" hidden>
  <div class="mob-scroll">
    <nav aria-label="Navegación móvil">
      {NAV.map((item) => item.panel ? (
        <div class:list={['mob-item', { 'mob-item--active': isActive(item) }]}>
          <button
            type="button"
            class="mob-item__trigger"
            aria-expanded="false"
            aria-controls={`${navId(item.label)}-mobile`}
            aria-current={isExact(item) ? 'page' : undefined}
          >
            <span class="mob-item__copy"><strong>{item.label}</strong>{item.sub && <small>{item.sub}</small>}</span>
            <Icon name="chevron" size={14} class="mob-chevron" />
          </button>
          <div class="mob-item__panel" id={`${navId(item.label)}-mobile`} role="region" aria-label={item.label} hidden>
            <div class="mob-item__panel-inner">
              <a href={navHref(item.href)} class="mob-item__all">{item.allLabel} <Icon name="arrow" size={14} /></a>
              {(item.groups ?? []).map((group) => (
                <div class="mob-group">
                  {group.href ? <a href={navHref(group.href)} class="mob-group__title">{group.title}</a> : <p class="mob-group__title">{group.title}</p>}
                  {group.links.map((link) => (
                    <a
                      href={navHref(link.href)}
                      class="mob-item__link"
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      <span><strong>{link.label}</strong>{link.desc && <small>{link.desc}</small>}</span>
                      <Icon name="arrow" size={14} />
                    </a>
                  ))}
                </div>
              ))}
              {(item.items ?? []).map((link) => (
                <a href={navHref(link.href)} class="mob-item__link" target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                  <span><strong>{link.label}</strong>{link.desc && <small>{link.desc}</small>}</span>
                  <Icon name="arrow" size={14} />
                </a>
              ))}
              {item.promo && (
                <a href={navHref(item.promo.cta.href)} class="mob-item__promo" target={item.promo.cta.external ? '_blank' : undefined} rel={item.promo.cta.external ? 'noopener noreferrer' : undefined}>
                  <span><strong>{item.promo.title}</strong><small>{item.promo.cta.label}</small></span>
                  <Icon name="arrow" size={14} />
                </a>
              )}
            </div>
          </div>
        </div>
      ) : (
        <a href={navHref(item.href)} class:list={['mob-direct', { 'mob-direct--active': isActive(item) }]} aria-current={isExact(item) ? 'page' : undefined}>
          <span class="mob-item__copy"><strong>{item.label}</strong>{item.sub && <small>{item.sub}</small>}</span>
          <Icon name="arrow" size={14} />
        </a>
      ))}
    </nav>
  </div>

  <div class="mob-foot">
    <div class="mob-foot__cta">
      <a href={waUrl(WA_MESSAGES.cotizacion)} class="mob-cta" target="_blank" rel="noopener noreferrer"><Icon name="wa" size={16} /> Cotizar</a>
      <a href={telUrl()} class="mob-call" aria-label={`Llamar al ${CONTACT.phone}`}><Icon name="phone" size={16} /> Llamar</a>
    </div>
    {schedule && <p class="mob-foot__meta">{schedule}</p>}
    <EmailLink email={CONTACT.email} class="mob-foot__email">{CONTACT.email}</EmailLink>
  </div>
</div>

<style>
.site-header {
  position: sticky;
  top: var(--topbar-height);
  z-index: 500;
  background: var(--c-white);
  border-bottom: 1px solid var(--c-border);
  box-shadow: 0 1px 2px rgba(20, 24, 31, 0.06);
}
.site-header.is-guia {
  top: 0;
}
.site-header.is-scrolled {
  box-shadow: 0 4px 18px rgba(20, 24, 31, 0.1);
}
.hdr-inner {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  min-height: var(--header-height);
  max-width: var(--container-max);
  margin-inline: auto;
  padding-inline: var(--container-px);
}
.hdr-logo {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  flex-shrink: 0;
  text-decoration: none;
}
.hdr-logo__mark {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: var(--radius-md);
  background: var(--c-primary);
  color: var(--c-white);
  font-family: var(--font-heading);
  font-size: var(--text-xl);
  font-weight: var(--weight-black);
  line-height: 1;
  box-shadow: 0 4px 12px rgba(var(--c-primary-rgb), 0.28);
}
.hdr-logo__lockup {
  display: flex;
  flex-direction: column;
  gap: 0.18rem;
}
.hdr-logo__word {
  color: var(--c-ink);
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: var(--weight-black);
  letter-spacing: -0.02em;
  line-height: 1;
}
.hdr-logo__descriptor {
  color: var(--c-primary);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.11em;
  line-height: 1;
  text-transform: uppercase;
}
.hdr-nav {
  margin-left: auto;
}
.hdr-nav__list {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  list-style: none;
  margin: 0;
  padding: 0;
}
.hdr-nav__item {
  position: relative;
}
.hdr-nav__link,
.hdr-nav__trigger {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  min-height: 44px;
  padding: var(--sp-2) 0.7rem;
  border: 0;
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--c-ink-2);
  cursor: pointer;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  line-height: 1.2;
  text-decoration: none;
  white-space: nowrap;
}
.hdr-nav__link:hover,
.hdr-nav__link:focus-visible,
.hdr-nav__trigger:hover,
.hdr-nav__trigger:focus-visible,
.hdr-nav__trigger--active {
  background: rgba(var(--c-primary-rgb), 0.06);
  color: var(--c-primary);
}
.hdr-nav__link:focus-visible,
.hdr-nav__trigger:focus-visible,
.hdr-cta:focus-visible,
.hdr-burger:focus-visible,
.mega-panel a:focus-visible,
.drop-panel a:focus-visible,
.mob-item button:focus-visible,
.mob-item a:focus-visible {
  outline: 2px solid var(--c-primary);
  outline-offset: 2px;
}
.hdr-nav__link--active::after,
.hdr-nav__trigger--active::after {
  position: absolute;
  right: var(--sp-3);
  bottom: 2px;
  left: var(--sp-3);
  height: 2px;
  border-radius: var(--radius-full);
  background: var(--c-primary);
  content: "";
}
.nav-chevron,
.mob-chevron {
  flex-shrink: 0;
}
.hdr-nav__item.is-open .nav-chevron,
.mob-item__trigger[aria-expanded="true"] .mob-chevron {
  transform: rotate(180deg);
}
.hdr-cta,
.mega-promo__cta,
.mob-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  min-height: 44px;
  border: 1px solid var(--c-primary);
  border-radius: var(--radius-md);
  background: var(--c-primary);
  color: var(--c-white);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  text-decoration: none;
}
.hdr-cta {
  flex-shrink: 0;
  padding: 0.6rem 1rem;
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}
.hdr-cta:hover,
.mega-promo__cta:hover,
.mob-cta:hover {
  border-color: var(--c-primary-dark);
  background: var(--c-primary-dark);
  color: var(--c-white);
}
.mega-promo__cta,
.mob-cta,
.mob-call {
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}
.hdr-burger {
  display: none;
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  margin-left: auto;
  padding: 0;
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  background: var(--c-white);
  cursor: pointer;
}
.hdr-burger span {
  display: block;
  width: 20px;
  height: 2px;
  border-radius: var(--radius-full);
  background: var(--c-ink-2);
}
.hdr-burger[aria-expanded="true"] {
  border-color: var(--c-primary);
}
.hdr-burger[aria-expanded="true"] span {
  background: var(--c-primary);
}
.hdr-burger[aria-expanded="true"] span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}
.hdr-burger[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}
.hdr-burger[aria-expanded="true"] span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}
.mega-panel,
.drop-panel {
  position: absolute;
  z-index: 490;
  border: 1px solid var(--c-border);
  background: var(--c-white);
  box-shadow: 0 14px 30px rgba(20, 24, 31, 0.12);
  opacity: 0;
  pointer-events: none;
}
.mega-panel {
  top: 100%;
  right: 0;
  left: 0;
  max-height: calc(100vh - var(--stack-height));
  overflow-y: auto;
  border-right: 0;
  border-left: 0;
  border-radius: 0;
}
.drop-panel {
  top: calc(100% + var(--sp-2));
  left: 0;
  min-width: 300px;
  border-radius: var(--radius-lg);
}
.mega-panel.is-open,
.drop-panel.is-open {
  opacity: 1;
  pointer-events: auto;
}
.mega-panel[hidden],
.drop-panel[hidden] {
  display: none;
}
.mega-panel__inner {
  max-width: var(--container-max);
  margin-inline: auto;
  padding: 1.5rem var(--container-px) 1.75rem;
}
.mega-panel__top {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: var(--sp-4);
  padding-bottom: var(--sp-4);
  border-bottom: 1px solid var(--c-border);
}
.mega-panel__label,
.mega-panel__sub {
  margin: 0;
}
.mega-panel__label {
  color: var(--c-ink);
  font-family: var(--font-heading);
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
}
.mega-panel__sub {
  margin-top: 0.2rem;
  color: var(--c-muted);
  font-size: var(--text-sm);
}
.mega-panel__all,
.drop-panel__all {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  color: var(--c-primary);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  text-decoration: none;
  white-space: nowrap;
}
.mega-panel__all:hover,
.drop-panel__all:hover,
.mega-group__title:hover,
.mega-promo__secondary:hover {
  color: var(--c-primary-dark);
}
.mega-panel__body {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 320px;
  gap: 2rem;
  padding-top: 1.5rem;
}

@media (min-width: 1024px) and (max-width: 1279px) {
  .mega-panel__body {
    grid-template-columns: 1fr;
  }

  .mega-promo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, auto);
    grid-template-areas:
      "eyebrow cta"
      "title cta"
      "text secondary";
    align-items: center;
    column-gap: 2rem;
  }

  .mega-promo__eyebrow {
    grid-area: eyebrow;
  }

  .mega-promo__title {
    grid-area: title;
  }

  .mega-promo__text {
    grid-area: text;
  }

  .mega-promo__cta {
    grid-area: cta;
    width: auto;
    min-width: 220px;
    justify-self: end;
  }

  .mega-promo__secondary {
    grid-area: secondary;
    justify-self: end;
  }
}
.mega-groups {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  gap: 1.5rem;
}
.mega-groups--three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.mega-group__title {
  display: block;
  margin: 0 0 0.6rem;
  border: 0;
  background: transparent;
  color: var(--c-muted);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.08em;
  line-height: 1.3;
  text-align: left;
  text-decoration: none;
  text-transform: uppercase;
}
.mega-group__title {
  font-family: var(--font-body);
}
.mega-group__links {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
  list-style: none;
  margin: 0;
  padding: 0;
}
.mega-link,
.drop-panel__link {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  min-width: 0;
  padding: 0.625rem 0.75rem;
  border-radius: var(--radius-md);
  color: var(--c-ink);
  text-decoration: none;
}
.mega-link:hover,
.mega-link:focus-visible,
.drop-panel__link:hover,
.drop-panel__link:focus-visible {
  background: rgba(var(--c-primary-rgb), 0.06);
  color: var(--c-primary);
}
.mega-link__label,
.drop-panel__link-label {
  font-size: 0.9375rem;
  font-weight: var(--weight-semibold);
  line-height: 1.3;
