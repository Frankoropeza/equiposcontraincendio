---
// TopBar.astro — Barra utilitaria superior del sistema OrigenLab Master System.
// ============================================================================
// Primer eslabón del CHROME STICKY: topbar (top:0) + header (top:--topbar-height)
// forman un stack pegajoso coherente (ver --stack-height en tokens.css). El menú
// y el contacto quedan SIEMPRE a la vista; en móvil ya no aparece una píldora
// suelta: el contacto se reparte en dos acciones de igual peso (llamar · WhatsApp).
//
// SSoT: TODO el contenido sale de src/config/site.ts (SITE / CONTACT / WA_MESSAGES).
// Los enlaces se arman con telUrl() y waUrl() — NUNCA un `tel:` o `wa.me` a mano
// (regla dura D4). Cambias el dato en site.ts y se actualiza en todo el sitio.
// ============================================================================
import { SITE, CONTACT, waUrl, telUrl, WA_MESSAGES } from '@config/site'
import Icon from '@components/Icon.astro'

const schedule = CONTACT.schedule?.display as string | undefined
---

<aside class="topbar" aria-label="Información de contacto">
  <div class="tb-inner">
    <p class="tb-promo">
      <span class="tb-spark" aria-hidden="true"></span>
      <span class="tb-promo__txt">{SITE.tagline}</span>
    </p>

    <div class="tb-actions">
      {schedule && (
        <span class="tb-item tb-schedule">
          <Icon name="clock" size={14} class="tb-ico" fill="none" stroke="currentColor" stroke-width="2" />
          <span class="tb-item__txt">{schedule}</span>
        </span>
      )}

      <a href={telUrl()} class="tb-item tb-phone" aria-label={`Llamar al ${CONTACT.phone}`}>
        <Icon name="phone" size={14} class="tb-ico" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <span class="tb-item__txt">{CONTACT.phone}</span>
      </a>

      <a href={waUrl(WA_MESSAGES.cotizar)} class="tb-item tb-wa" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
        <Icon name="wa" size={14} class="tb-ico" />
        <span class="tb-item__txt">WhatsApp</span>
      </a>
    </div>
  </div>
</aside>

<style>
  /* ── Barra real ─────────────────────────────────────────────────────────────
  Sticky en top:0. El Header se pega justo debajo (top:--topbar-height) → juntos
  forman el stack del chrome (--stack-height). Fondo índigo con profundidad y un
  hairline inferior para separarlo del header sin una línea dura. */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 501;
    height: var(--topbar-height);
    display: flex;
    align-items: center;
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    background: linear-gradient(100deg, var(--c-primary-dark) 0%, var(--c-primary) 60%, var(--c-primary-light) 140%);
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, .14);
  }

  .tb-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-px);
  }

  /* Propuesta de valor + chispa de marca (rombo) antes del texto. */
  .tb-promo {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-width: 0;
    flex: 1;
    opacity: .96;
    margin: 0;
  }

  .tb-spark {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: #fff;
    transform: rotate(45deg);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, .18);
  }

  .tb-promo__txt {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: .005em;
  }

  /* Cluster de acciones a la derecha. */
  .tb-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
  }

  .tb-item {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    padding: .25rem .5rem;
    border-radius: var(--radius-sm);
  }

  .tb-ico {
    flex-shrink: 0;
    opacity: .9;
  }

  .tb-schedule {
    opacity: .9;
    cursor: default;
  }

  .tb-phone:hover {
    background: rgba(255, 255, 255, .12);
  }

  .tb-item:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* WhatsApp = acción destacada (píldora translúcida). */
  .tb-wa {
    background: rgba(255, 255, 255, .16);
    padding: .25rem .8rem;
    border-radius: var(--radius-full);
    font-weight: var(--weight-semibold);
  }

  .tb-wa:hover {
    background: rgba(255, 255, 255, .30);
  }

  /* ── Responsive de la barra ───────────────────────────────────────────────────
  Tablet: se esconde la propuesta para dar aire al contacto.
  Móvil (≤640): el contacto se reparte en DOS acciones de igual peso —llamar y
  WhatsApp— ocupando todo el ancho, con un divisor fino. Adiós a la píldora suelta. */
  @media (max-width: 900px) {
    .tb-promo {
      display: none;
    }

    .tb-actions {
      flex: 1;
      justify-content: flex-end;
    }
  }

  /* El horario largo cede espacio antes de que comprima los canales. */
  @media (min-width: 901px) and (max-width: 1199px) {
    .tb-schedule { display: none; }
  }

  @media (max-width: 640px) {
    .tb-schedule {
      display: none;
    }

    .tb-inner {
      gap: 0;
    }

    .tb-actions {
      width: 100%;
      gap: 0;
    }

    .tb-phone,
    .tb-wa {
      flex: 1;
      justify-content: center;
      min-height: var(--topbar-height);
      background: transparent;
      border-radius: 0;
      font-weight: var(--weight-semibold);
    }

    .tb-phone {
      box-shadow: inset -1px 0 0 rgba(255, 255, 255, .22);
    }

    .tb-wa:hover,
    .tb-phone:hover {
      background: rgba(255, 255, 255, .12);
    }
  }

</style>
