---
// ============================================================================
// RiskGuide.astro — Guía de selección por nivel de riesgo.
// ----------------------------------------------------------------------------
// Tabla "qué equipo necesito según mi riesgo" (ordinario / moderado / alto),
// basada en la clasificación de la NOM-002-STPS-2010. Patrón de ALTO valor:
// resuelve la duda real del comprador, posiciona en SEO de cola larga y abre la
// conversación de cotización. Contenido normativo (no inventado).
// Encabezado vía SectionHeading (duo). ORIGEN del patrón: PROYECTORED SeleccionIndex.
// ============================================================================
import SectionHeading from './SectionHeading.astro';
import Icon from '@components/Icon.astro';

interface Row {
  nivel: string;
  ejemplos: string;
  minimo: string;
  complementos: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  titleAccent?: string;
  desc?: string;
  body?: string[];
  rows: Row[];
  /** Encabezados de columna (4). Default orientado a riesgo/equipo; sobreescribe para otro vertical. */
  columns?: [string, string, string, string];
  note?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  eyebrow = 'Guía de selección',
  title,
  titleAccent,
  desc,
  body = [],
  rows,
  columns = ['Nivel de riesgo', 'Ejemplos de inmueble', 'Equipo base', 'Complementos recomendados'],
  note,
  ctaLabel,
  ctaHref,
} = Astro.props;
---

<section class="riskguide">
  <div class="container">
    <SectionHeading
      layout="duo"
      eyebrow={eyebrow}
      title={title}
      titleAccent={titleAccent}
      desc={desc}
      body={body}
    />

    <div class="tbl-scroll">
      <div class="tbl-wrap" data-scroll-hint role="region" aria-label="Equipo recomendado por nivel de riesgo" tabindex="0">
      <table class="tbl">
        <thead>
          <tr>
            <th scope="col">{columns[0]}</th>
            <th scope="col">{columns[1]}</th>
            <th scope="col">{columns[2]}</th>
            <th scope="col">{columns[3]}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td><strong>{r.nivel}</strong></td>
              <td>{r.ejemplos}</td>
              <td>{r.minimo}</td>
              <td>{r.complementos}</td>
            </tr>
          ))}
        </tbody>
        </table>
      </div>
      <p class="tbl-hint" aria-hidden="true">Desliza para ver toda la tabla</p>
    </div>

    {(note || (ctaLabel && ctaHref)) && (
      <div class="riskguide__footer">
        {note && <p class="riskguide__note">{note}</p>}
        {ctaLabel && ctaHref && (
          <a class="riskguide__cta" href={ctaHref} target="_blank" rel="noopener noreferrer">
            {ctaLabel}
            <Icon name="arrow" size={15} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </a>
        )}
      </div>
    )}
  </div>
</section>

<script>
  import '@lib/scroll-hint';
</script>

<style>
  /* .container/.section/.section--surface: utilidades globales de tokens.css (F3.3). */

  /* ── Afordancia de scroll horizontal ────────────────────────────────────────
  El contenedor marca su posición con data-at (lib/scroll-hint.ts). Mientras
  quede tabla por ver se pinta un degradado en el borde derecho y, en pantallas
  chicas, una nota de deslizamiento. Al llegar al final ambos desaparecen. */
  .tbl-scroll {
    position: relative;
  }

  .tbl-scroll::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--sp-6);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: linear-gradient(to left, rgba(12, 12, 12, .16), rgba(12, 12, 12, 0));
    opacity: 0;
    pointer-events: none;
  }

  .tbl-scroll:has([data-at='start'])::after,
  .tbl-scroll:has([data-at='middle'])::after {
    opacity: 1;
  }

  .tbl-hint {
    display: none;
    margin: var(--sp-2) 0 0;
    color: var(--c-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 768px) {
    /* mobile.css pone table{display:block;overflow-x:auto} como guarda global:
    aquí el scroller debe seguir siendo .tbl-wrap (es el que mide la afordancia). */
    .tbl {
      display: table;
      overflow-x: visible;
    }

    .tbl-scroll:has([data-at='start']) .tbl-hint,
    .tbl-scroll:has([data-at='middle']) .tbl-hint {
      display: block;
    }
  }


  .riskguide {
    padding: var(--section-py) 0;
    background: var(--c-white);
  }

  /* Tabla con scroll horizontal en móvil (robusto, sin reflow frágil). */
  .tbl-wrap {
    overflow-x: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
  }

  .tbl-wrap:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }

  .tbl {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .tbl thead th {
    text-align: left;
    background: var(--c-surface);
    color: var(--c-ink);
    font-family: var(--font-heading);
    font-weight: var(--weight-bold);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: .04em;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--c-border);
    white-space: nowrap;
  }

  .tbl tbody td {
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--c-border);
    color: var(--c-ink-2);
    line-height: var(--leading-normal);
    vertical-align: top;
  }

  .tbl tbody tr:last-child td {
    border-bottom: none;
  }

  .tbl tbody td strong {
    color: var(--c-primary);
    white-space: nowrap;
  }

  .riskguide__footer {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    flex-wrap: wrap;
    margin-top: var(--sp-5);
  }

  .riskguide__note {
    flex: 1;
    min-width: 280px;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--c-muted);
    line-height: var(--leading-relaxed);
  }

  .riskguide__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: .65em 1.2em;
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    color: #fff;
    text-decoration: none;
    background: var(--c-primary);
    border-radius: var(--radius-md);
    transition: background-color var(--transition);
  }

  .riskguide__cta:hover {
    background: var(--c-primary-dark);
  }

  .riskguide__cta:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }
</style>
