---
// ============================================================================
// BlogArchive.astro — cuerpo compartido del blog: listado + barra lateral +
// paginación.
// ----------------------------------------------------------------------------
// Lo usan las TRES rutas del archivo (/blog/, /blog/pagina/N/ y
// /blog/categoria/<slug>/[pagina/N/]) para que el listado sea una sola pieza y
// no tres copias que se van separando con el tiempo (mismo criterio que llevó
// el blog a colección .mdx y la taxonomía a BLOG_CATEGORIES).
// ============================================================================
import SectionHeading from '@components/SectionHeading.astro'
import CategoryCard from '@components/CategoryCard.astro'
import BlogSidebar from '@components/BlogSidebar.astro'
import Pagination from '@components/Pagination.astro'
import { BLOG_CATEGORIES, waUrl } from '@config/site'
import { cierreGeneral, faltanParaCuatro } from '@data/cierre'

type Post = {
  id: string
  data: { title: string; description: string; heroImage: string; category: string; cardTitle?: string; cardDescription?: string }
}

interface Props {
  /** Artículos de ESTA página (ya paginados). */
  posts: Post[]
  /** Página actual (1-based) y total de páginas. */
  current: number
  total: number
  /** Ruta base del archivo, con barra final. */
  base: string
  /** Categoría del archivo, si lo es (marca el widget y quita el badge redundante). */
  currentCategory?: string
  eyebrow: string
  title: string
  titleAccent?: string
  desc?: string
  body?: string[]
  headingAs?: 'h1' | 'h2'
}
const {
  posts,
  current,
  total,
  base,
  currentCategory = '',
  eyebrow,
  title,
  titleAccent,
  desc,
  body = [],
  headingAs = 'h2',
} = Astro.props

const CAT_LABEL: Record<string, string> = Object.fromEntries(
  BLOG_CATEGORIES.map((c) => [c.slug, c.label]),
)
const excludeSlugs = posts.map((p) => p.id)
const cierreItems = current === total
  ? cierreGeneral.slice(0, faltanParaCuatro(posts.length))
  : []
---

<section class="section">
  <div class="container">
    <SectionHeading
      layout="duo"
      eyebrow={eyebrow}
      title={title}
      titleAccent={titleAccent}
      desc={desc}
      body={body}
      as={headingAs}
    />

    <div class="archive">
      <div class="archive__main">
        <div class="card-grid">
          {posts.map((a, i) => (
            <CategoryCard
              label={a.data.cardTitle ?? a.data.title}
              href={`/blog/${a.id}/`}
              image={a.data.heroImage}
              imageAlt={a.data.title}
              badge={CAT_LABEL[a.data.category] ?? 'Artículo'}
              blurb={a.data.cardDescription ?? a.data.description}
              ctaLabel="Leer artículo"
              index={i}
            />
          ))}
          {cierreItems.map((ficha, i) => (
            <CategoryCard
              label={ficha.title}
              href={ficha.whatsapp ? waUrl(ficha.href) : ficha.href}
              image={ficha.image}
              imageAlt={ficha.imageAlt}
              badge={ficha.badge}
              blurb={ficha.description}
              ctaLabel={ficha.ctaLabel}
              index={posts.length + i}
              external={ficha.whatsapp}
            />
          ))}
        </div>

        <Pagination current={current} total={total} base={base} />
      </div>

      <BlogSidebar layout="band" currentCategory={currentCategory} excludeSlugs={excludeSlugs} />
    </div>
  </div>
</section>

<style>
  /* .container/.section/.section--surface: utilidades globales de tokens.css (F3.3). */

  /* Una columna en móvil: el listado primero, la barra al final. */
  .archive {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-7);
    margin-top: var(--sp-6);
  }

  .archive__main {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .archive { gap: var(--sp-8); }
  }
</style>
