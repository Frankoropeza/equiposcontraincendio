---
import { waUrl } from '@config/site';

interface Variante {
  nombre: string;
  badge?: string;
  desc: string;
  specs: string;
  imagen?: string;
  waText: string;
}

interface Props {
  variantes: Variante[];
  fallbackImage: string;
}

const { variantes, fallbackImage } = Astro.props;
---

<div class="variants" aria-labelledby="variants-title">
  <div class="variants__heading">
    <p class="variants__eyebrow">Presentaciones disponibles</p>
    <h2 id="variants-title">Elige la variante adecuada</h2>
    <p>Compara capacidad, tecnología o montaje y solicita una cotización identificando la presentación exacta.</p>
  </div>

  <ul class="variants__grid" role="list">
    {variantes.map((variante) => {
      const image = variante.imagen ?? fallbackImage;
      const specs = variante.specs.split(' · ');

      return (
        <li class="variant-card">
          <img
            class="variant-card__image"
            src={image}
            alt={variante.nombre}
            width="640"
            height="400"
            loading="lazy"
            decoding="async"
          />
          <div class="variant-card__body">
            {variante.badge && <span class="variant-card__badge">{variante.badge}</span>}
            <h3>{variante.nombre}</h3>
            <p>{variante.desc}</p>
            <ul class="variant-card__specs" aria-label={`Especificaciones de ${variante.nombre}`}>
              {specs.map((spec) => <li>{spec}</li>)}
            </ul>
            <a class="btn btn--primary variant-card__cta" href={waUrl(variante.waText)}>
              Cotizar esta variante
            </a>
          </div>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .variants { margin-top: var(--space-10); }
  .variants__heading { max-width: 46rem; margin-bottom: var(--space-6); }
  .variants__eyebrow { margin: 0 0 var(--space-2); color: var(--color-primary); font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .variants__heading h2 { margin: 0 0 var(--space-3); font-family: var(--font-heading); font-size: var(--text-fluid-2xl); line-height: 1.15; }
  .variants__heading > p:last-child { color: var(--color-text-muted); }
  .variants__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-5); margin: 0; padding: 0; list-style: none; }
  .variant-card { display: flex; min-width: 0; flex-direction: column; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg); }
  .variant-card__image { width: 100%; aspect-ratio: 8 / 5; object-fit: contain; background: var(--color-surface); }
  .variant-card__body { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: var(--space-5); }
  .variant-card__badge { display: inline-block; margin-bottom: var(--space-2); padding: .2rem .55rem; border-radius: var(--radius-full); background: var(--color-accent); color: #fff; font-size: var(--text-xs); font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .variant-card h3 { margin: 0 0 var(--space-2); font-family: var(--font-heading); font-size: var(--text-lg); line-height: 1.3; }
  .variant-card p { margin: 0 0 var(--space-4); color: var(--color-text-muted); font-size: var(--text-sm); }
  .variant-card__specs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0 0 var(--space-5); padding: 0; list-style: none; }
  .variant-card__specs li { padding: .25rem .5rem; border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text-muted); font-size: var(--text-xs); }
  .variant-card__cta { width: 100%; margin-top: auto; text-align: center; }
</style>
