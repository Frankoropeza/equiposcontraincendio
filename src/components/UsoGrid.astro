---
// UsoGrid.astro — tarjetas de orientación por tipo de negocio.
// Contrato: recibe extUsos y el copy de extSecciones.negocio.
import SectionHeading from './SectionHeading.astro';

interface Row { uso: string; titulo: string; arde: string; recomendado: string; nota: string; }
interface Copy { eyebrow: string; title: string; titleAccent: string; desc: string; body: string[]; }
const { rows, copy } = Astro.props as { rows: Row[]; copy: Copy };
---

<section class="uso section" id="por-negocio">
  <div class="container">
    <SectionHeading layout="duo" {...copy} />
    <div class="card-grid uso__grid">
      {rows.map((row) => (
        <article class="uso__card">
          <h3>{row.titulo}</h3>
          <dl>
            <div><dt>Qué arde</dt><dd>{row.arde}</dd></div>
            <div><dt>Con qué arrancar</dt><dd>{row.recomendado}</dd></div>
          </dl>
          <p>{row.nota}</p>
          <a href={`?uso=${row.uso}#catalogo`}>Ver presentaciones <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .uso { background: var(--c-white); }
  .uso__grid { grid-template-columns: 1fr; }
  .uso__card { display: flex; flex-direction: column; height: 100%; padding: var(--sp-5); border: 1px solid var(--c-border); border-radius: var(--radius-lg); background: var(--c-surface); }
  .uso__card h3 { margin: 0 0 var(--sp-4); font-family: var(--font-heading); font-size: var(--text-lg); line-height: var(--leading-snug); }
  .uso__card dl { display: grid; gap: var(--sp-3); margin: 0; }
  .uso__card dt { color: var(--c-primary); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: .05em; text-transform: uppercase; }
  .uso__card dd { margin: .2rem 0 0; color: var(--c-ink-2); font-size: var(--text-sm); }
  .uso__card p { margin: var(--sp-4) 0; color: var(--c-muted); font-size: var(--text-xs); }
  .uso__card a { margin-top: auto; color: var(--c-primary); font-size: var(--text-sm); font-weight: var(--weight-semibold); text-decoration: none; }
  .uso__card a:hover { text-decoration: underline; }
  @media (min-width: 640px) { .uso__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .uso__grid { grid-template-columns: repeat(4, 1fr); } }
</style>
