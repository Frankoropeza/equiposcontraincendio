---
/**
 * Base de las tarjetas del catálogo. El slot conserva la estructura pública de
 * cada especialización; las reglas globales de este archivo son deliberadas:
 * así los wrappers pueden conservar sus clases públicas sin alterar el HTML
 * generado ni los hooks de ExtintorCatalog.
 */
interface Props {
  variant: 'category' | 'service' | 'product' | 'variant' | 'cierre' | 'extintor';
  as?: 'article' | 'a';
}
const { variant, as = 'article', class: className, ...attrs } = Astro.props;
const Tag = as;
---

<Tag {...attrs} class:list={[className, 'card', `card--${variant}`]}>
  <slot />
</Tag>

<style is:global>
  :is(.ccard, .scard, .pcard, .pvcard, .catalog-cierre, .ecard) {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-white);
  }

  :is(.ccard, .scard, .pvcard, .catalog-cierre, .ecard) {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  :is(.ccard__media, .scard__media, .pcard__media) {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--c-surface);
  }

  :is(.ccard__img, .scard__img, .pcard__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :is(.pvcard__image, .catalog-cierre__image, .ecard__image) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--c-surface);
  }

  :is(.pvcard__body, .catalog-cierre__body, .ecard__body) {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--sp-5);
  }

  :is(.ccard__overlay, .scard__overlay, .pcard__overlay) {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,.22) 100%);
  }

  :is(.ccard__badge, .scard__badge, .pcard__badge) {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    max-width: calc(100% - var(--sp-6));
    padding: .3em .65em;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--c-primary);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: .04em;
    text-transform: uppercase;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  :is(.ccard__body, .scard__body, .pcard__body) {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: var(--sp-5);
  }

  :is(.ccard__title, .scard__title, .pcard__title) {
    margin: 0 0 var(--sp-3);
    height: calc(var(--text-lg) * var(--leading-snug) * 2);
    overflow: hidden;
    color: var(--c-ink);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  :is(.ccard__desc, .scard__desc, .pcard__desc) {
    margin: 0 0 var(--sp-4);
    height: calc(var(--text-sm) * var(--leading-normal) * 3);
    overflow: hidden;
    color: var(--c-ink-2);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  :is(.ccard__cta, .scard__cta, .pcard__cta) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    width: 100%;
    min-height: 48px;
    padding: .6em 1em;
    border-radius: var(--radius-md);
    background: var(--c-primary);
    color: #fff;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: background-color var(--transition);
  }
</style>
