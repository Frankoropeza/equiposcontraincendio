---
// ============================================================================
// Pagination.astro — paginación del blog y de los archivos de categoría.
// ----------------------------------------------------------------------------
// CONTRATO DE URL (estrategia editorial 2026-09-09):
//   página 1 → <base>/            (p. ej. /blog/ o /blog/categoria/extintores/)
//   página N → <base>/pagina/N/
// La página 1 NUNCA vive en /pagina/1/: sería una URL duplicada del archivo.
//
// Todas las rutas llevan barra final (contrato trailingSlash: 'always'), y los
// enlaces son <a> reales —no JS— para que el rastreador siga la paginación.
// ============================================================================
interface Props {
  /** Página actual (1-based). */
  current: number
  /** Total de páginas. */
  total: number
  /** Ruta base con barra final: '/blog/' o '/blog/categoria/<slug>/'. */
  base: string
}
const { current, total, base } = Astro.props

/** URL de la página n bajo el contrato de arriba. */
const urlFor = (n: number) => (n <= 1 ? base : `${base}pagina/${n}/`)

// Ventana de números: primera, última, y las vecinas de la actual. Los saltos
// se marcan con puntos suspensivos para no imprimir 40 enlaces en un archivo
// grande (cada enlace reparte autoridad; una ventana la concentra donde sirve).
const window = new Set<number>([1, total, current - 1, current, current + 1])
const pages = [...window].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b)
const items: (number | '…')[] = []
pages.forEach((n, i) => {
  if (i > 0 && n - pages[i - 1] > 1) items.push('…')
  items.push(n)
})
---

{total > 1 && (
  <nav class="pg" aria-label="Paginación del blog">
    {current > 1 ? (
      <a class="pg__step" href={urlFor(current - 1)} rel="prev">← Anterior</a>
    ) : (
      <span class="pg__step is-off" aria-hidden="true">← Anterior</span>
    )}

    <ol class="pg__list" role="list">
      {items.map((it) =>
        it === '…' ? (
          <li class="pg__gap" aria-hidden="true">…</li>
        ) : (
          <li>
            {it === current ? (
              <span class="pg__n is-current" aria-current="page">{it}</span>
            ) : (
              <a class="pg__n" href={urlFor(it)}>{it}</a>
            )}
          </li>
        ),
      )}
    </ol>

    {current < total ? (
      <a class="pg__step" href={urlFor(current + 1)} rel="next">Siguiente →</a>
    ) : (
      <span class="pg__step is-off" aria-hidden="true">Siguiente →</span>
    )}
  </nav>
)}

<style>
  .pg {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    margin-top: var(--sp-8);
  }

  .pg__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pg__n,
  .pg__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 var(--sp-3);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md, 8px);
    text-decoration: none;
    color: var(--c-ink-2);
    font-size: var(--text-sm);
  }

  .pg__n:hover,
  .pg__step:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .pg__n.is-current {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: #fff;
    font-weight: 600;
  }

  .pg__step.is-off {
    opacity: .4;
  }

  .pg__step.is-off:hover {
    border-color: var(--c-border);
    color: var(--c-ink-2);
  }

  .pg__gap {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--sp-1);
    color: var(--c-muted);
  }
</style>
