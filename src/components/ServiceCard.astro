---
// ============================================================================
// ServiceCard.astro — Tarjeta de servicio.
// ----------------------------------------------------------------------------
// ORIGEN: PROYECTORED .ccard de CatalogoServicios + ServiceCard de MESASPICNIC.
// Si href apunta a WhatsApp, construye el href con waUrl(WA_MESSAGES.x) desde
// config y pasa whatsapp={true}. NUNCA un número hardcodeado.
//
// REDISEÑO 2026-09-10 — CONTRATO DE TARJETA COMPARTIDO
// Las tres tarjetas del sitio (CategoryCard, ServiceCard, ProductCard) usan
// ahora la MISMA geometría, para que un grid mixto no se vea desalineado:
//   • media 16/10 con badge arriba a la izquierda;
//   • título de ALTURA FIJA de 2 líneas (`height`, no `min-height`: un glifo
//     como el subíndice de «CO₂» agranda la caja de línea y descuadraba la fila);
//   • descripción de ALTURA FIJA de 3 líneas, recortada con line-clamp — el
//     texto completo sigue en el DOM para SEO, solo se limita lo visible;
//   • CTA sólido a ancho completo anclado al fondo, con el texto en `nowrap`
//     (un CTA que parte en dos líneas estira TODA su fila del grid).
// AMPLIACIÓN 2026-09-10 — FICHA Y HOMOLOGACIÓN
//   • `specs` opcional: filas «dato · valor» de 44 px con hairline, la misma
//     geometría del índice de subcategorías de CategoryCard. Se ancla al fondo
//     (margin-top:auto) para que las filas y el CTA coincidan en toda la fila.
//   • Imagen y título enlazan al mismo destino que el CTA, como CategoryCard.
//   • Cards estáticas; solo los botones tienen transición (regla 2026-09-10).
// Antes el CTA era un enlace de texto suelto y la descripción crecía libre, así
// que cada tarjeta cerraba a una altura distinta y dejaba huecos irregulares.
interface Props {
  title: string
  description: string
  href: string
  /** SVG inline (string) para el ícono. Opcional. */
  icon?: string
  /** Imagen de cabecera. Si se pasa, reemplaza al ícono superior. */
  image?: string
  imageAlt?: string
  badge?: string
  ctaLabel?: string
  /** true → CTA estilo WhatsApp (verde) + target _blank. */
  whatsapp?: boolean
  specs?: { label: string; value: string }[]
}
const { title, description, href, icon, image, imageAlt, badge, ctaLabel = 'Servicios contra incendio', whatsapp = false, specs = [] } = Astro.props
const external = whatsapp || href.startsWith('http')
---

<article class="scard" aria-label={title}>
  {image ? (
    <a class="scard__media-link" href={href} tabindex="-1" aria-hidden="true" target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
      <div class="scard__media">
        <img src={image} alt={imageAlt ?? title} width="640" height="360" loading="lazy" decoding="async" class="scard__img" />
        <span class="scard__overlay" aria-hidden="true"></span>
        {badge && <span class="scard__badge">{badge}</span>}
      </div>
    </a>
  ) : icon ? (
    <div class="scard__icon" aria-hidden="true"><Fragment set:html={icon} /></div>
  ) : null}

  <div class="scard__body">
    {badge && !image && <span class="scard__badge scard__badge--inline">{badge}</span>}
    <h3 class="scard__title"><a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{title}</a></h3>
    <p class="scard__desc">{description}</p>
    {specs.length > 0 && (
      <dl class="scard__specs">
        {specs.map((spec) => (
          <div class="scard__spec"><dt>{spec.label}</dt><dd>{spec.value}</dd></div>
        ))}
      </dl>
    )}
    <a
      href={href}
      class:list={['scard__cta', whatsapp && 'scard__cta--wa', specs.length > 0 && 'scard__cta--with-specs']}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      {whatsapp && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>}
      <span>{ctaLabel}</span>
      {!whatsapp && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>}
    </a>
  </div>
</article>

<style>
  /* Card ESTÁTICA: sin animaciones de entrada (regla de motion del sitio). */
  /* Cards estáticas; solo los botones tienen transición (regla 2026-09-10). */
  .scard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* ── Media: 16/10, igual que CategoryCard y ProductCard ── */
  .scard__media-link {
    display: block;
  }

  .scard__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--c-surface);
  }

  .scard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scard__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,.22) 100%);
  }

  .scard__badge {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    max-width: calc(100% - var(--sp-6));
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #fff;
    background: var(--c-primary);
    padding: .3em .65em;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .scard__badge--inline {
    position: static;
    align-self: flex-start;
    max-width: 100%;
    margin-bottom: var(--sp-3);
  }

  .scard__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin: var(--sp-5) var(--sp-5) 0;
    border-radius: var(--radius-lg);
    background: rgba(198, 40, 40, .10);
    color: var(--c-primary);
  }

  /* ── Cuerpo: zonas de altura reservada ── */
  .scard__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: var(--sp-5);
  }

  .scard__title {
    margin: 0 0 var(--sp-3);
    height: calc(var(--text-lg) * var(--leading-snug) * 2);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--c-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .scard__title a {
    color: inherit;
    text-decoration: none;
  }

  .scard__title a:hover {
    color: var(--c-primary);
  }

  .scard__title a:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .scard__desc {
    margin: 0 0 var(--sp-4);
    height: calc(var(--text-sm) * var(--leading-normal) * 3);
    font-size: var(--text-sm);
    color: var(--c-ink-2);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .scard__specs {
    margin: auto 0 0;
    padding: 0;
    border-top: 1px solid var(--c-border);
  }

  .scard__spec {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    min-height: 44px;
    border-bottom: 1px solid var(--c-border);
  }

  .scard__spec dt {
    flex: none;
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  .scard__spec dd {
    min-width: 0;
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--c-ink);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── CTA: sólido, ancho completo, anclado al fondo ── */
  .scard__cta {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    width: 100%;
    min-height: 48px;
    padding: .6em 1em;
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    color: #fff;
    text-decoration: none;
    background: var(--c-primary);
    border-radius: var(--radius-md);
    transition: background-color var(--transition);
  }

  .scard__cta--with-specs {
    margin-top: var(--sp-4);
  }

  .scard__cta > span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .scard__cta:hover {
    background: var(--c-primary-dark);
  }

  .scard__cta:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }

  .scard__cta--wa {
    background: var(--c-whatsapp);
  }

  .scard__cta--wa:hover {
    background: var(--c-whatsapp-dark);
  }

  .scard__cta--wa:focus-visible {
    outline-color: var(--c-whatsapp);
  }
</style>
