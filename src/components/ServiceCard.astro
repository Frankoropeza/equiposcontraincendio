---
// ============================================================================
// ServiceCard.astro — Tarjeta de servicio.
// ----------------------------------------------------------------------------
// ORIGEN: PROYECTORED .ccard de CatalogoServicios + ServiceCard de MESASPICNIC.
// Si href apunta a WhatsApp, construye el href con waUrl(WA_MESSAGES.x) desde
// config y pasa whatsapp={true}. NUNCA un número hardcodeado.
//
import { srcsetFor } from '@lib/img'
import Icon from '@components/Icon.astro'
import Card from './Card.astro'
// REDISEÑO 2026-09-10 — CONTRATO DE TARJETA COMPARTIDO
// Las tres tarjetas del sitio (CategoryCard, ServiceCard, ProductCard) usan
// ahora la MISMA geometría, para que un grid mixto no se vea desalineado:
//   • media 16/10 con badge arriba a la izquierda;
//   • título de ALTURA FIJA de 2 líneas (`height`, no `min-height`: un glifo
//     como el subíndice de «CO₂» agranda la caja de línea y descuadraba la fila);
//   • descripción de ALTURA FIJA de 3 líneas, recortada con line-clamp — el
//     texto completo sigue en el DOM para SEO, solo se limita lo visible;
//   • CTA sólido a ancho completo anclado al fondo, con el texto en `nowrap`
//     (un CTA que parte en dos líneas estira TODA su fila del grid).
// AMPLIACIÓN 2026-09-10 — FICHA Y HOMOLOGACIÓN
//   • `specs` opcional: filas «dato · valor» de 44 px con hairline, la misma
//     geometría del índice de subcategorías de CategoryCard. Se ancla al fondo
//     (margin-top:auto) para que las filas y el CTA coincidan en toda la fila.
//   • Imagen y título enlazan al mismo destino que el CTA, como CategoryCard.
//   • Cards estáticas; solo los botones tienen transición (regla 2026-09-10).
// Antes el CTA era un enlace de texto suelto y la descripción crecía libre, así
// que cada tarjeta cerraba a una altura distinta y dejaba huecos irregulares.
interface Props {
  title: string
  description: string
  href: string
  /** SVG inline (string) para el ícono. Opcional. */
  icon?: string
  /** Imagen de cabecera. Si se pasa, reemplaza al ícono superior. */
  image?: string
  imageAlt?: string
  badge?: string
  ctaLabel?: string
  /** true → CTA estilo WhatsApp (verde) + target _blank. */
  whatsapp?: boolean
  specs?: { label: string; value: string }[]
}
const { title, description, href, icon, image, imageAlt, badge, ctaLabel = 'Servicios contra incendio', whatsapp = false, specs = [] } = Astro.props
const external = whatsapp || href.startsWith('http')
---

<Card variant="service" class="scard" aria-label={title}>
  {image ? (
    <a class="scard__media-link" href={href} tabindex="-1" aria-hidden="true" target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
      <div class="scard__media">
        <img src={image} alt={imageAlt ?? title} width="640" height="360" loading="lazy" decoding="async" srcset={srcsetFor(image)} sizes="(min-width: 1280px) 300px, (min-width: 768px) 45vw, 100vw" class="scard__img" />
        <span class="scard__overlay" aria-hidden="true"></span>
        {badge && <span class="scard__badge">{badge}</span>}
      </div>
    </a>
  ) : icon ? (
    <div class="scard__icon" aria-hidden="true"><Fragment set:html={icon} /></div>
  ) : null}

  <div class="scard__body">
    {badge && !image && <span class="scard__badge scard__badge--inline">{badge}</span>}
    <h3 class="scard__title"><a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{title}</a></h3>
    <p class="scard__desc">{description}</p>
    {specs.length > 0 && (
      <dl class="scard__specs">
        {specs.map((spec) => (
          <div class="scard__spec"><dt>{spec.label}</dt><dd>{spec.value}</dd></div>
        ))}
      </dl>
    )}
    <a
      href={href}
      class:list={['scard__cta', whatsapp && 'scard__cta--wa', specs.length > 0 && 'scard__cta--with-specs']}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      {whatsapp && <Icon name="wa" size={16} />}
      <span>{ctaLabel}</span>
      {!whatsapp && <Icon name="arrow" size={14} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />}
    </a>
  </div>
</Card>

<style>
  /* Card ESTÁTICA: sin animaciones de entrada (regla de motion del sitio). */
  /* Cards estáticas; solo los botones tienen transición (regla 2026-09-10). */
  /* ── Media: 16/10, igual que CategoryCard y ProductCard ── */
  .scard__media-link {
    display: block;
  }

  .scard__badge--inline {
    position: static;
    align-self: flex-start;
    max-width: 100%;
    margin-bottom: var(--sp-3);
  }

  .scard__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin: var(--sp-5) var(--sp-5) 0;
    border-radius: var(--radius-lg);
    background: rgba(198, 40, 40, .10);
    color: var(--c-primary);
  }

  /* ── Cuerpo: zonas de altura reservada ── */
  .scard__title a {
    color: inherit;
    text-decoration: none;
  }

  .scard__title a:hover {
    color: var(--c-primary);
  }

  .scard__title a:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .scard__specs {
    margin: auto 0 0;
    padding: 0;
    border-top: 1px solid var(--c-border);
  }

  .scard__spec {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    min-height: 44px;
    border-bottom: 1px solid var(--c-border);
  }

  .scard__spec dt {
    flex: none;
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  .scard__spec dd {
    min-width: 0;
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--c-ink);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── CTA: sólido, ancho completo, anclado al fondo ── */
  .scard__cta {
    margin-top: auto;
  }

  .scard__cta--with-specs {
    margin-top: var(--sp-4);
  }

  .scard__cta > span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .scard__cta:hover {
    background: var(--c-primary-dark);
  }

  .scard__cta:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }

  .scard__cta--wa {
    background: var(--c-whatsapp-aa);
  }

  .scard__cta--wa:hover {
    background: var(--c-whatsapp-aa-dark);
  }

  .scard__cta--wa:focus-visible {
    outline-color: var(--c-whatsapp);
  }
</style>
