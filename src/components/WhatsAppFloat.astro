---
// WhatsAppFloat.astro — Botón flotante fijo de WhatsApp (verde #25D366), global en el layout. ORIGEN: PROYECTORED/src/components/global/WhatsAppButton.astro (lee waUrl + WA_MESSAGES, etiqueta colapsable en móvil).
// Contrato: usa waUrl() y WA_MESSAGES desde config/site. NUNCA número hardcodeado (anti-patrón BRINCOLINS/MESASPICNIC: wa.me hardcoded ×6).
import Icon from '@components/Icon.astro'
import { waUrl, WA_MESSAGES } from '@config/site'

interface Props {
  /** Clave de WA_MESSAGES a usar (default 'default'). */
  message?: keyof typeof WA_MESSAGES
  /** Texto de la etiqueta visible junto al ícono. */
  label?: string
}
const { message = ('default' in WA_MESSAGES ? 'default' : Object.keys(WA_MESSAGES)[0]) as keyof typeof WA_MESSAGES, label = '¿Necesitas ayuda?' } = Astro.props
const href = waUrl(WA_MESSAGES[message])
---

<a href={href} class="wa-float" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp" title={label}>
  <Icon name="wa" size={26} />
  <span class="wa-float__label">{label}</span>
</a>

<style>
  .wa-float {
    position: fixed;
    bottom: var(--sp-6, 1.5rem);
    right: var(--sp-6, 1.5rem);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: var(--sp-2, .5rem);
    padding: var(--sp-3, .75rem) var(--sp-4, 1rem);
    background: var(--c-whatsapp-aa);
    color: #fff;
    border-radius: var(--radius-full, 9999px);
    box-shadow: 0 4px 16px rgba(var(--c-whatsapp-rgb), .4);
    font-size: var(--text-sm, .875rem);
    font-weight: var(--weight-semibold, 600);
    text-decoration: none;
    /* respeta el notch / barra inferior iOS */
    margin-bottom: env(safe-area-inset-bottom, 0px);
  }

  .wa-float:hover {
    box-shadow: 0 6px 20px rgba(var(--c-whatsapp-rgb), .5);
  }

  .wa-float:focus-visible {
    outline: 3px solid rgba(var(--c-whatsapp-rgb), .5);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .wa-float__label {
      display: none;
    }

    .wa-float {
      padding: var(--sp-3, .75rem);
    }
  }
</style>
