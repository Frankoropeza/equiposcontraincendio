---
// ============================================================================
// CompanyAbout.astro — Módulo "Sobre la empresa": quién está detrás del negocio.
// ----------------------------------------------------------------------------
// QUÉ ES
// Bloque de confianza, de los más indispensables de un sitio: dice QUÉ hace el
// negocio, CÓMO lo hace y por qué se puede confiar en él. Apoya marketing
// (propuesta de valor + prueba social) y la confianza/experiencia que pesan en
// el posicionamiento (es el hogar natural del schema de Organización).
//
// DISTRIBUCIÓN. El TÍTULO de la sección va APARTE con el complemento
// SectionHeading layout="duo" (regla del sistema: todos los títulos en duo).
// Este componente es el CUERPO, de arriba a abajo:
//   1. Dos columnas  → "Qué hacemos" (párrafos) · "Cómo lo hacemos" (pilares).
//   2. Cifras        → tira de señales de confianza (números reales del negocio).
//   3. CTA           → una sola acción principal.
//
// Reutilizable y data-driven: la página pasa el contenido (no hay datos
// hardcodeados). Mobile-first; en móvil las columnas se apilan.
// 2026-09-17: se retiró la tira de cifras (stats) por decisión de Frank.
//
// PROPS
//   que   → { title, body: string[] }                "Qué hacemos".
//   como  → { title, pillars: {title,desc}[] }        "Cómo lo hacemos".
//   cta   → { label, href, external? }                acción principal.
//
// ESTILO: tokens de src/styles/tokens.css. A11y: encabezados jerárquicos, listas
// reales, foco visible.
// ============================================================================
export type Pillar = { title: string; desc: string };
interface Props {
  que: { title: string; body: string[] };
  como: { title: string; pillars: Pillar[] };
  cta?: { label: string; href: string; external?: boolean };
}
const { que, como, cta } = Astro.props;
---

<div class="company">
  <div class="company__cols">
    <section class="company__card">
      <h3 class="company__sub">{que.title}</h3>
      {que.body.map((p: string) => <p class="company__p">{p}</p>)}
    </section>

    <section class="company__card company__card--como">
      <h3 class="company__sub">{como.title}</h3>
      <ul class="company__pillars" role="list">
        {como.pillars.map((p: Pillar) => (
          <li class="company__pillar">
            <div class="company__pillar-body">
              <p class="company__pillar-title">{p.title}</p>
              <p class="company__pillar-desc">{p.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>


  {cta && (
    <a
      class="company__cta"
      href={cta.href}
      target={cta.external ? '_blank' : undefined}
      rel={cta.external ? 'noopener noreferrer' : undefined}
    >
      {cta.label}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  )}
</div>

<style>
  .company {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  /* ── Dos columnas: Qué / Cómo ── */
  .company__cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
  }

  .company__card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .company__card--como {
    background: var(--c-white);
  }

  .company__sub {
    margin: 0 0 var(--sp-1);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--c-ink);
  }

  .company__p {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--c-ink-2);
  }

  /* ── Pilares (Cómo lo hacemos) ── */
  .company__pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .company__pillar { display: block; }

  .company__pillar-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .company__pillar-title {
    margin: 0;
    font-weight: var(--weight-semibold);
    color: var(--c-ink);
  }

  .company__pillar-desc {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--c-muted);
  }

  /* ── Cifras de confianza ── */




  /* ── CTA ── */
  .company__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: .7em 1.2em;
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    color: #fff;
    text-decoration: none;
    background: var(--c-primary);
    border-radius: var(--radius-md);
    transition: background-color var(--transition);
  }

  .company__cta:hover {
    background: var(--c-primary-dark);
  }

  .company__cta:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }

  /* ── Escritorio ── */
  @media (min-width: 768px) {
    .company__cols {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-6);
    }



  }
</style>
