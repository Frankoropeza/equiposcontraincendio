---
import { srcsetFor } from '@lib/img';

export interface Paso {
  /** Nombre breve del paso. */
  titulo: string;
  /** Instrucción o explicación del paso. */
  detalle: string;
  /** Ruta local opcional de una imagen ubicada en /images/. */
  imagen?: string;
  /** Texto alternativo de la imagen del paso. */
  imagenAlt?: string;
}

/**
 * Procedimiento ordenado para incrustar dentro de contenido MDX.
 */
export interface Props {
  /** Pasos que forman el procedimiento, en el orden en que deben realizarse. */
  pasos: Paso[];
  /** Nombre visible del procedimiento. */
  titulo?: string;
}

const { pasos, titulo } = Astro.props;
---

<section class="pasos" aria-labelledby={titulo ? 'pasos-titulo' : undefined}>
  {titulo && <h2 id="pasos-titulo" class="pasos__t">{titulo}</h2>}
  <ol class="pasos__lista">
    {pasos.map((paso, index) => (
      <li class="pasos__item">
        <span class="pasos__numero" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="pasos__contenido">
          <h3 class="pasos__nombre">{paso.titulo}</h3>
          <p class="pasos__detalle">{paso.detalle}</p>
          {paso.imagen?.startsWith('/images/') && (
            <img
              class="pasos__imagen"
              src={paso.imagen}
              alt={paso.imagenAlt ?? ''}
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
              srcset={srcsetFor(paso.imagen)}
            />
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .pasos { margin-block: var(--space-8); }
  .pasos__t { margin: 0 0 var(--space-5); color: var(--c-ink); font-family: var(--font-heading); font-size: var(--text-fluid-3xl); }
  .pasos__lista { display: grid; gap: var(--space-5); margin: 0; padding: 0; list-style: none; }
  .pasos__item { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-4); padding-bottom: var(--space-5); border-bottom: 1px solid var(--c-border); }
  .pasos__numero { color: var(--c-primary); font-family: var(--font-heading); font-size: var(--text-fluid-4xl); font-weight: var(--weight-bold); line-height: 1; }
  .pasos__nombre { margin: 0; color: var(--c-ink); font-family: var(--font-heading); font-size: var(--text-xl); }
  .pasos__detalle { margin: var(--space-2) 0 0; color: var(--c-ink-2); line-height: var(--leading-relaxed); }
  .pasos__imagen { display: block; width: 100%; height: auto; margin-top: var(--space-4); border-radius: var(--radius-md); }
</style>
