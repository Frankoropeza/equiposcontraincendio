---
// ============================================================================
// CategoryCard.astro — Tarjeta de categoría para la vitrina de la home.
// ----------------------------------------------------------------------------
// QUÉ ES
// Tarjeta "categoría como producto" al estilo de catálogos B2B profesionales:
// imagen + etiqueta normativa + título + texto de venta + índice de
// SUBCATEGORÍAS + CTA. Pensada para un grid de 4 por fila.
//
// REDISEÑO 2026-09-10 — SIMETRÍA (por qué está armada así):
//   El diseño anterior pintaba las subcategorías como chips de 44 px con
//   `flex-wrap`, así que cada tarjeta cerraba con 1, 2 o 3 filas distintas
//   según el largo de las etiquetas. Eso desalineaba el CTA y dejaba huecos
//   muertos. Ahora el cuerpo es una RETÍCULA DETERMINISTA de cuatro zonas de
//   altura reservada, idéntica en las 8 tarjetas:
//     1. Título    → `min-height` de 2 líneas + clamp a 2 (nunca desborda).
//     2. Descripción → `min-height` de 3 líneas + clamp a 3.
//     3. Índice de subcategorías → filas de 44 px, UNA por subcategoría, con
//        hairline entre ellas y chevron a la derecha. Sin wrap: la etiqueta
//        trunca con elipsis antes que romper la simetría.
//     4. CTA → ancho completo, anclado al fondo (`margin-top:auto`), de modo
//        que el borde derecho del botón coincide en todas las tarjetas.
//   Regla de contenido que acompaña al componente: 3 subcategorías por
//   tarjeta y blurbs de 110–125 caracteres (ver SHOWCASE en config/site.ts).
//
// MARKETING + SEO:
//   • <article> con <h3>  → jerarquía correcta (H1 hero → H2 sección → H3 card).
//   • imagen con `alt` descriptivo + width/height fijos → SEO e imagen sin CLS.
//   • subcategorías = enlaces con ANCHOR TEXT real → reparten autoridad a las
//     fichas de producto y dan al usuario el atajo exacto.
//   • un solo CTA por tarjeta, con palabra clave y SIN el verbo "ver".
//
// DATA-DRIVEN: la página le pasa cada objeto de `SHOWCASE` (config/site.ts).
//
// PROPS
//   label          → título de la tarjeta (H3).  [requerido]
//   href           → destino del título y del CTA (landing de la categoría).
//   image, imageAlt→ imagen de cabecera + texto alternativo descriptivo.
//   badge          → etiqueta corta sobre la imagen (norma, certificación…).
//   blurb          → texto de venta (110–125 caracteres ≈ 3 líneas).
//   subcategories  → [{ label, href }] enlaces hijos (idealmente 3).
//   ctaLabel       → texto del botón principal (default "Catálogo completo").
//   index          → posición en el grid; los primeros cargan la imagen `eager`.
//   priority       → marca el recurso LCP y añade `fetchpriority="high"`.
//   disabled       → tarjeta sin enlace (módulo "próximo").
//
// ESTILO: tokens de src/styles/tokens.css. A11y: filas de 44 px, foco visible.
// ============================================================================
export type Sub = { label: string; href: string };
interface Props {
  label: string;
  href: string;
  image?: string;
  imageAlt?: string;
  badge?: string;
  blurb?: string;
  subcategories?: readonly Sub[];
  ctaLabel?: string;
  index?: number;
  priority?: boolean;
  disabled?: boolean;
}
const {
  label,
  href,
  image,
  imageAlt,
  badge,
  blurb,
  subcategories = [],
  ctaLabel = "Equipos contra incendios",
  index = 99,
  priority = false,
  disabled = false,
} = Astro.props;
const eager = priority || index < 4;
// 'disabled' (p. ej. módulo 'próximo'): ni la imagen ni las filas enlazan.
const MediaTag = disabled ? "div" : "a";
const RowTag = disabled ? "span" : "a";
---

<article class="ccard">
  {image && (
    <MediaTag class="ccard__media-link" href={disabled ? undefined : href} tabindex={disabled ? undefined : "-1"} aria-hidden="true">
      <div class="ccard__media">
        <img
          src={image}
          alt={imageAlt ?? label}
          width="640" height="400"
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={priority ? "high" : undefined}
          class="ccard__img"
        />
        <span class="ccard__overlay" aria-hidden="true"></span>
        {badge && <span class="ccard__badge">{badge}</span>}
      </div>
    </MediaTag>
  )}

  <div class="ccard__body">
    {badge && !image && (
      <span class:list={["ccard__badge", "ccard__badge--inline", { "ccard__badge--soon": disabled }]}>{badge}</span>
    )}

    <h3 class="ccard__title">
      {disabled ? <span>{label}</span> : <a href={href}>{label}</a>}
    </h3>

    {blurb && <p class="ccard__desc">{blurb}</p>}

    {subcategories.length > 0 && (
      <ul class="ccard__subs" role="list" aria-label={`Subcategorías de ${label}`}>
        {subcategories.map((s) => (
          <li class="ccard__subs-item">
            <RowTag class="ccard__sub" href={disabled ? undefined : s.href}>
              <span class="ccard__sub-label">{s.label}</span>
              <svg class="ccard__sub-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </RowTag>
          </li>
        ))}
      </ul>
    )}

    {disabled ? (
      <span class="ccard__cta ccard__cta--soon">Próximamente</span>
    ) : (
      <a class="ccard__cta" href={href}>
        <span>{ctaLabel}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    )}
  </div>
</article>

<style>
  /* Cards estáticas; solo los botones tienen transición (regla 2026-09-10). */
  .ccard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* ── Imagen de cabecera ─────────────────────────────────────────────── */
  .ccard__media-link {
    display: block;
  }

  .ccard__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--c-surface);
  }

  .ccard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ccard__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,.22) 100%);
  }

  .ccard__badge {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    max-width: calc(100% - var(--sp-6));
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #fff;
    background: var(--c-primary);
    padding: .3em .65em;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ccard__badge--inline {
    position: static;
    align-self: flex-start;
    max-width: 100%;
    margin-bottom: var(--sp-3);
  }

  .ccard__badge--soon {
    color: var(--c-muted);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
  }

  /* ── Cuerpo: retícula de 4 zonas con altura reservada ───────────────── */
  .ccard__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: var(--sp-5);
  }

  /* Zona 1 — Título: siempre ocupa 2 líneas, aunque el texto use una. */
  .ccard__title {
    margin: 0 0 var(--sp-3);
    height: calc(var(--text-lg) * var(--leading-snug) * 2);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--c-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ccard__title a {
    color: inherit;
    text-decoration: none;
  }

  .ccard__title a:hover {
    color: var(--c-primary);
  }

  .ccard__title a:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* Zona 2 — Descripción: siempre ocupa 3 líneas.
  ALTURA FIJA, no min-height: un carácter como el subíndice de «CO₂» agranda
  la caja de línea y hacía que las tarjetas con ese glifo midieran ~11 px más
  que el resto, desalineando el índice y el CTA de toda la fila. */
  .ccard__desc {
    margin: 0 0 var(--sp-4);
    height: calc(var(--text-sm) * var(--leading-normal) * 3);
    font-size: var(--text-sm);
    color: var(--c-ink-2);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Zona 3 — Índice de subcategorías: una fila de 44 px por entrada.
  Anclado con margin-top:auto para que el bloque inferior quede alineado
  entre tarjetas aunque una descripción sea más corta. */
  .ccard__subs {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    border-top: 1px solid var(--c-border);
  }

  .ccard__subs-item {
    border-bottom: 1px solid var(--c-border);
  }

  .ccard__sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--c-ink-2);
    text-decoration: none;
  }

  .ccard__sub-label {
    /* Sin wrap: la elipsis protege la simetría de la retícula. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ccard__sub-icon {
    flex: none;
    color: var(--c-muted);
  }

  .ccard__sub:hover,
  .ccard__sub:focus-visible {
    color: var(--c-primary);
    outline: none;
  }

  .ccard__sub:hover .ccard__sub-icon,
  .ccard__sub:focus-visible .ccard__sub-icon {
    color: var(--c-primary);
  }

  .ccard__sub:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: -2px;
  }

  /* Zona 4 — CTA: ancho completo → borde derecho alineado en todo el grid. */
  .ccard__cta {
    margin-top: var(--sp-4);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    width: 100%;
    min-height: 48px;
    padding: .6em 1em;
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    color: #fff;
    text-align: center;
    text-decoration: none;
    background: var(--c-primary);
    border-radius: var(--radius-md);
    transition: background-color var(--transition);
  }

  /* El texto del CTA nunca parte en dos líneas: si lo hiciera, estiraría la
  tarjeta y con ella TODA su fila del grid (las filas de CSS grid se
  igualan a la más alta). Tope de contenido: 26 caracteres. */
  .ccard__cta > span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ccard__cta:hover {
    background: var(--c-primary-dark);
  }

  .ccard__cta:focus-visible {
    outline: 2px solid var(--c-primary);
    outline-offset: 2px;
  }

  .ccard__cta--soon {
    background: var(--c-surface);
    color: var(--c-muted);
    border: 1px solid var(--c-border);
    cursor: default;
  }

  .ccard__cta--soon:hover {
    background: var(--c-surface);
  }
</style>
