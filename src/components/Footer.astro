---
import {
  SITE,
  COMPANY,
  CONTACT,
  BRANCHES,
  SOCIAL,
  LEGAL,
  FOOTER_NAV,
  navHref,
  waUrl,
  telUrl,
  WA_MESSAGES,
} from '@config/site'
import EmailLink from '@components/EmailLink.astro'
import Icon from '@components/Icon.astro'

interface Cert {
  label: string
  title?: string
}

interface Branch {
  label: string
  address: string
  mapsUrl?: string
}

interface Props {
  certifications?: Cert[]
  branches?: Branch[]
  seoTagline?: string
}

const cfgBranches: Branch[] = BRANCHES ?? []
const {
  certifications = [],
  branches = cfgBranches,
  seoTagline = SITE.tagline,
} = Astro.props

const currentYear = new Date().getFullYear()
const waDefault = waUrl(WA_MESSAGES.cotizacion)
const telLink = telUrl()
const schedule = CONTACT.schedule


const SOCIAL_ICONS: Record<string, string> = {
  instagram: '<path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.67.07-4.95c.06-1.27.26-2.15.56-2.91.3-.8.72-1.47 1.38-2.13.66-.66 1.33-1.08 2.12-1.38.76-.3 1.64-.5 2.91-.56C8.33.01 8.74 0 12 0s3.67.01 4.95.07c1.27.06 2.15.26 2.91.56.8.3 1.47.72 2.13 1.38.66.66 1.08 1.33 1.38 2.13.3.76.5 1.64.56 2.91.06 1.28.07 1.69.07 4.95s-.01 3.67-.07 4.95c-.06 1.27-.26 2.15-.56 2.91a5.9 5.9 0 0 1-1.38 2.13 5.9 5.9 0 0 1-2.13 1.38c-.76.3-1.64.5-2.91.56C15.67 23.99 15.26 24 12 24s-3.67-.01-4.95-.07c-1.27-.06-2.15-.26-2.91-.56a5.9 5.9 0 0 1-2.13-1.38 5.9 5.9 0 0 1-1.38-2.13c-.3-.76-.5-1.64-.56-2.91C.01 15.67 0 15.26 0 12s.01-3.67.07-4.95c.06-1.27.26-2.15.56-2.91.3-.8.72-1.47 1.38-2.13.66-.66 1.33-1.08 2.12-1.38C4.9.33 5.78.13 7.05.07 8.33.01 8.74 0 12 0Zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84ZM12 16a4 4 0 1 1 4-4 4 4 0 0 1-4 4Zm6.41-10.85a1.44 1.44 0 1 0 1.44 1.44 1.44 0 0 0-1.44-1.44Z"/>',
  facebook: '<path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z"/>',
  linkedin: '<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>',
  youtube: '<path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81ZM9.6 15.6V8.4l6.27 3.6L9.6 15.6Z"/>',
  x: '<path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.6l5.24 6.93 6.06-6.93Zm-1.29 19.5h2.04L6.48 3.24H4.3L17.61 20.65Z"/>',
  tiktok: '<path d="M16.6 0h-3.3v13.34a2.4 2.4 0 1 1-2.4-2.4c.13 0 .26.02.39.04V7.6a6.1 6.1 0 0 0-.39-.01 5.74 5.74 0 1 0 5.74 5.74V6.7a7.3 7.3 0 0 0 4.27 1.37V4.77a4.27 4.27 0 0 1-4.27-4.27c0-.17 0-.34.02-.5H16.6Z"/>',
}
---

<footer class="footer" role="contentinfo" aria-label="Pie de página">
  <section class="footer__cta" aria-label="Solicitar cotización">
    <div class="footer__cta-inner">
      <div class="footer__cta-copy">
        <p class="footer__eyebrow">Cotización sin compromiso</p>
        <h2>Cuéntanos tu proyecto y te decimos qué equipo necesitas.</h2>
        <p>Escríbenos por WhatsApp o llámanos: {CONTACT.hours.display}.</p>
      </div>
      <div class="footer__cta-actions">
        <a href={waDefault} class="footer__button footer__button--primary" target="_blank" rel="noopener noreferrer"><Icon name="wa" size={16} /> Cotizar por WhatsApp</a>
        <a href={telLink} class="footer__button footer__button--outline"><Icon name="phone" size={16} /> Llamar al {CONTACT.phone}</a>
      </div>
    </div>
  </section>

  <div class="footer__body">
    <div class="footer__identity-grid">
      <section class="footer__cell footer__brand-cell" aria-label={SITE.name}>
        <a href="/" class="footer__logo">
          <span class="footer__logo-mark" aria-hidden="true">{SITE.brand.charAt(0)}</span>
          <span class="footer__logo-lockup">
            <span class="footer__logo-word">{SITE.brand}</span>
            <span class="footer__logo-descriptor">Contra incendios</span>
          </span>
          <span class="sr-only">, ir al inicio</span>
        </a>
        <p class="footer__summary">{COMPANY.summary}</p>
        <div class="footer__chips" aria-label="Información de la empresa">
          <span>{COMPANY.experience.label}</span>
          <span>{COMPANY.coverageShort}</span>
        </div>
        {branches.length > 0 && (
          <div class="footer__branches" aria-label="Sucursales">
            {branches.map((branch) => branch.mapsUrl ? (
              <a href={branch.mapsUrl} target="_blank" rel="noopener noreferrer"><strong>{branch.label}</strong><small>{branch.address}</small></a>
            ) : (
              <span class="footer__branch"><strong>{branch.label}</strong><small>{branch.address}</small></span>
            ))}
          </div>
        )}
        {SOCIAL.length > 0 && (
          <div class="footer__social" aria-label="Redes sociales">
            {SOCIAL.map((social) => (
              <a href={social.url} target="_blank" rel="noopener noreferrer me" aria-label={social.label} title={social.label}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <Fragment set:html={SOCIAL_ICONS[social.network] ?? ''} />
                </svg>
              </a>
            ))}
          </div>
        )}
      </section>

      <section class="footer__cell" aria-labelledby="footer-phone-title">
        <h2 id="footer-phone-title" class="footer__cell-title">Teléfono y WhatsApp</h2>
        <a href={telLink} class="footer__phone">{CONTACT.phone}</a>
        <div class="footer__contact-actions">
          <a href={waDefault} target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href={telLink}>Llamar</a>
        </div>
        <EmailLink email={CONTACT.email} class="footer__email"><Icon name="mail" size={16} /> <span>{CONTACT.email}</span></EmailLink>
      </section>

      <section class="footer__cell" aria-labelledby="footer-office-title">
        <h2 id="footer-office-title" class="footer__cell-title">Oficinas</h2>
        <address class="footer__address">{CONTACT.street}<br />{CONTACT.city}, {CONTACT.postalCode}</address>
        <a href={COMPANY.mapsUrl} class="footer__text-link" target="_blank" rel="noopener noreferrer">Cómo llegar <Icon name="arrow" size={14} /></a>
      </section>

      <section class="footer__cell" aria-labelledby="footer-hours-title">
        <h2 id="footer-hours-title" class="footer__cell-title">Horario</h2>
        <div class="footer__hours" aria-label="Horario de atención">
          {schedule.weekdays && <div><span>{schedule.weekdays.split('  ')[0]}</span><strong>{schedule.weekdays.split('  ')[1]}</strong></div>}
          {schedule.saturday && <div><span>{schedule.saturday.split('  ')[0]}</span><strong>{schedule.saturday.split('  ')[1]}</strong></div>}
          {schedule.sunday && <div class="footer__hours--dim"><span>{schedule.sunday.split('  ')[0]}</span><strong>{schedule.sunday.split('  ')[1]}</strong></div>}
        </div>
        <p class="footer__coverage">Cobertura: {COMPANY.coverage}.</p>
      </section>
    </div>

    <div class="footer__nav-grid" aria-label="Navegación del pie de página">
      {FOOTER_NAV.map((group) => (
        <details class="footer__nav-group" open>
          <summary>
            <span><i aria-hidden="true"></i>{group.title}</span>
            <Icon name="chevron" size={16} />
          </summary>
          <ul role="list">
            {group.links.map((link) => (
              <li>
                <a href={navHref(link.href)} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </div>

  {certifications.length > 0 && (
    <div class="footer__cert-band" aria-label="Normativas y certificaciones">
      <div class="footer__cert-inner">
        <span>Cumplimiento normativo:</span>
        <ul role="list">
          {certifications.map((cert) => <li title={cert.title}>{cert.label}</li>)}
        </ul>
      </div>
    </div>
  )}

  <div class="footer__bottom">
    <div class="footer__bottom-inner">
      <div class="footer__bottom-copy">
        <p>© {currentYear} {SITE.name}. Todos los derechos reservados.</p>
        <small>{seoTagline}</small>
      </div>
      {LEGAL.length > 0 && (
        <nav class="footer__legal" aria-label="Legal">
          {LEGAL.map((item, index) => (
            <Fragment>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a href={item.href}>{item.label}</a>
            </Fragment>
          ))}
        </nav>
      )}
      <button type="button" class="footer__top" aria-label="Volver arriba"><Icon name="arrow-up" size={14} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />Arriba</button>
    </div>
  </div>
</footer>

<script>
  (() => {
    const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('.footer__nav-group'))
    const desktop = window.matchMedia('(min-width: 640px)')
    const syncGroups = () => groups.forEach((group) => { group.open = desktop.matches })
    const onSummaryClick = (event: MouseEvent) => { if (desktop.matches) event.preventDefault() }
    groups.forEach((group) => group.querySelector('summary')?.addEventListener('click', onSummaryClick))
    syncGroups()
    desktop.addEventListener('change', syncGroups)
    document.querySelector<HTMLButtonElement>('.footer__top')?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'auto' }))
  })()
</script>

<style>
.footer {
  background: #14181f;
  color: rgba(255, 255, 255, 0.72);
  font-family: var(--font-body);
}

.footer__cta {
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  background: #10141a;
}

.footer__cta-inner,
.footer__body,
.footer__cert-inner,
.footer__bottom-inner {
  max-width: var(--container-max);
  margin-inline: auto;
  padding-inline: var(--container-px);
}

.footer__cta-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-6);
  padding-block: 2.75rem;
}

.footer__cta-copy {
  max-width: 60ch;
}

.footer__eyebrow,
.footer__cta-copy h2,
.footer__cta-copy p:last-child {
  margin: 0;
}

.footer__eyebrow {
  color: var(--c-primary-on-dark);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.footer__cta-copy h2 {
  margin-top: 0.45rem;
  color: var(--c-white);
  font-family: var(--font-heading);
  font-size: clamp(1.35rem, 1rem + 1.35vw, 1.8rem);
  font-weight: var(--weight-bold);
  line-height: 1.2;
}

.footer__cta-copy p:last-child {
  margin-top: 0.7rem;
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--text-sm);
}

.footer__cta-actions {
  display: flex;
  flex-shrink: 0;
  gap: 0.7rem;
}

.footer__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  min-height: 50px;
  padding: 0.7rem 1rem;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  text-decoration: none;
  white-space: nowrap;
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}

.footer__button--primary {
  background: var(--c-primary);
  color: var(--c-white);
}

.footer__button--primary:hover {
  background: var(--c-primary-dark);
  color: var(--c-white);
}

.footer__button--outline {
  border-color: rgba(255, 255, 255, 0.35);
  color: var(--c-white);
}

.footer__button--outline:hover {
  border-color: var(--c-white);
  background: rgba(255, 255, 255, 0.08);
  color: var(--c-white);
}

.footer__button:focus-visible,
.footer__cell a:focus-visible,
.footer__nav-group a:focus-visible,
.footer__nav-group summary:focus-visible,
.footer__legal a:focus-visible,
.footer__top:focus-visible {
  outline: 2px solid var(--c-primary-light);
  outline-offset: 3px;
}

.footer__body {
  padding-block: 3.5rem 3rem;
}

.footer__identity-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 2.5rem 1.75rem;
  padding-bottom: 3rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.footer__cell {
  min-width: 0;
}

.footer__logo {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  text-decoration: none;
}

.footer__logo-mark {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: var(--radius-md);
  background: var(--c-primary);
  color: var(--c-white);
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: var(--weight-black);
  line-height: 1;
}

.footer__logo-lockup {
  display: flex;
  flex-direction: column;
  gap: 0.18rem;
}

.footer__logo-word {
  color: var(--c-white);
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: var(--weight-black);
  letter-spacing: -0.02em;
  line-height: 1;
}

.footer__logo-descriptor {
  color: var(--c-primary-on-dark);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.11em;
  line-height: 1;
  text-transform: uppercase;
}

.footer__summary {
  max-width: 38ch;
  margin: 1rem 0 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: var(--text-sm);
  line-height: 1.6;
}

.footer__chips,
.footer__social,
.footer__branches {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.footer__chips {
  margin-top: 1rem;
}

.footer__chips span {
  padding: 0.3rem 0.55rem;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: var(--radius-full);
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--text-xs);
}

.footer__branches {
  margin-top: 1rem;
}

.footer__branches a,
.footer__branches span {
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--text-xs);
}
.footer__branches a,
.footer__branch {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  text-decoration: none;
}
.footer__branches strong {
  color: rgba(255, 255, 255, 0.86);
  font-weight: var(--weight-semibold);
}
.footer__branches small {
  color: rgba(255, 255, 255, 0.58);
  font-size: var(--text-xs);
  line-height: 1.4;
}

.footer__branches a:hover,
.footer__text-link:hover,
.footer__email:hover,
.footer__contact-actions a:hover {
  color: var(--c-white);
}

.footer__social {
  margin-top: 1rem;
}

.footer__social a {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
  color: rgba(255, 255, 255, 0.72);
}

.footer__social svg {
  width: 18px;
  height: 18px;
  color: currentColor;
}

.footer__social a:hover {
  border-color: var(--c-primary-light);
  color: var(--c-white);
}

.footer__cell-title {
  margin: 0 0 1rem;
  color: var(--c-white);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.footer__cell-title::before {
  display: inline-block;
  width: 16px;
  height: 2px;
  margin-right: 0.5rem;
  vertical-align: middle;
  background: var(--c-primary);
  content: "";
}

.footer__phone {
  display: block;
  color: var(--c-white);
  font-family: var(--font-heading);
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  text-decoration: none;
}

.footer__contact-actions {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.9rem;
}

.footer__contact-actions a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0.45rem 0.7rem;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: var(--radius-md);
  color: rgba(255, 255, 255, 0.86);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  text-decoration: none;
}

.footer__contact-actions a:first-child {
  border-color: var(--c-primary);
  background: var(--c-primary);
  color: var(--c-white);
}

.footer__email {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: 1rem;
  color: rgba(255, 255, 255, 0.7);
  font-size: var(--text-xs);
  text-decoration: none;
}

.footer__address {
  margin: 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--text-sm);
  font-style: normal;
  line-height: 1.65;
}

.footer__text-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-height: 44px;
  margin-top: 0.8rem;
  color: var(--c-white);
  font-size: var(--text-sm);
  text-decoration: underline;
  text-underline-offset: 0.18em;
}

.footer__hours {
  display: grid;
  gap: 0.45rem;
}

.footer__hours div {
  display: flex;
  justify-content: space-between;
  gap: 0.7rem;
  color: rgba(255, 255, 255, 0.65);
  font-size: var(--text-xs);
}

.footer__hours strong {
  color: var(--c-white);
  font-weight: var(--weight-medium);
}

.footer__hours--dim,
.footer__hours--dim strong {
  color: rgba(255, 255, 255, 0.62);
}

.footer__coverage {
  margin: 1rem 0 0;
  color: rgba(255, 255, 255, 0.65);
  font-size: var(--text-xs);
  line-height: 1.5;
}

.footer__nav-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1.75rem;
  padding-top: 3rem;
}

.footer__nav-group summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
  color: var(--c-white);
  cursor: default;
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.1em;
  list-style: none;
  text-transform: uppercase;
}

.footer__nav-group summary::-webkit-details-marker {
  display: none;
}

.footer__nav-group summary > span {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.footer__nav-group summary i {
  display: block;
  width: 16px;
  height: 2px;
  background: var(--c-primary);
}

.footer__nav-group summary svg {
  display: none;
}

.footer__nav-group ul {
  display: grid;
  gap: 0.5rem;
  margin: 0.75rem 0 0;
  padding: 0;
  list-style: none;
}

.footer__nav-group a {
  display: flex;
  align-items: center;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--text-sm);
  text-decoration: none;
}

.footer__nav-group a:hover {
  color: var(--c-white);
