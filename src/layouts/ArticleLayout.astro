---
{/* ArticleLayout — artículo de blog (colección .mdx): hero, índice, prose, FAQ, CTA por embudo y relacionados curados. L3 blog */}

// ============================================================================
// ArticleLayout.astro — ARTÍCULO DE BLOG.
//
// Renderiza un post de la Content Collection `articulos` (.mdx con frontmatter
// tipado). El blog SIEMPRE vive en colección .mdx, NUNCA como .astro sueltos
// (anti-patrón D3 confirmado en MESASPICNIC/RENTADEILUMINACION).
//
// Extiende PageLayout. Schema: pageType="article" → buildSchema emite Article
// (con datePublished/dateModified/author/publisher) + BreadcrumbList (una vez)
// + FAQPage cuando el artículo trae `faqs` VISIBLES en la página.
//
// ESTRATEGIA EDITORIAL 2026-09-09 — qué cambió y por qué:
//   1. Índice (TOC) desde los H2 del .mdx. Astro ya genera los `id`; solo hay
//      que pintarlos. Sin índice no hay jump links en la SERP ni lectura
//      decente en móvil a partir de 800 palabras.
//   2. FAQ visible + FAQPage. El esquema de la colección admitía `faqs` y
//      seo.ts sabía emitir FAQPage desde mayo, pero esta plantilla no
//      consumía ninguno de los dos: las preguntas se quedaban en el markdown.
//   3. CTA por etapa del embudo (`funnel`). Antes todos los artículos cerraban
//      con el mismo botón de WhatsApp, diera igual si el lector estaba
//      descubriendo el tema o comparando proveedores.
//   4. Relacionados CURADOS. Antes la ruta pasaba `articulos.slice(0, 3)` —los
//      tres primeros por orden de colección, sin relación temática—. Ahora la
//      ruta resuelve relatedPosts/relatedProducts/relatedServices del
//      frontmatter y sólo cae al respaldo por categoría si no hay nada.
//   5. Miga con el nivel de categoría (Inicio › Blog › Categoría › Artículo).
// ============================================================================

import PageLayout from "./PageLayout.astro";
import RelatedLinks from "@components/RelatedLinks.astro";
import FAQAccordion from "@components/FAQAccordion.astro";
import CTABanner from "@components/CTABanner.astro";
import { SITE, waUrl } from "@config/site";
import { srcsetFor } from '@lib/img'

export interface Props {
  title: string;
  description: string;
  /** <title> y meta description del head; si faltan, se usan title/description (que siguen siendo el H1 y la entradilla). */
  seoTitle?: string;
  seoDescription?: string;
  /** Slug de categoría (enum ARTICLE_CATEGORIES). */
  category?: string;
  /** Etiqueta legible de la categoría (BLOG_CATEGORIES). */
  categoryLabel?: string;
  /** Fecha de publicación (ISO o Date). Alimenta el Article JSON-LD. */
  pubDate: string | Date;
  /** Fecha de última edición; default = pubDate. */
  updatedDate?: string | Date;
  author?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  tags?: string[];
  /** Etapa del embudo → decide el CTA de cierre. */
  funnel?: 'tofu' | 'mofu' | 'bofu';
  /** Encabezados del .mdx (Astro los devuelve en render()). Alimentan el índice. */
  headings?: { depth: number; slug: string; text: string }[];
  /** Preguntas frecuentes: se pintan Y se emiten como FAQPage. */
  faqs?: { question: string; answer: string }[];
  /** Artículos relacionados (interlinking editorial). */
  related?: { label: string; href: string; description?: string }[];
  /** Producto / servicio que resuelve el tema del artículo (ruta comercial). */
  commercial?: { label: string; href: string; description?: string }[];
}

const {
  title,
  description,
  seoTitle,
  seoDescription,
  category,
  categoryLabel,
  pubDate,
  updatedDate,
  author = SITE.brand,
  image,
  imageAlt,
  canonical,
  funnel = 'mofu',
  headings = [],
  faqs = [],
  related = [],
  commercial = [],
} = Astro.props;

const published = new Date(pubDate);
const updated = updatedDate ? new Date(updatedDate) : published;
// timeZone UTC a propósito: el frontmatter trae fechas sin hora ("2026-06-21"),
// que Zod coacciona a medianoche UTC. Al formatearlas en la zona local del
// servidor (UTC-6) se restaba un día y TODOS los artículos publicaban su fecha
// con 24 h de atraso — «21 de junio» se imprimía como «20 de junio».
const fmt = (d: Date) =>
  d.toLocaleDateString("es-MX", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

// Índice: sólo H2. A partir de 3 secciones aporta; con menos, estorba.
const toc = headings.filter((h) => h.depth === 2 && h.slug && h.text);
const showToc = toc.length >= 3;

const catLabel = categoryLabel ?? category;
const breadcrumbs = [
  { label: "Blog", href: "/blog/" },
  ...(category ? [{ label: catLabel ?? category, href: `/blog/categoria/${category}/` }] : []),
  { label: title },
];

// schemaData → Article (+ FAQPage si hay preguntas visibles). Claves EXACTAS del
// contrato lib/seo.ts: article { title, description, path, image?,
// datePublished, dateModified?, author?, section? } y faqs [{question,answer}].
const schemaData = {
  article: {
    title,
    description,
    path: canonical ?? Astro.url.pathname,
    image,
    datePublished: published.toISOString(),
    dateModified: updated.toISOString(),
    author,
    ...(category ? { section: catLabel ?? category } : {}),
  },
  ...(faqs.length ? { faqs } : {}),
};

// ── CTA por etapa del embudo ────────────────────────────────────────────────
// tofu: el lector descubre el tema → orientación, sin fricción de cotización.
// mofu: evalúa qué le exige la norma → diagnóstico del inmueble.
// bofu: ya sabe qué quiere → cotización directa.
const waAsk = waUrl(`Hola, leí "${title}" en su blog y tengo una pregunta.`);
const waQuote = waUrl(`Hola, leí "${title}" y quiero una cotización para mi inmueble.`);

const CTA_BY_FUNNEL = {
  tofu: {
    heading: '¿Dudas sobre qué necesita tu inmueble?',
    desc: 'Cuéntanos el giro y el tamaño del lugar y te orientamos sin compromiso.',
    btns: [{ label: 'Preguntar por WhatsApp', href: waAsk, icon: 'wa' as const, primary: true, external: true }],
    badge: 'Asesoría técnica · CDMX y Estado de México',
    variant: 'light' as const,
  },
  mofu: {
    heading: '¿Quieres saber qué te exige la norma en tu caso?',
    desc: 'Hacemos el levantamiento de tu inmueble y te decimos qué equipo es exigible y qué documentación falta.',
    btns: [
      { label: 'Solicitar diagnóstico de riesgo', href: '/servicios/diagnostico-de-riesgo/', icon: 'quote' as const, primary: true },
      { label: 'Preguntar por WhatsApp', href: waAsk, icon: 'wa' as const, external: true },
    ],
    badge: 'Diagnóstico conforme a la NOM-002-STPS-2010',
    variant: 'dark' as const,
  },
  bofu: {
    heading: '¿Listo para cotizar?',
    desc: 'Mándanos la lista o las dudas de tu inmueble y te respondemos con precios y tiempos de entrega.',
    btns: [
      { label: 'Cotizar por WhatsApp', href: waQuote, icon: 'wa' as const, primary: true, external: true },
      { label: 'Equipos contra incendios', href: '/productos/', icon: 'catalog' as const },
    ],
    badge: 'Respuesta el mismo día',
    variant: 'red' as const,
  },
};
const cta = CTA_BY_FUNNEL[funnel] ?? CTA_BY_FUNNEL.mofu;
---

<PageLayout
  title={seoTitle ?? title}
  description={seoDescription ?? description}
  image={image}
  canonical={canonical}
  pageType="article"
  schemaData={schemaData}
  breadcrumbs={breadcrumbs}
>
  <article class="post">
    <header class="post__header">
      <div class="container">
        {category && <a class="post__cat" href={`/blog/categoria/${category}/`}>{catLabel}</a>}
        <h1 class="post__title">{title}</h1>
        <p class="post__lede">{description}</p>
        <p class="post__meta">
          Por {author} · <time datetime={published.toISOString()}>{fmt(published)}</time>
          {updated.getTime() !== published.getTime() && (
            <> · Actualizado <time datetime={updated.toISOString()}>{fmt(updated)}</time></>
          )}
        </p>
      </div>
    </header>

    {image && (
      <figure class="post__hero">
        <img src={image} alt={imageAlt ?? title} width="1200" height="630" fetchpriority="high" decoding="async" srcset={srcsetFor(image)} sizes="(min-width: 1024px) 800px, 100vw" />
      </figure>
    )}

    <div class="container post__body">
      {/* prose: el cuerpo del .mdx entra por el slot */}
      <div class="prose">
        {showToc && (
          <nav class="toc" aria-labelledby="toc-heading">
            <h2 id="toc-heading" class="toc__title">En este artículo</h2>
            <ul class="toc__list" role="list">
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        )}

        <slot />

        {faqs.length > 0 && (
          <div class="post__faq">
            <FAQAccordion items={faqs} title="Preguntas frecuentes" openFirst bare />
          </div>
        )}
      </div>

      <aside class="post__sidebar">
        {commercial.length > 0 && (
          <div class="post__widget">
            <h2>Lo que resuelve tu caso</h2>
            <RelatedLinks title="" links={commercial.map((r) => ({ label: r.label, href: r.href, desc: r.description }))} />
          </div>
        )}
        {related.length > 0 && (
          <div class="post__widget">
            <h2>Sigue leyendo</h2>
            <RelatedLinks title="" links={related.map((r) => ({ label: r.label, href: r.href, desc: r.description }))} />
          </div>
        )}
        <div class="post__widget post__widget--cta">
          <h2>¿Te quedó una duda?</h2>
          <p>Escríbenos y te orientamos sin compromiso.</p>
          <a class="btn btn--primary btn--block" href={waAsk}>Preguntar por WhatsApp</a>
        </div>
      </aside>
    </div>
  </article>

  <CTABanner {...cta} />
</PageLayout>

<style>
  /* CSS vanilla con tokens. El estilo tipográfico de .prose vive en
     src/styles/typography.css (fuente única). */
  .post__header { padding: var(--space-10) 0 var(--space-6); }
  .post__cat { color: var(--color-accent); text-transform: uppercase; letter-spacing: .08em; font-size: var(--text-sm); text-decoration: none; }
  .post__title { font-family: var(--font-heading); font-size: var(--text-fluid-4xl); line-height: 1.1; margin: var(--space-2) 0; }
  .post__lede { color: var(--color-text-muted); max-width: var(--container-prose); font-size: var(--text-lg); }
  .post__meta { color: var(--color-text-muted); font-size: var(--text-sm); margin-top: var(--space-3); }
  .post__hero img { width: 100%; height: auto; border-radius: var(--radius-lg); }
  .post__body { display: grid; grid-template-columns: 1fr; gap: var(--space-8); padding: var(--space-8) 0; }
  /* min-width:0 → en el grid .post__body el track 1fr puede encoger por debajo del
     min-content de un <pre>/línea larga; sin esto la columna crece y desborda en X
     (mobile.css ya hace que <pre>/<table> scrolleen dentro de su caja). */
  .prose { min-width: 0; max-width: var(--container-prose); }
  .post__sidebar { display: grid; gap: var(--space-5); align-content: start; }
  .post__widget { padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .post__widget--cta { background: var(--color-surface); }

  /* Índice del artículo — anclas a los H2 (Astro genera los id). */
  .toc { margin: 0 0 var(--space-7); padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .toc__title { font-size: var(--text-sm); text-transform: uppercase; letter-spacing: .08em; margin: 0 0 var(--space-3); color: var(--color-text-muted); }
  .toc__list { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--space-2); }
  .toc__list a { text-decoration: none; }
  .toc__list a:hover { text-decoration: underline; }

  .post__faq { margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-border); }

  @media (min-width: 1024px) {
    .post__body { grid-template-columns: minmax(0, 1fr) 20rem; }
    .post__sidebar { position: sticky; top: calc(var(--header-height, 72px) + var(--space-4)); }
  }
</style>
