---
// ProductLayout — composición homologada de las fichas L4.
// Contrato: recibe frontmatter de producto, variantes y contenido Markdown por slot.
import PageLayout from './PageLayout.astro';
import Hero from '@components/Hero.astro';
import SectionMenu from '@components/SectionMenu.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ExtintorCard from '@components/ExtintorCard.astro';
import ProductShowcase from '@components/ProductShowcase.astro';
import ProductVariantCard from '@components/ProductVariantCard.astro';
import CatalogCierreCard from '@components/CatalogCierreCard.astro';
import QuoteCard from '@components/QuoteCard.astro';
import DataTable from '@components/DataTable.astro';
import GirosQueLoNecesitan from '@components/GirosQueLoNecesitan.astro';
import RelatedLinks from '@components/RelatedLinks.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import { FICHA_DEFAULT, HEADS_DEFAULT } from '@data/fichas';
import { EXT_FORMATO_LABEL } from '@data/extintores-catalogo';
import { cierreExtintores, cierreGeneral, faltanParaCuatro } from '@data/cierre';
import { CONTACT, waUrl, telUrl, TAXONOMY, sectionMenuItems } from '@config/site';
import { slugify } from '@lib/slug';
import { getEntry } from 'astro:content';
import type { FichaData, FichaHeads } from '@data/fichas';

export interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  seoTitle?: string;
  seoDescription?: string;
  image?: string;
  canonical?: string;
  badge?: string;
  price?: string;
  gallery?: { src: string; alt: string }[];
  features?: string[];
  specs?: { label: string; value: string }[];
  applications?: string[];
  certifications?: string[];
  faqs?: { question: string; answer: string }[];
  related?: { label: string; href: string; description?: string }[];
  variantes?: Variante[];
  ficha?: FichaData;
  fichaHeads?: Partial<FichaHeads>;
}

export interface Variante {
  nombre: string; badge?: string; desc: string; specs: string; imagen?: string; waText: string;
  resumen?: string; agente?: string; capacidad?: string; formato?: string; clases?: string[];
  clasificacion?: string; usos?: string[]; validacion?: string;
}

const { slug, title, description, category, seoTitle, seoDescription, image, canonical, price,
  faqs = [], related = [], variantes = [], ficha, fichaHeads } = Astro.props;
const fichaData = {
  ...FICHA_DEFAULT,
  ...(ficha ?? {}),
  heroBadge: ficha?.heroBadge ?? TAXONOMY.categories.find((item) => item.slug === category)?.label ?? category,
  heroTitle: ficha?.heroTitle ?? title,
  descRight: ficha?.descRight ?? [description],
  norma: ficha?.norma ?? '',
  claves: ficha?.claves ?? [],
};
const heads = { ...HEADS_DEFAULT, ...(fichaHeads ?? {}) };
const extintoresEntry = await getEntry('l3', 'productos/extintores');
if (!extintoresEntry || extintoresEntry.data.kind !== 'extintores') throw new Error('Falta la entrada L3: productos/extintores');
const extintoresFichas = extintoresEntry.data.fichas;
const waLink = waUrl(`Hola, quiero cotizar: ${title}. ¿Precio y disponibilidad?`);
const publicPrice = price && !/^\s*cotizar\s*$/i.test(price) ? price : undefined;
const menuCta = { label: 'Cotizar por WhatsApp', href: waLink, sub: 'Te decimos cuál conviene', external: true };
const cat = TAXONOMY.categories.find((item) => item.slug === category);
const breadcrumbs = [
  { label: 'Productos', href: '/productos/' },
  // Desde 2026-09-11 las 5 categorías tienen L3 y TAXONOMY es `as const`: el
  // href se ensancha a string para que la guarda siga valiendo si mañana entra
  // una categoría sin L3 (href '/productos/').
  ...(cat && (cat.href as string) !== '/productos/' ? [{ label: cat.label, href: cat.href }] : []),
  { label: title },
];
const productImages = [image, ...((Astro.props.gallery ?? []).map((item) => item.src))].filter(Boolean) as string[];
const schemaData = {
  product: { name: title, description, path: `/productos/${slug}/`, images: productImages, sku: slug, category, ...(publicPrice ? { price: publicPrice } : {}) },
  ...(faqs.length ? { faqs } : {}),
};
const capacityValues = variantes.filter((item) => item.capacidad).map((item) => item.capacidad as string);
const capacitySummary = capacityValues.length > 1 ? `${capacityValues[0]} a ${capacityValues[capacityValues.length - 1]}` : capacityValues[0];
const portableCount = variantes.filter((item) => item.formato === 'portatil').length;
const mobileCount = variantes.filter((item) => item.formato === 'movil').length;
const presentationSummary = [portableCount ? `${portableCount} portátil${portableCount === 1 ? '' : 'es'}` : '', mobileCount ? `${mobileCount} sobre ruedas` : ''].filter(Boolean).join(' y ');
const comparable = variantes.filter((item) => item.capacidad);
const tableRows = comparable.map((item) => [
  item.nombre, item.capacidad ?? '',
  item.formato ? (EXT_FORMATO_LABEL[item.formato as keyof typeof EXT_FORMATO_LABEL] ?? item.formato) : 'Según presentación',
  item.clases?.join(', ') ?? 'Según fabricante', item.clasificacion ?? 'Según fabricante',
]);
const relatedCandidates = [
  // Desc corta: la card de RelatedLinks recorta a ~40 caracteres. En las
  // hermanas de extintores se usa su badge (clases de fuego), que sí cabe.
  ...related.map((item) => {
    const id = item.href.split('/').filter(Boolean).pop() ?? '';
    return { label: item.label, href: item.href, desc: extintoresFichas[id]?.badge ?? shortDescription(item.description) };
  }),
  ...(category === 'extintores' ? [
    { label: 'Mantenimiento de extintores', href: '/servicios/mantenimiento/', desc: 'Servicio anual y recarga, NOM-154.' },
    { label: 'Cuántos extintores necesito', href: '/herramientas/cuantos-extintores-necesito/', desc: 'Cantidad inicial para tu inmueble.' },
  ] : []),
];
const relatedGeneric = [
  { label: 'Equipos contra incendios', href: '/productos/', desc: 'Catálogo de equipo contra incendio.' },
  { label: 'Mantenimiento de extintores', href: '/servicios/mantenimiento/', desc: 'Recarga y servicio conforme a norma.' },
  { label: 'Cuántos extintores necesito', href: '/herramientas/cuantos-extintores-necesito/', desc: 'Calcula el mínimo para tu inmueble.' },
  { label: 'Contacto', href: '/contacto/', desc: 'Cotiza por WhatsApp, teléfono o correo.' },
];
const relatedLinks = Array.from(new Map(
  [...relatedCandidates, ...relatedGeneric]
    .filter((item) => item.href !== `/productos/${slug}/`)
    .map((item) => [item.href, { ...item, desc: shortDescription(item.desc) }]),
).values()).slice(0, relatedCandidates.length >= 8 ? 8 : 4);
const cierreVariantes = (variantes.some((item) => item.agente) ? cierreExtintores : cierreGeneral)
  .slice(0, faltanParaCuatro(variantes.length));
const faqTitleAccent = fichaData.faqAccent;
function shortDescription(value?: string) { return !value ? '' : value.length <= 40 ? value : `${value.slice(0, 37).trimEnd()}…`; }
---

<PageLayout title={seoTitle ?? title} description={seoDescription ?? description} image={image} canonical={canonical} pageType="product" schemaData={schemaData} breadcrumbs={breadcrumbs}>
  <Hero badge={fichaData.heroBadge} title={fichaData.heroTitle} accent={fichaData.heroAccent} subtitle={description} descRight={fichaData.descRight} ctas={[
    { text: 'Presentaciones y capacidades', href: '#presentaciones', variant: 'outline' },
    { text: 'Cotizar por WhatsApp', href: waLink, variant: 'primary', whatsapp: true },
  ]} />
  <SectionMenu items={sectionMenuItems()} cta={menuCta} />

  <ProductShowcase title={title} showcaseTitle={fichaData.showcaseTitle} showcaseAccent={fichaData.showcaseAccent} showcaseDesc={fichaData.showcaseDesc} body={heads.vitrina} image={image} claves={fichaData.claves} capacitySummary={capacitySummary} presentationSummary={presentationSummary} publicPrice={publicPrice} waLink={waLink} />

  <section class="section section--surface" id="presentaciones">
    <div class="container">
      <SectionHeading layout="duo" eyebrow="Presentaciones" title="Presentaciones" titleAccent="y capacidades" desc="Compara capacidad, clases de fuego y uso sugerido. Al cotizar, menciona la presentación exacta y la cantidad." body={heads.presentaciones} />
      <div class="card-grid">
        {variantes.map((variante, index) => {
          const id = slugify(variante.nombre);
          const item = { ...variante, id, fichaHref: `/productos/${slug}/#${id}`, imagen: variante.imagen };
          return variante.agente ? <ExtintorCard item={item as any} index={index} showFicha={false} /> : <ProductVariantCard item={item} index={index} />;
        })}
        {cierreVariantes.map((ficha) => <CatalogCierreCard ficha={ficha} visible />)}
      </div>
    </div>
  </section>

  {comparable.length >= 2 && <DataTable id="comparativa" eyebrow="Comparativa" title="Todas las presentaciones" titleAccent="frente a frente" desc="Capacidad, formato y clases de fuego de cada presentación." body={heads.comparativa} columns={['Presentación', 'Capacidad', 'Formato', 'Clases de fuego', 'Clasificación']} rows={tableRows} />}

  <section class="section section--surface">
    <div class="container">
      <SectionHeading layout="duo" eyebrow="Guía de compra" title={fichaData.guia.title} titleAccent={fichaData.guia.titleAccent} desc={fichaData.guia.desc} body={heads.guia} />
      <div class="guide-grid"><article class="prose"><slot /></article><QuoteCard title={title} price={publicPrice} waLink={waLink} telHref={telUrl()} /></div>
    </div>
  </section>

  <GirosQueLoNecesitan nombre={title} body={heads.giros} />

  <RelatedLinks eyebrow="Relacionados" title="Productos y servicios relacionados" desc="Otras presentaciones de la familia y el servicio que pide el equipo." body={heads.relacionados} links={relatedLinks} limit={8} />
  {/* Sin FAQ en el frontmatter no se pinta: el acordeón vacío se veía roto (fichas de detección, gabinetes, señalización y soportes). */}
  {faqs.length > 0 && (
  <FAQWithContact items={faqs} waNumber={CONTACT.whatsapp} eyebrow="Preguntas frecuentes" title="Preguntas frecuentes" titleAccent={faqTitleAccent} desc="Respuestas breves para elegir, instalar y mantener este equipo." body={heads.faq} />
  )}
</PageLayout>

<style>
  .guide-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-8); align-items: start; }
  /* 2026-09-11: la prosa ocupa el 100% de su columna; el límite de 68ch dejaba
     un hueco de ~320 px entre el texto y la QuoteCard en desktop. */
  .guide-grid .prose { max-width: none; }
  @media (min-width: 900px) { .guide-grid { grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem); } }
</style>
