/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 2026-11-19: estas imágenes viven en public/ y NO llevan hash de contenido en
# el nombre, así que no se marcan `immutable`: 30 días es cache suficiente y
# permite reemplazar una foto sin que el visitante la arrastre un año.
/images/*
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
